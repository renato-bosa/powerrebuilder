$PBExportHeader$uf_calculate.srf
global type uf_calculate from function_object
end type

forward prototypes
global function decimal uf_calculate (decimal ad_value1, decimal ad_value2, string as_operation)
end prototypes

global function decimal uf_calculate (decimal ad_value1, decimal ad_value2, string as_operation);
// Calculate values based on operation type
decimal ld_result

choose case upper(as_operation)
    case "ADD"
        ld_result = ad_value1 + ad_value2
    case "SUBTRACT"
        ld_result = ad_value1 - ad_value2
    case "MULTIPLY" 
        ld_result = ad_value1 * ad_value2
    case "DIVIDE"
        if ad_value2 <> 0 then
            ld_result = ad_value1 / ad_value2
        else
            ld_result = 0
            MessageBox("Error", "Division by zero")
        end if
    case else
        ld_result = 0
        MessageBox("Error", "Invalid operation: " + as_operation)
end choose

return ld_result
end function