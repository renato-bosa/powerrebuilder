// Enhanced PowerBuilder Grammar with Error Recovery
// Based on powerbuilder.lark with added recovery rules

%import common.CNAME       -> IDENTIFIER
%import common.INT        -> INT
%import common.WS_INLINE
%import common.NEWLINE
%import common.WS

// Include all base tokens from powerbuilder.lark
HEX_INT  : /0x[0-9A-Fa-f]+/
DATE_LIT : /\d{4}-\d{2}-\d{2}/
TIME_LIT : /\d{2}:\d{2}(:\d{2})?/
STRING   : /"[^"]*"/
COMMENT  : /\/\/[^\n]*/

// Operators and delimiters
LPAR: "("
RPAR: ")"
LBRACE: "{"
RBRACE: "}"
LBRACK: "["
RBRACK: "]"
COMMA: ","
COLON: ":"
EQUALS: "="
SEMICOLON: ";"
DOT: "."
GT: ">"
LT: "<"
GE: ">="
LE: "<="
EQ: "="
NE: "<>"
PLUS: "+"
MINUS: "-"
MULT: "*"
DIV: "/"
MOD: "%"
POWER: "^"
NOT: "not"
AND: "and"
OR: "or"

// Extended type system
TYPE_NAME.2: "integer" | "string" | "boolean" | "date" | "decimal" | "long" | "real" 
           | "transaction" | "blob" | "datetime" | "time" | "any" | "powerobject" 
           | "char" | "character" | "double" | "uint" | "ulong" | "byte"

// Control types
CONTROL_TYPE.2: "commandbutton" | "datawindow" | "edit" | "statictext" | "checkbox" 
              | "radiobutton" | "dropdownlistbox" | "picturebutton" | "tab" | "groupbox" 
              | "treeview" | "listview" | "richtextedit" | "graph" | "ole" 
              | "vscrollbar" | "hscrollbar" | "picture" | "mdiclient"

// Event types
EVENT_TYPE.2: "on" | "function" | "subroutine" | "event" | "post" | "trigger" 
            | "systemfunction" | "systemservice" | "clicked" | "doubleclicked" 
            | "itemchanged" | "itemerror" | "itemfocuschanged" | "rbuttondown" 
            | "rowfocuschanged" | "rowfocuschanging" | "create" | "destroy"
            | "constructor" | "destructor" | "open" | "close"

// Error recovery tokens
ERROR_TOKEN: /[^\n\r;{}()]+/
RECOVER_TOKEN: /[^;}\n]+/

// ============ ERROR RECOVERY RULES ============

// Main entry point with error recovery
start: (_statement_with_recovery | _NEWLINE)*

// Statement with error recovery
_statement_with_recovery: statement
                        | error_statement
                        | incomplete_statement

// Error statement catches malformed statements
error_statement: ERROR_TOKEN+ (SEMICOLON | _NEWLINE)
               | ERROR_TOKEN+ EOF

// Incomplete statement without proper termination
incomplete_statement: statement_start RECOVER_TOKEN* _NEWLINE
                    | statement_start RECOVER_TOKEN* EOF

// Common statement starts for recovery anchoring
statement_start: visibility_modifier? (type_declaration_start | function_start | event_start | control_start)
               | "if" | "for" | "do" | "while" | "choose" | "select"
               | "return" | "call" | "create" | "destroy" | "open" | "close"
               | IDENTIFIER (EQUALS | DOT | LPAR)

// Partial declarations for recovery
type_declaration_start: "type" IDENTIFIER
function_start: ("function" | "subroutine") TYPE_NAME? IDENTIFIER
event_start: "event" IDENTIFIER
control_start: CONTROL_TYPE IDENTIFIER

// ============ FLEXIBLE GRAMMAR RULES ============

// Statements with optional terminators
statement: assignment_statement optional_semicolon
         | control_flow_statement
         | function_call_statement optional_semicolon
         | return_statement optional_semicolon
         | variable_declaration optional_semicolon
         | type_declaration
         | function_declaration
         | event_declaration
         | control_declaration

optional_semicolon: SEMICOLON?

// Assignment with recovery
assignment_statement: IDENTIFIER (DOT IDENTIFIER)* EQUALS expression
                    | IDENTIFIER LBRACK expression RBRACK EQUALS expression

// Expressions with error recovery
expression: primary_expression
          | binary_expression
          | unary_expression
          | ERROR_TOKEN  // Fallback for malformed expressions

primary_expression: IDENTIFIER
                  | literal
                  | function_call
                  | LPAR expression RPAR
                  | array_access

literal: INT | STRING | HEX_INT | DATE_LIT | TIME_LIT | "true" | "false" | "null"

// Control flow with optional end markers
control_flow_statement: if_statement
                      | for_statement
                      | while_statement
                      | do_statement
                      | choose_statement

if_statement: "if" expression "then" _NEWLINE
              (_statement_with_recovery | _NEWLINE)*
              else_clause?
              end_if

else_clause: "else" _NEWLINE (_statement_with_recovery | _NEWLINE)*
           | "elseif" expression "then" _NEWLINE (_statement_with_recovery | _NEWLINE)* else_clause?

// Flexible end markers - optional for error recovery
end_if: "end" "if" | "endif" | _NEWLINE  // Allow missing end if

for_statement: "for" IDENTIFIER EQUALS expression "to" expression ("step" expression)? _NEWLINE
               (_statement_with_recovery | _NEWLINE)*
               ("next" | _NEWLINE)  // Allow missing next

while_statement: "while" expression _NEWLINE
                 (_statement_with_recovery | _NEWLINE)*
                 ("wend" | "loop" | _NEWLINE)  // Allow missing end

do_statement: "do" ("while" | "until") expression _NEWLINE
              (_statement_with_recovery | _NEWLINE)*
              ("loop" | _NEWLINE)  // Allow missing loop

choose_statement: "choose" "case" expression _NEWLINE
                  case_clause*
                  case_else_clause?
                  ("end" "choose" | _NEWLINE)  // Allow missing end choose

case_clause: "case" expression_list _NEWLINE
             (_statement_with_recovery | _NEWLINE)*

case_else_clause: "case" "else" _NEWLINE
                  (_statement_with_recovery | _NEWLINE)*

expression_list: expression (COMMA expression)*

// Function/event declarations with recovery
function_declaration: visibility_modifier? function_type TYPE_NAME IDENTIFIER 
                      LPAR parameter_list? RPAR _NEWLINE
                      (_statement_with_recovery | _NEWLINE)*
                      end_function

function_type: "function" | "subroutine"
visibility_modifier: "public" | "private" | "protected"

end_function: "end" ("function" | "subroutine") | _NEWLINE  // Allow missing end

parameter_list: parameter (COMMA parameter)*
parameter: ("ref" | "readonly")? TYPE_NAME IDENTIFIER ("=" expression)?

// Variable declarations with recovery
variable_declaration: visibility_modifier? TYPE_NAME IDENTIFIER 
                      (EQUALS expression)?
                      (COMMA IDENTIFIER (EQUALS expression)?)*

// Type declarations with recovery
type_declaration: "type" IDENTIFIER "from" IDENTIFIER _NEWLINE
                  type_member*
                  ("end" "type" | _NEWLINE)  // Allow missing end type

type_member: visibility_modifier? TYPE_NAME IDENTIFIER (EQUALS expression)? _NEWLINE
           | function_declaration
           | event_declaration

// Control declarations with recovery
control_declaration: CONTROL_TYPE IDENTIFIER _NEWLINE
                     property_assignment*
                     ("end" CONTROL_TYPE | _NEWLINE)  // Allow missing end

property_assignment: IDENTIFIER EQUALS expression _NEWLINE

// Binary and unary expressions
binary_expression: expression binary_operator expression
unary_expression: unary_operator expression

binary_operator: PLUS | MINUS | MULT | DIV | MOD | POWER
               | GT | LT | GE | LE | EQ | NE
               | AND | OR

unary_operator: NOT | MINUS | PLUS

// Function calls
function_call: IDENTIFIER LPAR argument_list? RPAR
function_call_statement: function_call | IDENTIFIER DOT function_call

argument_list: expression (COMMA expression)*

// Array access
array_access: IDENTIFIER LBRACK expression RBRACK

// Return statement
return_statement: "return" expression?

// Event declaration with recovery
event_declaration: "event" IDENTIFIER IDENTIFIER? _NEWLINE
                   (_statement_with_recovery | _NEWLINE)*
                   ("end" "event" | _NEWLINE)  // Allow missing end event

// ============ WHITESPACE AND COMMENT HANDLING ============

%ignore WS_INLINE
%ignore COMMENT

_NEWLINE: NEWLINE+
EOF: /$/