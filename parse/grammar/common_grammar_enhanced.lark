# Enhanced Common Grammar
# Consolidated common tokens and rules for all grammar files

# ==================
# Standard Imports
# ==================
%import common.CNAME       -> IDENTIFIER
%import common.INT        -> INT
%import common.WS_INLINE
%import common.NEWLINE
%import common.WS

# ==================
# Common Literals
# ==================
HEX_INT  : /0x[0-9A-Fa-f]+/
DATE_LIT : /\d{4}-\d{2}-\d{2}/
TIME_LIT : /\d{2}:\d{2}(:\d{2})?/
STRING   : /"[^"]*"/
ESCAPED_STRING: /"([^"\\]|\\.)*"/ | /'([^'\\]|\\.)*'/
COMMENT  : /\/\/[^\n]*/

# ==================
# Common Operators
# ==================
// Delimiters
LPAR: "("
RPAR: ")"
LBRACE: "{"
RBRACE: "}"
LBRACK: "["
RBRACK: "]"
COMMA: ","
COLON: ":"
SEMICOLON: ";"
DOT: "."

// Assignment
EQUALS: "="
ASSIGN: ":=" | "<-" | "←"

// Comparison
GT: ">"
LT: "<"
GE: ">="
LE: "<="
EQ: "="
NE: "<>"
NEQ: "!="

// Arithmetic
PLUS: "+"
MINUS: "-"
MULT: "*"
DIV: "/"
MOD: "%"
POWER: "^"

// Logical
AND: "and"
OR: "or"
NOT: "not"

# ==================
# Common Keywords
# ==================
// Type keywords
TYPE: "type"
FROM: "from"
GLOBAL: "global"
VARIABLES: "variables"
END_VARIABLES: "end variables"

// Control flow
IF: "if"
THEN: "then"
ELSE: "else"
ELSEIF: "elseif"
END: "end"
END_IF: "end if"
FOR: "for"
TO: "to"
STEP: "step"
NEXT: "next"
WHILE: "while"
DO: "do"
LOOP: "loop"
UNTIL: "until"
EXIT: "exit"
CONTINUE: "continue"

// Exception handling
TRY: "try"
CATCH: "catch"
FINALLY: "finally"
THROW: "throw"
END_TRY: "end try"

// Function/Event keywords
FUNCTION: "function"
END_FUNCTION: "end function"
EVENT: "event"
END_EVENT: "end event"
RETURN: "return"
CALL: "call"

// Access modifiers
PUBLIC: "public"
PRIVATE: "private"
PROTECTED: "protected"
SHARED: "shared"

// Object keywords
CREATE: "create"
DESTROY: "destroy"
USING: "using"
THIS: "this"
PARENT: "parent"
SUPER: "super"
NULL: "null"

// SQL keywords (common subset)
SELECT: "select"
INSERT: "insert"
UPDATE: "update"
DELETE: "delete"
FROM: "from"
WHERE: "where"
INTO: "into"
VALUES: "values"
SET: "set"

# ==================
# Type System
# ==================
// Basic types
TYPE_NAME.2: "integer" | "string" | "boolean" | "date" | "decimal" 
           | "long" | "real" | "char" | "double" | "time" | "datetime"
           | "INTEGER" | "STRING" | "BOOLEAN" | "DATE" | "DECIMAL"
           | "LONG" | "REAL" | "CHAR" | "DOUBLE" | "TIME" | "DATETIME"

// Extended types
EXTENDED_TYPE.2: "blob" | "byte" | "uint" | "ulong" | "any"
               | "BLOB" | "BYTE" | "UINT" | "ULONG" | "ANY"

// System types
SYSTEM_TYPE.2: "powerobject" | "transaction" | "datawindow" | "datastore" 
             | "structure" | "window" | "userobject" | "menu"
             | "POWEROBJECT" | "TRANSACTION" | "DATAWINDOW" | "DATASTORE"
             | "STRUCTURE" | "WINDOW" | "USEROBJECT" | "MENU"

// Boolean literals
BOOLEAN.2: "true" | "false" | "TRUE" | "FALSE"

# ==================
# Common Rules
# ==================

// Type specification
type_spec: TYPE_NAME | EXTENDED_TYPE | SYSTEM_TYPE | IDENTIFIER

// Array bounds
array_bounds: "[" array_dimension ("," array_dimension)* "]"
            | "[" "]"  // Dynamic array

array_dimension: INT | IDENTIFIER | expression

// Expressions (with precedence)
?expression: logical_or

?logical_or: logical_and (OR logical_and)*

?logical_and: logical_not (AND logical_not)*

?logical_not: NOT logical_not
            | comparison

?comparison: additive (comp_op additive)?

comp_op: GT | LT | GE | LE | EQ | NE | NEQ

?additive: multiplicative ((PLUS | MINUS) multiplicative)*

?multiplicative: power ((MULT | DIV | MOD) power)*

?power: unary (POWER unary)?

?unary: (PLUS | MINUS) unary
      | postfix

?postfix: primary array_access*
        | primary "." IDENTIFIER
        | primary "(" argument_list? ")"

?primary: atom
        | "(" expression ")"

?atom: IDENTIFIER
     | STRING
     | ESCAPED_STRING
     | INT
     | HEX_INT
     | BOOLEAN
     | DATE_LIT
     | TIME_LIT
     | NULL
     | THIS
     | SUPER
     | PARENT

// Function/method calls
function_call: IDENTIFIER "(" argument_list? ")"
method_call: primary "." IDENTIFIER "(" argument_list? ")"

// Array access
array_access: "[" expression_list "]"

// Lists
argument_list: argument ("," argument)*
argument: expression

expression_list: expression ("," expression)*

value_list: value ("," value)*
value: expression | STRING | INT | BOOLEAN | NULL

// Control flow structures
if_statement: IF expression THEN NEWLINE
              statement*
              (ELSEIF expression THEN NEWLINE statement*)*
              (ELSE NEWLINE statement*)?
              END_IF

for_statement: FOR IDENTIFIER EQUALS expression TO expression [STEP expression] NEWLINE
               statement*
               NEXT

while_statement: WHILE expression NEWLINE
                 statement*
                 LOOP

do_while_statement: DO NEWLINE
                    statement*
                    LOOP WHILE expression

try_statement: TRY NEWLINE
               statement*
               (CATCH "(" type_spec IDENTIFIER ")" NEWLINE statement*)*
               (FINALLY NEWLINE statement*)?
               END_TRY

// Basic statements
?statement: assignment_statement
          | declaration_statement
          | return_statement
          | call_statement
          | expression_statement
          | if_statement
          | for_statement
          | while_statement
          | do_while_statement
          | try_statement
          | NEWLINE

assignment_statement: lvalue EQUALS expression NEWLINE
declaration_statement: type_spec IDENTIFIER [array_bounds] [EQUALS expression] NEWLINE
return_statement: RETURN [expression] NEWLINE
call_statement: CALL expression NEWLINE
expression_statement: expression NEWLINE

lvalue: IDENTIFIER
      | primary "." IDENTIFIER
      | primary array_access

# ==================
# Export all rules
# ==================
// This allows other grammars to import all rules with:
// %import .common_grammar_enhanced.*