// sql_fixed.lark - Fixed version without reduce/reduce conflicts

// Import common tokens
%import .common_grammar.LPAR
%import .common_grammar.RPAR
%import .common_grammar.COMMA
%import .common_grammar.DOT
%import .common_grammar.EQ
%import .common_grammar.SEMICOLON
%import .common_grammar.ESCAPED_STRING
%import .common_grammar.INT

// Import standard tokens
%import common.CNAME -> IDENTIFIER
%import common.WS
%import common.NEWLINE

%ignore WS
%ignore SQL_LINE_COMMENT
%ignore SQL_MULTILINE_COMMENT
%ignore NEWLINE

// --- SQL-specific terminals (not in common_grammar) ---

// For expressions
STAR: "*"      // Multiplicative
SLASH: "/"     // Multiplicative
PERCENT_TERM: "%"   // Multiplicative (renamed from PERCENT)

TILDE: "~"     // Unary bitwise NOT

// Overloaded + and - need distinct versions for unary vs binary for precedence
UPLUS: "+"
UMINUS: "-"
BPLUS: "+"     // Binary Add
BMINUS: "-"    // Binary Subtract

CONCAT_OP: "||" // String concatenation
NOT_KWD: "NOT"i // Logical NOT keyword, distinct from "NOT" in "IS NOT NULL" for example.

// Logical operator keywords for precedence
AND_KWD: "AND"i
OR_KWD: "OR"i

// Comparison operators
NEQ_OP: "!=" | "<>"

// SQL-specific tokens
SIGNED_NUMBER: /[+-]?[0-9]+(?:\.[0-9]+)?(?:[eE][+-]?[0-9]+)?/

SQL_LINE_COMMENT: /--[^\n]*/
SQL_MULTILINE_COMMENT: /\/\*(?:.|\n)*?\*\//

QUESTION_MARK_PARAM: "?"
COLON_PARAM: /:[a-zA-Z_][a-zA-Z0-9_]*/

// Keywords as terminals
SELECT: "SELECT"i
UPDATE: "UPDATE"i
DISTINCT: "DISTINCT"i
FROM: "FROM"i
WHERE: "WHERE"i
GROUP_BY: "GROUP"i WS "BY"i
HAVING: "HAVING"i
ORDER_BY: "ORDER"i WS "BY"i
AS: "AS"i
JOIN: "JOIN"i
INNER: "INNER"i
LEFT: "LEFT"i
RIGHT: "RIGHT"i
FULL: "FULL"i
OUTER: "OUTER"i
ON: "ON"i
CROSS: "CROSS"i
UNION: "UNION"i
EXCEPT: "EXCEPT"i
INTERSECT: "INTERSECT"i
ALL: "ALL"i
ANY: "ANY"i
SOME: "SOME"i
IN: "IN"i
EXISTS: "EXISTS"i
BETWEEN: "BETWEEN"i
LIKE: "LIKE"i
ESCAPE: "ESCAPE"i
IS: "IS"i
NULL: "NULL"i
COLLATE: "COLLATE"i
CASE: "CASE"i
WHEN: "WHEN"i
THEN: "THEN"i
ELSE: "ELSE"i
END: "END"i
ASC: "ASC"i
DESC: "DESC"i
SET: "SET"i
USING: "USING"i
VALUES: "VALUES"i
INSERT: "INSERT"i
INTO: "INTO"i
DELETE: "DELETE"i
DEFAULT: "DEFAULT"i

// --- Grammar Rules ---

?start: sql_stmts

sql_stmts: sql_stmt*

?sql_stmt: query_statement | non_query_statement

?query_statement: query_expr

?non_query_statement: update_stmt | delete_stmt | insert_stmt | set_stmt
                    | open_stmt | close_stmt | fetch_stmt
                    | execute_stmt | declare_stmt | prepare_stmt | begin_end

update_stmt: UPDATE qualified_asterisk SET assignment_list [WHERE where_expr] [USING db_reference] SEMICOLON?

set_stmt: SET IDENTIFIER EQ expr SEMICOLON?

open_stmt: OPEN IDENTIFIER [USING db_reference] SEMICOLON?

close_stmt: CLOSE IDENTIFIER SEMICOLON?

fetch_stmt: FETCH IDENTIFIER INTO colon_list [USING db_reference] SEMICOLON?

execute_stmt: EXECUTE IDENTIFIER [USING parameter_list] SEMICOLON?
            | EXECUTE IMMEDIATE expr [USING parameter_list]

declare_stmt: DECLARE IDENTIFIER CURSOR FOR query_expr SEMICOLON?
            | DECLARE IDENTIFIER PROCEDURE FOR IDENTIFIER procedure_params SEMICOLON?

prepare_stmt: PREPARE IDENTIFIER FROM expr [USING db_reference] SEMICOLON?

begin_end: BEGIN sql_stmts END SEMICOLON?

delete_stmt: DELETE [FROM] table_name [WHERE where_expr] [USING db_reference] SEMICOLON?

insert_stmt: INSERT INTO table_name [column_name_list] VALUES LPAR expr_list RPAR [USING db_reference] SEMICOLON?
           | INSERT INTO table_name [column_name_list] query_expr [USING db_reference] SEMICOLON?

assignment_list: assignment (COMMA assignment)*
assignment: IDENTIFIER EQ expr

colon_list: COLON_PARAM (COMMA COLON_PARAM)*

parameter_list: parameter (COMMA parameter)*
parameter: expr | COLON_PARAM

procedure_params: LPAR [COLON_PARAM (COMMA COLON_PARAM)*] RPAR

// Update db_reference to be simpler
db_reference: IDENTIFIER

// --- Query Expression with Set Operations ---
query_expr: combined_query

combined_query: non_join_query
              | combined_query set_op non_join_query

non_join_query: simple_query

set_op: UNION [ALL] | EXCEPT [ALL] | INTERSECT [ALL]

simple_query: select_stmt
            | LPAR query_expr RPAR

select_stmt: select_clause from_clause [where_clause] [group_by_clause] [having_clause] [order_by_clause]

// --- SELECT Clause ---
select_clause: SELECT [DISTINCT] select_list

select_list: select_sublist (COMMA select_sublist)*

select_sublist: expr [[AS] IDENTIFIER]
              | STAR

// --- FROM Clause ---
from_clause: FROM table_expr

table_expr: non_join_table_expr
          | join_table_expr

non_join_table_expr: table_ref

table_ref: qualified_join [[AS] IDENTIFIER]
         | LPAR query_expr RPAR [[AS] IDENTIFIER]

join_table_expr: table_expr CROSS JOIN table_expr
               | table_expr [join_type] JOIN table_expr ON expr

join_type: INNER | LEFT [OUTER] | RIGHT [OUTER] | FULL [OUTER]

// --- WHERE, GROUP BY, HAVING, ORDER BY ---
where_clause: WHERE where_expr

// Create a specific rule for where expressions that avoids conflicts
where_expr: expr

group_by_clause: GROUP_BY expr_list

having_clause: HAVING expr

order_by_clause: ORDER_BY order_by_list

order_by_list: order_by_expr (COMMA order_by_expr)*

order_by_expr: expr [ASC | DESC]

expr_list: expr (COMMA expr)*

// --- EXPRESSIONS with Precedence ---
?expr: conditional_expr

?conditional_expr: logical_or_expr

?logical_or_expr: logical_and_expr
                | logical_or_expr OR_KWD logical_and_expr

?logical_and_expr: relational_expr
                 | logical_and_expr AND_KWD relational_expr

?relational_expr: additive_expr
                | relational_expr comparison_op additive_expr
                | additive_expr BETWEEN additive_expr AND_KWD additive_expr
                | additive_expr [NOT_KWD] IN in_value_list
                | additive_expr LIKE additive_expr [ESCAPE additive_expr]
                | additive_expr IS [NOT_KWD] NULL
                | EXISTS LPAR query_expr RPAR

comparison_op: EQ | NEQ_OP | "<" | ">" | "<=" | ">="

in_value_list: LPAR expr_list RPAR
             | LPAR query_expr RPAR

?additive_expr: multiplicative_expr
              | additive_expr BPLUS multiplicative_expr
              | additive_expr BMINUS multiplicative_expr
              | additive_expr CONCAT_OP multiplicative_expr

?multiplicative_expr: unary_expr
                    | multiplicative_expr STAR unary_expr
                    | multiplicative_expr SLASH unary_expr
                    | multiplicative_expr PERCENT_TERM unary_expr

?unary_expr: BPLUS unary_expr -> pos
           | BMINUS unary_expr -> neg
           | TILDE unary_expr -> bitnot
           | NOT_KWD unary_expr -> not
           | postfix_expr

?postfix_expr: primary_expr
             | postfix_expr LPAR [arg_list] RPAR -> func_call
             | postfix_expr DOT IDENTIFIER -> field_ref
             | postfix_expr "[" expr "]" -> array_ref
             | postfix_expr COLLATE IDENTIFIER -> collate_expr

?primary_expr: literal
             | IDENTIFIER
             | COLON_PARAM
             | QUESTION_MARK_PARAM
             | LPAR expr RPAR
             | case_expr
             | aggregate_func
             | builtin_func

arg_list: expr (COMMA expr)*

aggregate_func: agg_name LPAR agg_arg RPAR

agg_name: "COUNT"i | "SUM"i | "AVG"i | "MIN"i | "MAX"i | "STDDEV"i | "VARIANCE"i

agg_arg: STAR | [DISTINCT] expr

builtin_func: builtin_name LPAR [arg_list] RPAR

builtin_name: "UPPER"i | "LOWER"i | "SUBSTR"i | "SUBSTRING"i | "TRIM"i | "LTRIM"i | "RTRIM"i
            | "COALESCE"i | "CAST"i | "CONVERT"i | "ROUND"i | "ABS"i | "FLOOR"i | "CEIL"i
            | "LENGTH"i | "CHAR_LENGTH"i | "CONCAT"i | "REPLACE"i | "POSITION"i
            | "DATE"i | "TIME"i | "TIMESTAMP"i | "CURRENT_DATE"i | "CURRENT_TIME"i | "CURRENT_TIMESTAMP"i
            | "EXTRACT"i | "YEAR"i | "MONTH"i | "DAY"i | "HOUR"i | "MINUTE"i | "SECOND"i

case_expr: CASE [expr] case_when_list [ELSE expr] END

case_when_list: case_when+

case_when: WHEN expr THEN expr

literal: SIGNED_NUMBER
       | ESCAPED_STRING
       | NULL

// --- Supporting Rules ---
qualified_join: IDENTIFIER
              | IDENTIFIER DOT IDENTIFIER

qualified_asterisk: IDENTIFIER [DOT STAR]
                  | IDENTIFIER DOT IDENTIFIER [DOT STAR]

table_name: qualified_join

column_name_list: LPAR IDENTIFIER (COMMA IDENTIFIER)* RPAR

// Keywords for non-query statements
BEGIN: "BEGIN"i
OPEN: "OPEN"i
CLOSE: "CLOSE"i
FETCH: "FETCH"i
EXECUTE: "EXECUTE"i
IMMEDIATE: "IMMEDIATE"i
DECLARE: "DECLARE"i
CURSOR: "CURSOR"i
FOR: "FOR"i
PROCEDURE: "PROCEDURE"i
PREPARE: "PREPARE"i