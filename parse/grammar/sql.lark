// sql_fixed.lark - Fixed version without reduce/reduce conflicts

%ignore WS
%ignore SQL_LINE_COMMENT
%ignore SQL_MULTILINE_COMMENT
%ignore NEWLINE

// --- Terminals (some redefined/added for precedence) ---
LPAR: "("
RPAR: ")"
COMMA: ","
DOT: "."
EQ: "=" // Also used as an operator, will need specific OP_EQ or similar if precedence is assigned here.
SEMICOLON: ";"

// For expressions
STAR: "*"      // Multiplicative
SLASH: "/"     // Multiplicative
PERCENT_TERM: "%"   // Multiplicative (renamed from PERCENT)

TILDE: "~"     // Unary bitwise NOT

// Overloaded + and - need distinct versions for unary vs binary for precedence
UPLUS: "+"
UMINUS: "-"
BPLUS: "+"     // Binary Add
BMINUS: "-"    // Binary Subtract

CONCAT_OP: "||" // String concatenation
NOT_KWD: "NOT"i // Logical NOT keyword, distinct from "NOT" in "IS NOT NULL" for example.

// Logical operator keywords for precedence
AND_KWD: "AND"i
OR_KWD: "OR"i

// Comparison operators
NEQ_OP: "!=" | "<>"

IDENTIFIER: /[a-zA-Z_][a-zA-Z0-9_]*/
WS: /[ \t\f\r]+/
NEWLINE: /(\r?\n)+/
INT: /[0-9]+/
ESCAPED_STRING: /'(?:''|[^'])*'|"(?:""|[^"])*"/
SIGNED_NUMBER: /[+-]?[0-9]+(?:\.[0-9]+)?(?:[eE][+-]?[0-9]+)?/

SQL_LINE_COMMENT: /--[^\n]*/
SQL_MULTILINE_COMMENT: /\/\*(?:.|\n)*?\*\//

QUESTION_MARK_PARAM: "?"
COLON_PARAM: /:[a-zA-Z_][a-zA-Z0-9_]*/

// Keyword tokens for precedence and disambiguation
ON_KWD: "ON"i
USING_KWD: "USING"i
IN_KWD: "IN"i
BETWEEN_KWD: "BETWEEN"i
LIKE_KWD: "LIKE"i
IS_KWD: "IS"i
NULL_KWD: "NULL"i
EXISTS_KWD: "EXISTS"i
CASE_KWD: "CASE"i
WHEN_KWD: "WHEN"i
THEN_KWD: "THEN"i
ELSE_KWD: "ELSE"i
END_KWD: "END"i
CAST_KWD: "CAST"i
AS_KWD: "AS"i

// --- Grammar ---
start: sql_statement_list

sql_statement_list: sql_statement_with_semi*

sql_statement_with_semi: sql_statement SEMICOLON?

// Fixed: Removed with_clause from select_statement to avoid duplication
sql_statement: select_statement_with_cte
             | insert_statement
             | update_statement  
             | delete_statement

// Separate rules for statements with/without CTEs
select_statement_with_cte: with_clause select_statement_core
                         | select_statement_core

// Core select statement without with_clause
select_statement_core: select_core order_by_clause? limit_clause?

// WITH clause for CTEs
with_clause: "WITH"i with_expression (COMMA with_expression)*

with_expression: simple_name optional_simple_column_list_spec "AS"i LPAR select_statement_core RPAR

optional_simple_column_list_spec: (LPAR simple_name (COMMA simple_name)* RPAR)?

// --- Statement rules ---
insert_statement: "INSERT"i "INTO"i table_name_ref LPAR column_list RPAR ("VALUES"i value_lists | select_statement_core)

value_lists: LPAR value_list RPAR (COMMA LPAR value_list RPAR)*

update_statement: "UPDATE"i table_name_ref "SET"i assignment_list where_clause?

delete_statement: "DELETE"i "FROM"i table_name_ref where_clause?

assignment_list: assignment (COMMA assignment)*
assignment: column_reference EQ expr

column_list: simple_name (COMMA simple_name)*
value_list: expr (COMMA expr)*

// --- Name parsing rules ---
simple_name: IDENTIFIER
dotted_name_suffix: (DOT IDENTIFIER)+
fully_qualified_name: IDENTIFIER dotted_name_suffix // Ensures at least one DOT

table_name_ref: fully_qualified_name -> fqn_as_table_component 
              | simple_name -> simple_name_as_table_component

table_alias: simple_name
column_alias: simple_name
_simple_column_list: simple_name (COMMA simple_name)*

// Define the content of a FROM clause separately
from_clause_content: table_or_subquery (COMMA table_or_subquery)* join_clause*

select_core: "SELECT"i distinct_clause? result_column (COMMA result_column)* ("FROM"i from_clause_content)? where_clause? group_by_clause? having_clause?

distinct_clause: "DISTINCT"i | "ALL"i

// result_column (Updated column_alias usage, definition of column_alias moved above)
result_column: STAR -> result_star
             | expr ("AS"i? column_alias)? -> result_expr

// table_or_subquery (Updated to use _table_name_ref and table_alias)
table_or_subquery: table_name_ref ("AS"i? table_alias)?
                 | LPAR select_statement_core RPAR ("AS"i? table_alias)? // Subquery in FROM

join_clause: join_operator table_or_subquery join_constraint?
join_operator: "INNER"i? "JOIN"i               -> simple_join
             | "LEFT"i "OUTER"i? "JOIN"i       -> left_join
             | "RIGHT"i "OUTER"i? "JOIN"i      -> right_join
             | "FULL"i "OUTER"i? "JOIN"i       -> full_join
             | "CROSS"i "JOIN"i                -> cross_join
             | COMMA                           -> comma_join

// join_constraint (Updated to use _simple_column_list for USING clause)
join_constraint: "ON"i expr
               | "USING"i LPAR _simple_column_list RPAR

where_clause: "WHERE"i expr
group_by_clause: "GROUP"i "BY"i expr (COMMA expr)*
having_clause: "HAVING"i expr
order_by_clause: "ORDER"i "BY"i ordering_term (COMMA ordering_term)*
ordering_term: expr ("ASC"i | "DESC"i)?

limit_clause: "LIMIT"i expr ("OFFSET"i expr)?

// Column reference now uses the name parsing rules
column_reference: fully_qualified_name  -> fully_qualified_column
                | simple_name           -> simple_column

// --- Expression Grammar with Precedence ---

?expr: logical_or
?logical_or: logical_and
           | logical_or OR_KWD logical_and -> logical_or
?logical_and: equality_expr
            | logical_and AND_KWD equality_expr -> logical_and

// Comparison operators with chaining support
?equality_expr: comp_expr
              | equality_expr EQ comp_expr -> equality_op_eq
              | equality_expr NEQ_OP comp_expr -> equality_op_neq
              | equality_expr IS_KWD NULL_KWD -> is_null_operation
              | equality_expr IS_KWD NOT_KWD NULL_KWD -> is_not_null_operation

?comp_expr: additive_expr
          | comp_expr _comp_operator additive_expr -> comp_op
          | comp_expr NOT_KWD? IN_KWD LPAR expr (COMMA expr)* RPAR -> in_op_list
          | comp_expr NOT_KWD? IN_KWD LPAR select_statement_core RPAR -> in_op_subquery
          | comp_expr NOT_KWD? BETWEEN_KWD additive_expr AND_KWD additive_expr -> between_op
          | comp_expr NOT_KWD? LIKE_KWD additive_expr -> like_op

// Hidden rule for comparison operators
_comp_operator: "<" | ">" | "<=" | ">="

// Arithmetic operators
?additive_expr: mult_expr
              | additive_expr BPLUS mult_expr -> bin_plus
              | additive_expr BMINUS mult_expr -> bin_minus
              | additive_expr CONCAT_OP mult_expr -> concat

?mult_expr: unary_expr
          | mult_expr STAR unary_expr -> multiply
          | mult_expr SLASH unary_expr -> divide
          | mult_expr PERCENT_TERM unary_expr -> modulo

?unary_expr: UMINUS unary_expr -> unary_minus
           | UPLUS unary_expr -> unary_plus
           | TILDE unary_expr -> unary_tilde
           | NOT_KWD unary_expr -> unary_not_logical
           | primary_expr -> unary_passthrough

?primary_expr: literal_value
             | column_reference
             | LPAR expr RPAR -> parenthesized_expression
             | function_call
             | cast_expression
             | case_expression
             | EXISTS_KWD LPAR select_statement_core RPAR -> exists_expression
             | LPAR select_statement_core RPAR -> subquery_as_expression
             | QUESTION_MARK_PARAM -> parameter_marker
             | COLON_PARAM -> named_parameter

// Literals
literal_value: SIGNED_NUMBER -> numeric_literal
             | ESCAPED_STRING -> string_literal
             | NULL_KWD -> null_literal

// Function call
function_call: simple_name LPAR fn_args? RPAR

// Function arguments (not hidden anymore to allow aliases)
fn_args: fn_args_list
       | STAR -> fn_args_star
fn_args_list: expr (COMMA expr)*

// CAST expression
cast_expression: CAST_KWD LPAR expr AS_KWD type_name RPAR

// Type name (simplified for now)
type_name: simple_name (LPAR INT (COMMA INT)? RPAR)?

// CASE expression
case_expression: CASE_KWD expr? when_clause+ (ELSE_KWD expr)? END_KWD

when_clause: WHEN_KWD expr THEN_KWD expr