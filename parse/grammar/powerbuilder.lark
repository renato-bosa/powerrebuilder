# Unified EBNF grammar for UI, DW, PCode headers
# - Combines all grammar rules (window, control, event, function, type blocks, etc.)
# - Imports common tokens and rules from common_grammar.lark

# Import all common tokens and rules
%import .common_grammar.HEX_INT
%import .common_grammar.DATE_LIT
%import .common_grammar.TIME_LIT
%import .common_grammar.STRING
%import .common_grammar.ESCAPED_STRING
%import .common_grammar.COMMENT
%import .common_grammar.LPAR
%import .common_grammar.RPAR
%import .common_grammar.LBRACE
%import .common_grammar.RBRACE
%import .common_grammar.LBRACK
%import .common_grammar.RBRACK
%import .common_grammar.COMMA
%import .common_grammar.COLON
%import .common_grammar.EQUALS
%import .common_grammar.SEMICOLON
%import .common_grammar.DOT
%import .common_grammar.GT
%import .common_grammar.LT
%import .common_grammar.GE
%import .common_grammar.LE
%import .common_grammar.EQ
%import .common_grammar.NE
%import .common_grammar.PLUS
%import .common_grammar.MINUS
%import .common_grammar.MULT
%import .common_grammar.DIV
%import .common_grammar.MOD
%import .common_grammar.POWER
%import .common_grammar.TYPE
%import .common_grammar.FROM
%import .common_grammar.GLOBAL
%import .common_grammar.VARIABLES
%import .common_grammar.RETURN
%import .common_grammar.IF
%import .common_grammar.THEN
%import .common_grammar.ELSE
%import .common_grammar.END
%import .common_grammar.END_IF
%import .common_grammar.TRY
%import .common_grammar.CATCH
%import .common_grammar.FINALLY
%import .common_grammar.THROW
%import .common_grammar.USING
%import .common_grammar.PUBLIC
%import .common_grammar.PRIVATE
%import .common_grammar.PROTECTED
%import .common_grammar.SHARED
%import .common_grammar.TYPE_NAME
%import .common_grammar.BOOLEAN
%import .common_grammar.expression
%import .common_grammar.if_statement
%import .common_grammar.try_catch
%import .common_grammar.value

# Import standard tokens
%import common.CNAME       -> IDENTIFIER
%import common.INT        -> INT
%import common.WS_INLINE
%import common.NEWLINE
%import common.WS

# PowerBuilder-specific tokens that aren't in common_grammar
NOT: "not"
AND: "and"
OR: "or"

// Control types including DataWindow and advanced controls
CONTROL_TYPE.2: "commandbutton" | "datawindow" | "edit" | "statictext" | "checkbox" | "radiobutton" | "dropdownlistbox" | "picturebutton" | "tab" | "groupbox" | "treeview" | "listview" | "richtextedit" | "graph" | "ole" | "vscrollbar" | "hscrollbar" | "picture" | "mdiclient"

// Event types including system events
EVENT_TYPE.2: "on" | "function" | "subroutine" | "event" | "post" | "trigger" | "systemfunction" | "systemservice" | "ButtonClicked" | "ButtonClicking" | "Clicked" | "DoubleClicked" | "ItemChanged" | "ItemError" | "ItemFocusChanged" | "RButtonDown" | "RowFocusChanged" | "RowFocusChanging" | "create" | "destroy"

// Window/control/app block types
BLOCK_TYPE.2: "window" | "datawindow" | "userobject" | "application" | "menu"

// Extended keywords for object definitions
WINDOW: "window"
END_FORWARD: "end forward"
END_TYPE: "end type"
END_VARIABLES: "end variables"
TYPE_VARIABLES: "type variables"
INSTANCE: "instance"
FORWARD: "forward"
GLOBAL_TYPE: "global type"
END_GLOBAL_TYPE: "end global type"
WITHIN: "within"
END_ON: "end on"
END_EVENT: "end event"
END_FUNCTION: "end function"
END_PROTOTYPES: "end prototypes"
FORWARD_PROTOTYPES: "forward prototypes"
NULL_KW: "null"
THIS: "this"
PARENT: "parent"
SUPER: "super"
CREATE: "create"
DESTROY: "destroy"
CALL: "call"
FOR: "for"
TO: "to"
NEXT: "next"
DO: "do"
WHILE: "while"
LOOP: "loop"
UNTIL: "until"
CHOOSE: "choose"
CASE: "case"
END_CHOOSE: "end choose"
EXIT: "exit"
CONTINUE: "continue"
HALT: "halt"
OPEN: "open"
CLOSE: "close"
DESCRIPTOR: "descriptor"

// Extended accessors
ACCESSOR.2: PUBLIC | PRIVATE | PROTECTED | "global"

// Data types 
array_bounds: "[" (INT | IDENTIFIER) ("," (INT | IDENTIFIER))* "]"
array_init: "{" value_list "}"
value_list: value ("," value)*

// Main start rule for parsing different file types
start: powerbuilder_file

powerbuilder_file: header? global_section* type_section? variable_section? forward_section? object_section* 
                 | sql_statement+  // For standalone SQL
                 | datawindow_definition  // For DataWindow definitions

// Header for exported files
header: "$PBExportHeader$" STRING COMMENT? NEWLINE
      | "$PBExportHeader$" STRING NEWLINE

// Forward prototypes section
forward_section: (FORWARD | FORWARD_PROTOTYPES) NEWLINE forward_decl* (END_FORWARD | END_PROTOTYPES) NEWLINE
forward_decl: global_decl | type_decl

// Global section for functions and types
global_section: global_decl | type_decl

global_decl: accessor_modifier? GLOBAL function_decl
           | GLOBAL TYPE_VARIABLES NEWLINE var_decl* END_VARIABLES NEWLINE

// Type declarations 
type_decl: accessor_modifier? TYPE IDENTIFIER FROM IDENTIFIER (WITHIN IDENTIFIER)? NEWLINE
         | GLOBAL_TYPE IDENTIFIER FROM IDENTIFIER (WITHIN IDENTIFIER)? attribute* END_GLOBAL_TYPE NEWLINE

// Variable declarations
variable_section: TYPE_VARIABLES NEWLINE var_decl* END_VARIABLES NEWLINE
                | (SHARED | INSTANCE) VARIABLES NEWLINE var_decl* END_VARIABLES NEWLINE

var_decl: accessor_modifier? TYPE_NAME array_bounds? IDENTIFIER array_init? (EQUALS value)? NEWLINE
        | TYPE_NAME IDENTIFIER array_bounds? array_init? (EQUALS value)? NEWLINE
        | TYPE_NAME IDENTIFIER (EQUALS value)? NEWLINE

// Object sections (windows, controls, etc)
object_section: window_object | control_object | event_handler | function_decl | on_block

// Window object definition
window_object: GLOBAL_TYPE IDENTIFIER FROM IDENTIFIER (WITHIN IDENTIFIER)? NEWLINE 
               window_attribute* 
               END_TYPE NEWLINE 
               (type_section | variable_section | event_handler | function_decl | on_block)*

window_attribute: TYPE_NAME IDENTIFIER (EQUALS value)? NEWLINE
                | attribute

// Control object definitions
control_object: TYPE IDENTIFIER FROM CONTROL_TYPE (WITHIN IDENTIFIER)? descriptor_clause? NEWLINE 
                attribute* 
                END_TYPE NEWLINE

descriptor_clause: DESCRIPTOR STRING (EQUALS STRING)?

// Attributes for objects
attribute: IDENTIFIER (EQUALS | "=") value NEWLINE
         | IDENTIFIER array_bounds? (EQUALS | "=") array_init NEWLINE
         | IDENTIFIER NEWLINE

// Function declarations
function_decl: accessor_modifier? function_header function_body
             | function_header function_body

function_header: (FUNCTION | SUBROUTINE) return_type? IDENTIFIER "(" parameter_list? ")" library_clause? NEWLINE

return_type: TYPE_NAME array_bounds?

parameter_list: parameter ("," parameter)*
parameter: ref_modifier? TYPE_NAME array_bounds? IDENTIFIER default_value?
ref_modifier: "ref" | "readonly"
default_value: EQUALS value
library_clause: "library" STRING ("alias" "for" STRING)?

function_body: local_vars? code_statements* (END_FUNCTION | END) NEWLINE
local_vars: variable_section

// Event handlers  
event_handler: EVENT (IDENTIFIER "::")? IDENTIFIER EVENT_TYPE? "(" parameter_list? ")" NEWLINE
               local_vars? code_statements* END_EVENT NEWLINE

// On blocks for initialization/destruction
on_block: "on" IDENTIFIER "." (CREATE | DESTROY) NEWLINE
          code_statements*
          END_ON NEWLINE

// Code statements (simplified - can be expanded)
code_statements: assignment_statement
               | if_statement
               | loop_statement  
               | try_catch_statement
               | call_statement
               | return_statement
               | sql_statement
               | choose_statement
               | exit_statement
               | continue_statement
               | comment_line
               | expression NEWLINE

assignment_statement: IDENTIFIER array_access? (DOT IDENTIFIER)* EQUALS expression NEWLINE
                    | IDENTIFIER "[" expression "]" EQUALS expression NEWLINE

loop_statement: for_loop | while_loop | do_loop

for_loop: FOR IDENTIFIER EQUALS expression TO expression NEWLINE
          code_statements*
          NEXT NEWLINE

while_loop: DO WHILE expression NEWLINE
            code_statements*
            LOOP NEWLINE

do_loop: DO NEWLINE
         code_statements*
         LOOP (WHILE | UNTIL) expression NEWLINE

choose_statement: CHOOSE CASE expression NEWLINE
                  case_clause+
                  END_CHOOSE NEWLINE

case_clause: CASE value ("," value)* NEWLINE code_statements*
           | CASE ELSE NEWLINE code_statements*

exit_statement: EXIT NEWLINE
continue_statement: CONTINUE NEWLINE

try_catch_statement: TRY NEWLINE
                     code_statements*
                     (CATCH "(" TYPE_NAME IDENTIFIER ")" NEWLINE code_statements*)*
                     (FINALLY NEWLINE code_statements*)?
                     END_TRY NEWLINE

call_statement: CALL (IDENTIFIER | expression) NEWLINE
              | (IDENTIFIER | THIS | PARENT | SUPER) (DOT IDENTIFIER)* "(" argument_list? ")" NEWLINE
              | POST (IDENTIFIER | expression) NEWLINE

return_statement: RETURN expression? NEWLINE

comment_line: COMMENT NEWLINE

// Array access
array_access: "[" expression ("," expression)* "]"

// Argument lists for function/method calls
argument_list: argument ("," argument)*
argument: expression

// PowerBuilder-specific expressions
pb_expression: expression
             | THIS | PARENT | SUPER
             | NULL_KW
             | CREATE IDENTIFIER
             | DESTROY IDENTIFIER

// Accessor modifiers
accessor_modifier: ACCESSOR | SHARED

// DataWindow definition (simplified)
datawindow_definition: "release" INT ";" NEWLINE dw_content+
dw_content: dw_section | comment_line | NEWLINE

dw_section: "datawindow" "(" dw_attributes ")" NEWLINE
          | "header" "(" dw_attributes ")" NEWLINE  
          | "detail" "(" dw_attributes ")" NEWLINE
          | "footer" "(" dw_attributes ")" NEWLINE
          | "table" "(" dw_table_def ")" NEWLINE
          | "column" "(" dw_column_def ")" NEWLINE
          | "text" "(" dw_text_def ")" NEWLINE

dw_attributes: dw_attribute*
dw_attribute: IDENTIFIER "=" value
dw_table_def: dw_attribute*
dw_column_def: dw_attribute*
dw_text_def: dw_attribute*

// SQL statements (simplified)
sql_statement: select_statement
             | insert_statement
             | update_statement
             | delete_statement
             | embedded_sql_statement

select_statement: "SELECT" select_list FROM table_list where_clause? order_by_clause? ";" NEWLINE
select_list: "*" | column_name ("," column_name)*
table_list: table_name ("," table_name)*
where_clause: "WHERE" expression
order_by_clause: "ORDER" "BY" column_name ("ASC" | "DESC")? ("," column_name ("ASC" | "DESC")?)*

insert_statement: "INSERT" "INTO" table_name "(" column_name ("," column_name)* ")" 
                  "VALUES" "(" value ("," value)* ")" ";" NEWLINE

update_statement: "UPDATE" table_name "SET" column_assignment ("," column_assignment)* 
                  where_clause? ";" NEWLINE
column_assignment: column_name "=" expression

delete_statement: "DELETE" FROM table_name where_clause? ";" NEWLINE

embedded_sql_statement: sql_keyword+ ";" NEWLINE

// SQL identifiers
table_name: IDENTIFIER | IDENTIFIER "." IDENTIFIER
column_name: IDENTIFIER | IDENTIFIER "." IDENTIFIER | "*"
sql_keyword: IDENTIFIER | STRING | INT | LPAR | RPAR | COMMA | DOT | EQUALS

// Special end keywords
END_TRY: "end try"

%ignore WS
%ignore COMMENT