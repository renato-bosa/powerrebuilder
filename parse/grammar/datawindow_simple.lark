# Simplified PowerBuilder DataWindow Grammar for reconstructed syntax

// Top level
start: element*

element: comment_line
       | release_statement  
       | datawindow_decl
       | datawindow_prop
       | band_decl
       | table_decl
       | column_decl

// Comments
comment_line: /\/\/[^\n]*/

// Release
release_statement: "release" INT ";"

// DataWindow declarations
datawindow_decl: "datawindow" "(" ")"
datawindow_prop: "datawindow" "." IDENTIFIER "=" value

// Bands (header, footer, etc)
band_decl: band_type "(" property_list? ")"
band_type: "header" | "footer" | "summary" | "detail"

// Table
table_decl: "table" "(" table_content ")"
table_content: column_spec+ retrieve_spec?
column_spec: "column" "=" "(" property_list ")"
retrieve_spec: "retrieve" "=" STRING

// Column declarations
column_decl: "column" "=" "(" property_list ")"

// Properties  
property_list: property+
property: IDENTIFIER "=" value
        | IDENTIFIER "." IDENTIFIER "=" value

// Values
value: STRING
     | INT
     | IDENTIFIER
     | function_call
     | "yes" | "no"
     
function_call: IDENTIFIER "(" arguments? ")"
arguments: value ("," value)*

// Tokens
INT: /[0-9]+/
STRING: /"[^"]*"/
IDENTIFIER: /[a-zA-Z_][a-zA-Z0-9_]*/

%ignore /[ \t\r\n]+/