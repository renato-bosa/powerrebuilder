// DataWindow Grammar
// This grammar parses PowerBuilder DataWindow object files (.dwo/.srd)
// Including support for PBSELECT statements

?start: datawindow_file

datawindow_file: statement+

?statement: release_statement
          | datawindow_statement  
          | table_statement
          | column_statement
          | header_statement
          | summary_statement
          | footer_statement
          | detail_statement
          | pbselect_statement
          | arg_statement
          | comment

// ARG Statement (standalone argument definition)
arg_statement: "ARG" LPAR arg_properties RPAR

arg_properties: arg_property+
arg_property: "NAME" EQUAL string_value
            | "TYPE" EQUAL IDENTIFIER

// PBSELECT Statement (PowerBuilder-specific SQL syntax)
pbselect_statement: "PBSELECT" LPAR pbselect_clauses RPAR

pbselect_clauses: pbselect_clause+

pbselect_clause: version_clause
               | table_clause  
               | pbselect_column_clause
               | join_clause
               | where_clause
               | compute_clause
               | pbselect_name_clause
               | pbselect_dbname_clause
               | pbselect_values_clause
               | pbselect_retrieve_clause
               | pbselect_update_clause
               | pbselect_updatewhere_clause
               | updatekeyinplace_clause
               | arguments_clause
               | distinct_clause
               | sort_clause
               | result_clause
               | arg_clause
               | logic_clause
               | logc_clause
               | unknown_pbselect_clause

version_clause: "VERSION" LPAR NUMBER RPAR
table_clause: "TABLE" LPAR table_list RPAR
pbselect_column_clause: "COLUMN" LPAR pbselect_column_spec RPAR
pbselect_name_clause: "NAME" EQUAL string_value
pbselect_dbname_clause: "DBNAME" EQUAL string_value
pbselect_values_clause: "VALUES" LPAR string_values RPAR
pbselect_retrieve_clause: "RETRIEVE" EQUAL string_value
pbselect_update_clause: "UPDATE" EQUAL string_value  
pbselect_updatewhere_clause: "UPDATEWHERE" EQUAL NUMBER
arguments_clause: "ARGUMENTS" LPAR argument_list RPAR
updatekeyinplace_clause: "UPDATEKEYINPLACE" EQUAL "NO"
sort_clause: "SORT" EQUAL string_value
distinct_clause: "DISTINCT" EQUAL "YES"
result_clause: "RESULT" LPAR result_spec RPAR
arg_clause: "ARG" LPAR arg_spec RPAR

// Keep the original clauses for column statements
name_clause: "NAME" EQUAL string_value
dbname_clause: "DBNAME" EQUAL string_value
values_clause: "VALUES" LPAR string_values RPAR
retrieve_clause: "RETRIEVE" EQUAL string_value
update_clause: "UPDATE" EQUAL string_value  
updatewhere_clause: "UPDATEWHERE" EQUAL NUMBER

// COMPUTE clause for calculated fields
compute_clause: "COMPUTE" LPAR compute_spec RPAR
compute_spec: compute_property+
compute_property: property_assignment
                | "NAME" EQUAL compute_value

// Special handling for multi-line compute values
compute_value: ESCAPED_STRING  // Normal quoted string
             | /"[^"]*[\n\s]+[^"]*"/  // Multi-line quoted string
             | /[^")]+/  // Unquoted text until closing paren or quote

// LOGIC and LOGC clauses (variations of WHERE logic)
logic_clause: "LOGIC" EQUAL string_value
logc_clause: "LOGC" EQUAL string_value

// Support for unknown PBSELECT clauses to be more flexible
unknown_pbselect_clause: IDENTIFIER (EQUAL | LPAR) /[^)]+/ RPAR?

// Table lists
table_list: table_spec
table_spec: "NAME" EQUAL string_value

// PBSELECT column specification
pbselect_column_spec: pbselect_column_property+
pbselect_column_property: property_assignment

string_values: string_value ("," string_value)*
argument_list: argument_spec ("," argument_spec)*
argument_spec: LPAR string_value "," string_value RPAR
result_spec: /[^)]+/
arg_spec: /[^)]+/

// Column Statement 
column_statement: "COLUMN" LPAR column_clauses RPAR

column_clauses: column_clause+

column_clause: band_clause
             | id_clause
             | alignment_clause
             | tabsequence_clause
             | border_clause
             | color_clause
             | x_clause
             | y_clause
             | height_clause
             | width_clause
             | format_clause
             | name_clause
             | tag_clause
             | edit_clause
             | type_clause
             | update_clause
             | updatewhere_clause
             | font_clause
             | background_clause
             | dbname_clause
             | values_clause
             | initial_clause
             | validation_clause
             | validationmsg_clause
             | criteria_clause
             | translate_clause
             | case_clause
             | accelerator_clause
             | accessibility_clause
             | required_clause
             | criteria_required_clause
             | unknown_clause

// Join support for PBSELECT
join_clause: "JOIN" LPAR join_spec RPAR
where_clause: "WHERE" LPAR where_spec RPAR
join_spec: "LEFT" EQUAL string_value "OP" EQUAL string_value "RIGHT" EQUAL string_value
where_spec: "EXP1" EQUAL string_value "OP" EQUAL string_value "EXP2" EQUAL string_value [("LOGIC" | "LOGC") EQUAL string_value]

// Release Statement
release_statement: "RELEASE" NUMBER ";"

// DataWindow Statement
datawindow_statement: "DATAWINDOW" LPAR datawindow_clauses RPAR

datawindow_clauses: datawindow_clause+

datawindow_clause: units_clause
                 | timer_interval_clause
                 | color_clause
                 | processing_clause
                 | print_clause
                 | selected_clause
                 | unknown_clause

units_clause: "UNITS" EQUAL NUMBER
timer_interval_clause: "TIMER_INTERVAL" EQUAL NUMBER
processing_clause: "PROCESSING" EQUAL NUMBER
selected_clause: "SELECTED" EQUAL "NO"
print_clause: "PRINT" LPAR print_properties RPAR

print_properties: print_property+
print_property: property_assignment

// Table Statement
table_statement: "TABLE" LPAR table_clauses RPAR

table_clauses: table_clause_item+
table_clause_item: column_def | retrieve_def | update_def | unknown_clause

column_def: "COLUMN" EQUAL column_list
retrieve_def: "RETRIEVE" EQUAL quoted_string
update_def: "UPDATE" EQUAL quoted_string

column_list: LPAR column_entry+ RPAR
column_entry: LPAR column_properties RPAR
column_properties: column_property ("," column_property)*
column_property: property_assignment

// Header/Summary/Footer/Detail
header_statement: "HEADER" LPAR band_properties RPAR
summary_statement: "SUMMARY" LPAR band_properties RPAR  
footer_statement: "FOOTER" LPAR band_properties RPAR
detail_statement: "DETAIL" LPAR band_properties RPAR

band_properties: band_property+
band_property: property_assignment | object_definition

object_definition: object_type LPAR object_properties RPAR
object_type: "TEXT" | "COLUMN" | "LINE" | "RECTANGLE" | "BUTTON" | "COMPUTE"
object_properties: object_property+
object_property: property_assignment

// Common Clauses
band_clause: "BAND" EQUAL IDENTIFIER
id_clause: "ID" EQUAL NUMBER
alignment_clause: "ALIGNMENT" EQUAL NUMBER
tabsequence_clause: "TABSEQUENCE" EQUAL NUMBER
border_clause: "BORDER" EQUAL NUMBER
color_clause: "COLOR" EQUAL (NUMBER | quoted_string)
x_clause: "X" EQUAL NUMBER
y_clause: "Y" EQUAL NUMBER
height_clause: "HEIGHT" EQUAL NUMBER
width_clause: "WIDTH" EQUAL NUMBER
format_clause: "FORMAT" EQUAL quoted_string
tag_clause: "TAG" EQUAL quoted_string
edit_clause: "EDIT" LPAR edit_properties RPAR
type_clause: "TYPE" EQUAL IDENTIFIER
initial_clause: "INITIAL" EQUAL quoted_string
validation_clause: "VALIDATION" EQUAL quoted_string
validationmsg_clause: "VALIDATIONMSG" EQUAL quoted_string
criteria_clause: "CRITERIA" LPAR criteria_properties RPAR
translate_clause: "TRANSLATE" EQUAL "YES"
case_clause: "CASE" EQUAL IDENTIFIER
accelerator_clause: "ACCELERATOR" EQUAL quoted_string
accessibility_clause: "ACCESSIBILITY" LPAR accessibility_properties RPAR
required_clause: "REQUIRED" EQUAL "NO"
criteria_required_clause: "CRITERIA.REQUIRED" EQUAL "NO"

edit_properties: edit_property+
edit_property: property_assignment

criteria_properties: criteria_property+
criteria_property: property_assignment

accessibility_properties: accessibility_property+
accessibility_property: property_assignment

font_clause: "FONT.FACE" EQUAL quoted_string
           | "FONT.HEIGHT" EQUAL NUMBER
           | "FONT.WEIGHT" EQUAL NUMBER
           | "FONT.FAMILY" EQUAL NUMBER
           | "FONT.PITCH" EQUAL NUMBER
           | "FONT.CHARSET" EQUAL NUMBER

background_clause: "BACKGROUND.MODE" EQUAL NUMBER
                 | "BACKGROUND.COLOR" EQUAL NUMBER

// General property assignment
property_assignment: property_name EQUAL property_value
                   | property_name LPAR property_params RPAR

property_name: IDENTIFIER ("." IDENTIFIER)*
property_value: NUMBER | quoted_string | IDENTIFIER | "YES" | "NO"
property_params: property_param+
property_param: property_assignment

// Catch-all for unknown clauses
unknown_clause: IDENTIFIER EQUAL /[^()]+/
              | IDENTIFIER LPAR /[^)]+/ RPAR
              | IDENTIFIER LPAR RPAR

// Comments
comment: /\/\/[^\n]*/

// Value types
quoted_string: ESCAPED_STRING
string_value: quoted_string | IDENTIFIER | TILDE_STRING

// PowerBuilder tilde-escaped strings
TILDE_STRING: /~"[^"]*"/

// Import tokens from common
// Define ESCAPED_STRING to handle PowerBuilder escaping
ESCAPED_STRING: /"([^"\\]|\\.)*"/
              | /'([^'\\]|\\.)*'/
              | /~"([^"]|"")*~"/  // PowerBuilder style escaped quotes

// For backward compatibility
%import common.ESCAPED_STRING -> _OLD_ESCAPED_STRING
%import common.NUMBER
%import common.WS

// Tokens
IDENTIFIER: /[a-zA-Z_][a-zA-Z0-9_]*/
LPAR: "("
RPAR: ")"
EQUAL: "="

// Ignore whitespace
%ignore WS