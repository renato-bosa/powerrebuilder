// PowerBuilder Type Extensions Grammar
// Enhances type declarations with enum and structure support

// Type declaration with full support
type_declaration: [GLOBAL] TYPE custom_type [ENUMERATED] [from_clause] [AUTOINSTANTIATE] [within_clause] [descriptor] type_body "end" "type"

// Type body can contain enum values or structure fields
type_body: enum_body | structure_body | mixed_body

// Enumerated type body
enum_body: enum_value_list

enum_value_list: enum_value (COMMA enum_value)*

enum_value: IDENTIFIER [EQUALS (INT | expression)]
          | IDENTIFIER "!" [INT | expression]  // Alternative syntax

// Structure type body  
structure_body: (type_member | field_declaration)*

// Type member (field in structure)
type_member: [visibility_modifier] [CONSTANT] type_name IDENTIFIER [array_bounds] [EQUALS expression] [descriptor]

// Field declaration (alternative syntax)
field_declaration: visibility_modifier COLON _NEWLINE
                  (type_member _NEWLINE)*

// Mixed body (for complex types)
mixed_body: (type_member | enum_value | function_declaration | event_declaration)*

// Visibility modifiers
visibility_modifier: PUBLIC | PRIVATE | PROTECTED | PRIVATEREAD | PRIVATEWRITE | PROTECTEDREAD | PROTECTEDWRITE

// Type name extensions
type_name: basic_type | custom_type | system_type

basic_type: INTEGER | STRING | BOOLEAN | LONG | DECIMAL | REAL | DATE | TIME | DATETIME | CHAR | DOUBLE | UINT | ULONG | BYTE | BLOB

system_type: POWEROBJECT | TRANSACTION | DATAWINDOW | DATASTORE | ANY | STRUCTURE | WINDOW | USEROBJECT

// Custom type reference with namespace
custom_type: IDENTIFIER (DOT IDENTIFIER)*

// Array bounds
array_bounds: LBRACK (INT | IDENTIFIER | expression) (COMMA (INT | IDENTIFIER | expression))* RBRACK
            | LBRACK RBRACK  // Dynamic array

// Common tokens
GLOBAL: /global/i
TYPE: /type/i  
ENUMERATED: /enumerated/i
FROM: /from/i
AUTOINSTANTIATE: /autoinstantiate/i
WITHIN: /within/i
END: /end/i
CONSTANT: /constant/i

// Visibility tokens
PUBLIC: /public/i
PRIVATE: /private/i
PROTECTED: /protected/i
PRIVATEREAD: /privateread/i
PRIVATEWRITE: /privatewrite/i
PROTECTEDREAD: /protectedread/i
PROTECTEDWRITE: /protectedwrite/i

// Type tokens
INTEGER: /integer/i
STRING: /string/i
BOOLEAN: /boolean/i
LONG: /long/i
DECIMAL: /decimal/i
REAL: /real/i
DATE: /date/i
TIME: /time/i
DATETIME: /datetime/i
CHAR: /char/i
DOUBLE: /double/i
UINT: /uint/i
ULONG: /ulong/i
BYTE: /byte/i
BLOB: /blob/i
POWEROBJECT: /powerobject/i
TRANSACTION: /transaction/i
DATAWINDOW: /datawindow/i
DATASTORE: /datastore/i
ANY: /any/i
STRUCTURE: /structure/i
WINDOW: /window/i
USEROBJECT: /userobject/i