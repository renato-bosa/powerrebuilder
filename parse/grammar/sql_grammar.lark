%import .common_grammar -> *

# SQL and Transaction specific tokens
TRANSACTION: "transaction"
COMMIT: "commit"
ROLLBACK: "rollback"
CONNECT: "connect"
DISCONNECT: "disconnect"
SELECT: "select"
INSERT: "insert"
UPDATE: "update"
DELETE: "delete"
PREPARE: "prepare"
EXECUTE: "execute"
FETCH: "fetch"
CLOSE: "close"

# Transaction handling
transaction_block: USING transaction_object code_block
transaction_object: object_access | IDENTIFIER
transaction_stmt: (COMMIT | ROLLBACK | CONNECT | DISCONNECT) [transaction_object] [USING savepoint_name] SEMICOLON
savepoint_name: IDENTIFIER

# SQL statements
sql_statement: sql_query 
            | sql_commit 
            | sql_rollback 
            | sql_connect 
            | sql_disconnect 
            | sql_prepare
            | sql_execute
            | sql_fetch
            | sql_close

# DML statements
sql_query: (SELECT | INSERT | UPDATE | DELETE) sql_expression SEMICOLON
sql_expression: /[^;]+/

# Transaction control
sql_commit: COMMIT [USING transaction_object] SEMICOLON
sql_rollback: ROLLBACK [USING transaction_object] SEMICOLON
sql_connect: CONNECT [TO database_name] [USING connection_info] SEMICOLON
sql_disconnect: DISCONNECT [FROM database_name] SEMICOLON

# Cursor handling
sql_prepare: PREPARE statement_name FROM sql_expression SEMICOLON
sql_execute: EXECUTE statement_name [USING parameter_list] SEMICOLON
sql_fetch: FETCH cursor_name INTO variable_list SEMICOLON
sql_close: CLOSE cursor_name SEMICOLON

# Supporting rules
database_name: IDENTIFIER
statement_name: IDENTIFIER
cursor_name: IDENTIFIER
connection_info: IDENTIFIER | string_value
variable_list: IDENTIFIER (COMMA IDENTIFIER)* 