// PowerBuilder to JavaScript/TypeScript Grammar
// Based on the original PowerBuilder grammar but adapted for JS/TS output

%import common.WS
%import common.ESCAPED_STRING
%import common.SIGNED_NUMBER
%import common.LETTER
%import common.DIGIT

// Anchored keywords (match only whole words)
END_IF: /end\s+if(?!\w)/i
IF: /if(?!\w)/i
THEN: /then(?!\w)/i
ELSE: /else(?!\w)/i
DO: /do(?!\w)/i
WHILE: /while(?!\w)/i
LOOP: /loop(?!\w)/i
FOR: /for(?!\w)/i
TO: /to(?!\w)/i
NEXT: /next(?!\w)/i
LOCAL: /local(?!\w)/i
RETURN: /return(?!\w)/i
RECORD: /record(?!\w)/i
OUTPUT: /output(?!\w)/i
LENGTH: /length(?!\w)/i
ASC: /asc(?!\w)/i
CHR: /chr(?!\w)/i
REPEAT: /repeat(?!\w)/i
UNTIL: /until(?!\w)/i
CASE: /case(?!\w)/i
OF: /of(?!\w)/i
OTHERWISE: /otherwise(?!\w)/i
END_CASE: /end\s+case(?!\w)/i

// Type keywords
INTEGER: /integer(?!\w)/i
STRING: /string(?!\w)/i
BOOLEAN: /boolean(?!\w)/i
DOUBLE: /double(?!\w)/i
DATE: /date(?!\w)/i
DATETIME: /datetime(?!\w)/i
DECIMAL: /decimal(?!\w)/i
ARRAY: /array(?!\w)/i
RECORD_TYPE: /record(?!\w)/i

// Common tokens
// Identifiers must not start with any reserved keyword:
IDENTIFIER: /[A-Za-z_]\w*/
COMMENT: "/*" /(.|\n)*?/ "*/"
LINE_COMMENT: "//" /[^\n]*/

// Operators
PLUS: "+"
MINUS: "-"
MULT: "*"
DIV: "/"
EQUAL: "="
NOT_EQUAL: "<>"
LT: "<"
GT: ">"
LTE: "<="
GTE: ">="
LPAREN: "("
RPAREN: ")"
COMMA: ","
DOT: "."
COLON: ":"

%ignore WS
%ignore COMMENT
%ignore LINE_COMMENT

// Root rules
start: statement*

statement: if_statement
        | while_statement
        | for_statement
        | repeat_statement
        | case_statement
        | function_call_stmt
        | assignment
        | return_statement
        | declare_statement
        | record_declaration
        | output_statement

// Control flow
if_statement: IF condition THEN statement* (ELSE statement*)? END_IF
while_statement: DO WHILE condition statement* LOOP
for_statement: FOR IDENTIFIER EQUAL expression TO expression statement* NEXT
repeat_statement: REPEAT statement* UNTIL condition
case_statement: CASE expression OF case_block* (OTHERWISE statement*)? END_CASE

case_block: expression_list COLON statement*
expression_list: expression (COMMA expression)*

// Expressions
condition: expression comparison_op expression
comparison_op: EQUAL | NOT_EQUAL | LT | GT | LTE | GTE
expression: term ((PLUS|MINUS) term)*
term: factor ((MULT|DIV) factor)*
factor: primary_expression
      | SIGNED_NUMBER
      | ESCAPED_STRING
      | LPAREN expression RPAREN

// Primary expressions
primary_expression: function_call_expr
                 | record_access
                 | variable_ref

// Functions and variables
function_call_stmt: function_call_expr
function_call_expr: (LENGTH | ASC | ASCII | CHR | IDENTIFIER) LPAREN (expression (COMMA expression)*)? RPAREN
variable_ref: IDENTIFIER
assignment: (variable_ref | record_access) EQUAL expression
return_statement: RETURN expression?
declare_statement: LOCAL type_declaration IDENTIFIER (EQUAL expression)?

// Arrays and Records
record_access: IDENTIFIER DOT IDENTIFIER
record_declaration: RECORD IDENTIFIER record_field+ END_IF
record_field: type_declaration IDENTIFIER

// Output statement
output_statement: OUTPUT expression

// Types
type_declaration: INTEGER
                | STRING
                | BOOLEAN
                | DOUBLE
                | DATE
                | DATETIME
                | DECIMAL
                | array_type
                | record_type

array_type: ARRAY LPAREN type_declaration RPAREN
record_type: RECORD_TYPE IDENTIFIER 