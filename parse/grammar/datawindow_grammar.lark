%import .common_grammar -> *

# DataWindow specific tokens
COMPUTE: "compute"
SUMMARY: "summary"
GRAPH: "graph"
CROSSTAB: "crosstab"
TABLE: "table"
COLUMN: "column"
SERIES: "series"
DIMENSION: "dimension"
MEASURE: "measure"

# DataWindow definition
datawindow: TYPE IDENTIFIER FROM "datawindow" LBRACE dw_body RBRACE
dw_body: dw_properties table_def compute_def* display_def* summary_def? graph_def? crosstab_def?

# Properties section
dw_properties: (dw_property)*
dw_property: IDENTIFIER EQUALS value SEMICOLON

# Table definition
table_def: TABLE LPAR table_props RPAR
table_props: (table_prop COMMA)* table_prop
table_prop: IDENTIFIER EQUALS value

# Column definition
column_def: COLUMN LPAR column_props RPAR
column_props: (column_prop COMMA)* column_prop
column_prop: IDENTIFIER EQUALS value

# Compute definition
compute_def: COMPUTE LPAR compute_props RPAR
compute_props: expression (COMMA property)*

# Display objects
display_def: text_def 
          | column_def 
          | compute_def 
          | line_def 
          | rect_def 
          | oval_def 
          | roundrect_def 
          | picture_def

text_def: "text" LPAR text_props RPAR
line_def: "line" LPAR line_props RPAR
rect_def: "rect" LPAR rect_props RPAR
oval_def: "oval" LPAR oval_props RPAR
roundrect_def: "roundrect" LPAR roundrect_props RPAR
picture_def: "picture" LPAR picture_props RPAR

text_props: (text_prop COMMA)* text_prop
line_props: (line_prop COMMA)* line_prop
rect_props: (rect_prop COMMA)* rect_prop
oval_props: (oval_prop COMMA)* oval_prop
roundrect_props: (roundrect_prop COMMA)* roundrect_prop
picture_props: (picture_prop COMMA)* picture_prop

text_prop: IDENTIFIER EQUALS value
line_prop: IDENTIFIER EQUALS value
rect_prop: IDENTIFIER EQUALS value
oval_prop: IDENTIFIER EQUALS value
roundrect_prop: IDENTIFIER EQUALS value
picture_prop: IDENTIFIER EQUALS value

# Summary section
summary_def: SUMMARY LBRACE summary_item* RBRACE
summary_item: function_call

# Graph support
graph_def: GRAPH LBRACE graph_item* RBRACE
graph_item: graph_series | graph_property
graph_series: SERIES LPAR series_props RPAR
series_props: (series_prop COMMA)* series_prop
series_prop: IDENTIFIER EQUALS value
graph_property: IDENTIFIER EQUALS value SEMICOLON

# Crosstab support
crosstab_def: CROSSTAB LBRACE crosstab_item* RBRACE
crosstab_item: crosstab_dimension | crosstab_measure
crosstab_dimension: DIMENSION LPAR dimension_props RPAR
dimension_props: (dimension_prop COMMA)* dimension_prop
dimension_prop: IDENTIFIER EQUALS value
crosstab_measure: MEASURE LPAR measure_props RPAR
measure_props: (measure_prop COMMA)* measure_prop
measure_prop: IDENTIFIER EQUALS value 