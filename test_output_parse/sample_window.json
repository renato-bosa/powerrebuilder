{
  "type": "window",
  "name": "w_main",
  "properties": {
    "width": 1920,
    "height": 1200,
    "title": "Sample Application",
    "center": true,
    "backcolor": 67108864
  },
  "controls": [
    {
      "type": "commandbutton",
      "name": "cb_ok",
      "properties": {
        "x": 320,
        "y": 600,
        "width": 375,
        "height": 100,
        "text": "OK"
      },
      "events": [
        {
          "name": "clicked",
          "code": "string ls_name\nls_name = sle_name.text\nif ls_name = \"\" then\n    MessageBox(\"Error\", \"Please enter a name\")\n    return\nend if\nMessageBox(\"Hello\", \"Hello \" + ls_name + \"!\")\nclose(parent)"
        }
      ]
    },
    {
      "type": "singlelineedit",
      "name": "sle_name",
      "properties": {
        "x": 320,
        "y": 400,
        "width": 800,
        "height": 100,
        "text": "Enter your name"
      }
    }
  ]
}