import 'package:flutter/material.dart';
import 'package:flutter/services.dart';
import 'package:glassmorphism/glassmorphism.dart';
import 'theme/design_system.dart';
{%- if app.has_database %}
import 'core/database_helper.dart';
{%- endif %}
import 'core/global_state.dart';
{%- if app.initial_window %}
import 'screens/{{ app.initial_window | snake_case }}_screen.dart';
{%- endif %}

{%- if app.variables and app.variables|length > 0 %}
// Global variables
{%- for var in app.variables %}
{%- if var.get('is_global', False) %}
late {{ var.get('dart_type', 'dynamic') }} {{ var.name }} = {{ var.get('initial_value', 'null') }};
{%- endif %}
{%- endfor %}
{%- endif %}

void main() async {
  WidgetsFlutterBinding.ensureInitialized();
  
  {%- if app.get('has_database', False) %}
  // Initialize database
  await DatabaseHelper.instance.initDatabase();
  
  {%- endif %}
  {%- for event in app.events %}
  {%- if event.name == 'open' %}
  // Application open event
  await _applicationOpen();
  
  {%- endif %}
  {%- endfor %}
  runApp({{ app.name }}App());
}

class {{ app.name }}App extends StatelessWidget {
  @override
  Widget build(BuildContext context) {
    return MaterialApp(
      title: '{{ app.display_name }}',
      theme: AppDesignSystem.lightTheme,
      darkTheme: AppDesignSystem.darkTheme,
      themeMode: ThemeMode.system,
      {%- if app.initial_window %}
      home: {{ app.initial_window | pascal_case }}Screen(),
      {%- else %}
      home: Scaffold(
        appBar: AppBar(
          title: const Text('{{ app.display_name }}'),
        ),
        body: const Center(
          child: Text('Welcome to {{ app.display_name }}'),
        ),
      ),
      {%- endif %}
      debugShowCheckedModeBanner: false,
      {%- if app.get('micro_help', False) or app.get('toolbar_tips', False) %}
      builder: (context, child) {
        return Overlay(
          initialEntries: [
            OverlayEntry(
              builder: (context) => child!,
            ),
            {%- if app.get('micro_help', False) %}
            // Micro help overlay
            OverlayEntry(
              builder: (context) => const MicroHelpOverlay(),
            ),
            {%- endif %}
          ],
        );
      },
      {%- endif %}
    );
  }
}

{%- if app.has_variables and not all_vars_global %}
{%- set instance_vars = app.variables | selectattr('is_global', 'equalto', false) | list %}
{%- if instance_vars %}

/// Application state management
class {{ app.name }}State extends ChangeNotifier {
  // Instance variables
  {%- for var in instance_vars %}
  {{ var.dart_type }} _{{ var.name }} = {{ var.initial_value | default('null') }};
  {%- endfor %}
  
  // Getters and setters
  {%- for var in instance_vars %}
  {{ var.dart_type }} get {{ var.name }} => _{{ var.name }};
  set {{ var.name }}({{ var.dart_type }} value) {
    _{{ var.name }} = value;
    notifyListeners();
  }
  
  {%- endfor %}
}
{%- endif %}
{%- endif %}

{%- for event in app.events %}

/// Application {{ event.name }} event
{%- if event.name == 'open' %}
Future<void> _applicationOpen() async {
{%- else %}
void _application{{ event.name | capitalize }}({{ event.parameters | join(', ') }}) {
{%- endif %}
  {%- for line in event.body %}
  {{ line }}
  {%- endfor %}
  // TODO: Implement application {{ event.name }} event
}
{%- endfor %}

{%- if app.get('has_database', False) and app.get('database_config') %}

/// Database configuration
class DatabaseConfig {
  static const String dbms = '{{ app.database_config.get('dbms', 'sqlite') }}';
  static const String database = '{{ app.database_config.get('database', 'app.db') }}';
  static const String userId = '{{ app.database_config.get('userid', 'user') }}';
  static const String serverName = '{{ app.database_config.get('server_name', 'localhost') }}';
  
  {%- if app.database_config.get('db_parm') %}
  static const String dbParm = '{{ app.database_config.get('db_parm') }}';
  {%- endif %}
  
  static Future<void> initialize() async {
    // Configure database connection
    await DatabaseHelper.instance.configure(
      dbms: dbms,
      database: database,
      userId: userId,
      serverName: serverName,
    );
  }
}
{%- endif %}

{%- if app.get('micro_help', False) %}

/// Micro help overlay widget
class MicroHelpOverlay extends StatefulWidget {
  const MicroHelpOverlay({Key? key}) : super(key: key);

  @override
  State<MicroHelpOverlay> createState() => _MicroHelpOverlayState();
}

class _MicroHelpOverlayState extends State<MicroHelpOverlay> {
  String _helpText = '';
  
  @override
  Widget build(BuildContext context) {
    if (_helpText.isEmpty) return const SizedBox.shrink();
    
    return Positioned(
      bottom: 0,
      left: 0,
      right: 0,
      child: Container(
        color: Theme.of(context).colorScheme.surface,
        padding: const EdgeInsets.symmetric(horizontal: 16, vertical: 8),
        child: Text(
          _helpText,
          style: Theme.of(context).textTheme.bodySmall,
        ),
      ),
    );
  }
  
  void setHelpText(String text) {
    setState(() {
      _helpText = text;
    });
  }
}
{%- endif %}