      if (!validationResult.isSuccess) {
        return Result.failure(validationResult.error!);
      }
      
      final response = await _apiService.post(
        _endpoint,
        data: row.toJson(),
      );
      
      final result = {{ datawindow.model_name }}.fromJson(response.data);
      return Result.success(result);
    } catch (e) {
      return Result.failure('Failed to insert row: $e');
    }
  }
  
  /// Update an existing row
  Future<Result<{{ datawindow.model_name }}>> updateRow({{ datawindow.model_name }} row) async {
    try {
      // Validate before update
      final validationResult = _validateRow(row, isNew: false);
      if (!validationResult.isSuccess) {
        return Result.failure(validationResult.error!);
      }
      
      final response = await _apiService.put(
        '$_endpoint/${row.{{ datawindow.primary_key }}}',
