  /// Build filter expression from PowerBuilder-style syntax
  Map<String, dynamic> buildFilter(String pbFilter) {
    final filters = <String, dynamic>{};
    
    // Parse PowerBuilder filter syntax
    // Example: "dept_id = 100 AND active = 'Y'"
    final patterns = {
      RegExp(r'(\w+)\s*=\s*(\d+)'): (match) => {
        match.group(1)!: int.parse(match.group(2)!),
      },
      RegExp(r'(\w+)\s*=\s*\'([^\']+)\''): (match) => {
        match.group(1)!: match.group(2)!,
      },
      RegExp(r'(\w+)\s*>\s*(\d+)'): (match) => {
        '${match.group(1)!}_gt': int.parse(match.group(2)!),
      },
      RegExp(r'(\w+)\s*<\s*(\d+)'): (match) => {
        '${match.group(1)!}_lt': int.parse(match.group(2)!),
      },
      RegExp(r'(\w+)\s+LIKE\s+\'([^\']+)\'', caseSensitive: false): (match) => {
        '${match.group(1)!}_like': match.group(2)!,
      },
    };
    
    for (final entry in patterns.entries) {
      final matches = entry.key.allMatches(pbFilter);
      for (final match in matches) {
        filters.addAll(entry.value(match));
      }
    }
    
    return filters;
  }
  
  /// Convert PowerBuilder sort syntax to API format
  String? convertSort(String pbSort) {
    // Parse PowerBuilder sort syntax
    // Example: "dept_name A, emp_id D"
    final sortParts = pbSort.split(',').map((s) => s.trim()).where((s) => s.isNotEmpty);
    final apiSorts = <String>[];
    
    for (final part in sortParts) {
      final match = RegExp(r'^(\w+)(?:\s+([AD]))?$').firstMatch(part);
      if (match != null) {
        final column = match.group(1)!;
        final direction = match.group(2) ?? 'A';
        apiSorts.add(direction == 'D' ? '-$column' : column);
      }
    }
    
    return apiSorts.isEmpty ? null : apiSorts.join(',');
  }
