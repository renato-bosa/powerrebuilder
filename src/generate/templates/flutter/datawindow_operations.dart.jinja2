  /// Retrieve data with optional filtering and sorting
  Future<Result<List<{{ datawindow.model_name }}>>> retrieve({
    Map<String, dynamic>? filters,
    String? sortColumn,
    bool ascending = true,
    int? limit,
    int? offset,
  }) async {
    try {
      final queryParams = <String, dynamic>{};
      
      // Add filters
      if (filters != null) {
        filters.forEach((key, value) {
          if (value != null && value.toString().isNotEmpty) {
            queryParams['filter[$key]'] = value;
          }
        });
      }
      
      // Add sorting
      if (sortColumn != null) {
        queryParams['sort'] = ascending ? sortColumn : '-$sortColumn';
      }
      
      // Add pagination
      if (limit != null) queryParams['limit'] = limit;
      if (offset != null) queryParams['offset'] = offset;
      
      final response = await _apiService.get(
        _endpoint,
        queryParameters: queryParams,
      );
      
      final List<dynamic> data = response.data['data'] ?? [];
      final results = data
          .map((json) => {{ datawindow.model_name }}.fromJson(json))
          .toList();
      
      return Result.success(results);
    } catch (e) {
      return Result.failure('Failed to retrieve data: $e');
    }
  }
  
