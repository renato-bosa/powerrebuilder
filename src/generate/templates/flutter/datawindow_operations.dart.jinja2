  }
  
  /// Batch update multiple rows
  Future<Result<List<{{ datawindow.model_name }}>>> updateRows(List<{{ datawindow.model_name }}> rows) async {
    try {
      // Validate all rows
      for (final row in rows) {
        final validationResult = _validateRow(row, isNew: false);
        if (!validationResult.isSuccess) {
          return Result.failure('Row ${rows.indexOf(row) + 1}: ${validationResult.error}');
