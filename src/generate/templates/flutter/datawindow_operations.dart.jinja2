      // Check if deletion is allowed
      final canDelete = await _canDeleteRow(id);
      if (!canDelete.isSuccess) {
        return Result.failure(canDelete.error!);
      }
      
      await _apiService.delete('$_endpoint/$id');
      return Result.success(null);
    } catch (e) {
      return Result.failure('Failed to delete row: $e');
