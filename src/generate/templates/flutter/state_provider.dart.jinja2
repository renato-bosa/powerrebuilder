import 'package:flutter/foundation.dart';
import 'package:flutter_riverpod/flutter_riverpod.dart';
import '../models/{{ model_name }}.dart';
import '../services/{{ service_name }}_service.dart';
import '../core/result.dart';

/// State for {{ screen_name }}
@immutable
class {{ screen_name|title }}State {
  final bool isLoading;
  final String? error;
  final {{ model_name }}? currentItem;
  final List<{{ model_name }}> items;
  final Map<String, dynamic> filters;
  final String? sortColumn;
  final bool sortAscending;
  final int currentPage;
  final int pageSize;
  final int totalItems;
  final bool hasUnsavedChanges;
  final Set<String> modifiedFields;
  
  const {{ screen_name|title }}State({
    this.isLoading = false,
    this.error,
    this.currentItem,
    this.items = const [],
    this.filters = const {},
    this.sortColumn,
    this.sortAscending = true,
    this.currentPage = 0,
    this.pageSize = 20,
    this.totalItems = 0,
    this.hasUnsavedChanges = false,
    this.modifiedFields = const {},
  });
  
  {{ screen_name|title }}State copyWith({
    bool? isLoading,
    String? error,
    {{ model_name }}? currentItem,
    List<{{ model_name }}>? items,
    Map<String, dynamic>? filters,
    String? sortColumn,
    bool? sortAscending,
    int? currentPage,
    int? pageSize,
    int? totalItems,
    bool? hasUnsavedChanges,
    Set<String>? modifiedFields,
  }) {
    return {{ screen_name|title }}State(
      isLoading: isLoading ?? this.isLoading,
      error: error,
      currentItem: currentItem ?? this.currentItem,
      items: items ?? this.items,
      filters: filters ?? this.filters,
      sortColumn: sortColumn ?? this.sortColumn,
      sortAscending: sortAscending ?? this.sortAscending,
      currentPage: currentPage ?? this.currentPage,
      pageSize: pageSize ?? this.pageSize,
      totalItems: totalItems ?? this.totalItems,
      hasUnsavedChanges: hasUnsavedChanges ?? this.hasUnsavedChanges,
      modifiedFields: modifiedFields ?? this.modifiedFields,
    );
  }
  
  int get totalPages => (totalItems / pageSize).ceil();
  bool get hasNextPage => currentPage < totalPages - 1;
  bool get hasPreviousPage => currentPage > 0;
}

/// State notifier for {{ screen_name }}
class {{ screen_name|title }}Notifier extends StateNotifier<{{ screen_name|title }}State> {
  final {{ service_name|title }}Service _service;
  
  {{ screen_name|title }}Notifier(this._service) : super(const {{ screen_name|title }}State());
  
  /// Load data with current filters and sorting
  Future<void> loadData() async {
    state = state.copyWith(isLoading: true, error: null);
    
    try {
      final result = await _service.retrieve(
        filters: state.filters,
        sortColumn: state.sortColumn,
        ascending: state.sortAscending,
        offset: state.currentPage * state.pageSize,
        limit: state.pageSize,
      );
      
      if (result.isSuccess) {
        state = state.copyWith(
          items: result.data!,
          totalItems: result.totalCount ?? result.data!.length,
          isLoading: false,
        );
      } else {
        state = state.copyWith(
          error: result.error,
          isLoading: false,
        );
      }
    } catch (e) {
      state = state.copyWith(
        error: 'Failed to load data: $e',
        isLoading: false,
      );
    }
  }
  
  /// Set current item for editing
  void setCurrentItem({{ model_name }}? item) {
    state = state.copyWith(
      currentItem: item,
      hasUnsavedChanges: false,
      modifiedFields: {},
    );
  }
  
  /// Update a field value
  void updateField(String fieldName, dynamic value) {
    if (state.currentItem == null) return;
    
    // Create a copy with the updated field
    final updatedItem = state.currentItem!.copyWith(
      {% for field in model_fields %}
      {% if not field.computed %}
      {{ field.name }}: fieldName == '{{ field.name }}' ? value : state.currentItem!.{{ field.name }},
      {% endif %}
      {% endfor %}
    );
    
    // Track modified fields
    final modifiedFields = Set<String>.from(state.modifiedFields)..add(fieldName);
    
    state = state.copyWith(
      currentItem: updatedItem,
      hasUnsavedChanges: true,
      modifiedFields: modifiedFields,
    );
    
    // Handle computed fields
    _updateComputedFields();
  }
  
  /// Save current item
  Future<void> save() async {
    if (state.currentItem == null || !state.hasUnsavedChanges) return;
    
    state = state.copyWith(isLoading: true, error: null);
    
    try {
      final isNew = state.currentItem!.{{ primary_key }} == null;
      final result = isNew
          ? await _service.insert(state.currentItem!)
          : await _service.update(state.currentItem!);
      
      if (result.isSuccess) {
        // Update items list
        final items = List<{{ model_name }}>.from(state.items);
        if (isNew) {
          items.add(result.data!);
        } else {
          final index = items.indexWhere((item) => item.{{ primary_key }} == result.data!.{{ primary_key }});
          if (index >= 0) {
            items[index] = result.data!;
          }
        }
        
        state = state.copyWith(
          currentItem: result.data,
          items: items,
          hasUnsavedChanges: false,
          modifiedFields: {},
          isLoading: false,
        );
      } else {
        state = state.copyWith(
          error: result.error,
          isLoading: false,
        );
      }
    } catch (e) {
      state = state.copyWith(
        error: 'Failed to save: $e',
        isLoading: false,
      );
    }
  }
  
  /// Delete an item
  Future<void> delete({{ primary_key_type }} id) async {
    state = state.copyWith(isLoading: true, error: null);
    
    try {
      final result = await _service.delete(id);
      
      if (result.isSuccess) {
        // Remove from items list
        final items = state.items.where((item) => item.{{ primary_key }} != id).toList();
        
        // Clear current item if it was deleted
        final currentItem = state.currentItem?.{{ primary_key }} == id ? null : state.currentItem;
        
        state = state.copyWith(
          items: items,
          currentItem: currentItem,
          totalItems: state.totalItems - 1,
          isLoading: false,
        );
      } else {
        state = state.copyWith(
          error: result.error,
          isLoading: false,
        );
      }
    } catch (e) {
      state = state.copyWith(
        error: 'Failed to delete: $e',
        isLoading: false,
      );
    }
  }
  
  /// Apply filters
  void applyFilters(Map<String, dynamic> filters) {
    state = state.copyWith(
      filters: filters,
      currentPage: 0, // Reset to first page
    );
    loadData();
  }
  
  /// Clear filters
  void clearFilters() {
    state = state.copyWith(
      filters: {},
      currentPage: 0,
    );
    loadData();
  }
  
  /// Sort by column
  void sortBy(String column) {
    final ascending = state.sortColumn == column ? !state.sortAscending : true;
    state = state.copyWith(
      sortColumn: column,
      sortAscending: ascending,
    );
    loadData();
  }
  
  /// Change page
  void changePage(int page) {
    if (page < 0 || page >= state.totalPages) return;
    
    state = state.copyWith(currentPage: page);
    loadData();
  }
  
  /// Next page
  void nextPage() {
    if (state.hasNextPage) {
      changePage(state.currentPage + 1);
    }
  }
  
  /// Previous page
  void previousPage() {
    if (state.hasPreviousPage) {
      changePage(state.currentPage - 1);
    }
  }
  
  /// Reset state
  void reset() {
    state = const {{ screen_name|title }}State();
  }
  
  /// Update computed fields
  void _updateComputedFields() {
    if (state.currentItem == null) return;
    
    var updatedItem = state.currentItem!;
    
    {% for field in computed_fields %}
    // Update {{ field.name }}
    updatedItem = updatedItem.copyWith(
      {{ field.name }}: {{ field.expression }},
    );
    {% endfor %}
    
    if (updatedItem != state.currentItem) {
      state = state.copyWith(currentItem: updatedItem);
    }
  }
  
  /// Validate current item
  List<String> validate() {
    if (state.currentItem == null) return [];
    
    final errors = <String>[];
    final item = state.currentItem!;
    
    {% for validation in validations %}
    // {{ validation.description }}
    if ({{ validation.condition }}) {
      errors.add('{{ validation.message }}');
    }
    {% endfor %}
    
    return errors;
  }
}

/// Providers
final {{ service_name }}ServiceProvider = Provider<{{ service_name|title }}Service>((ref) {
  // Initialize service with dependencies
  return {{ service_name|title }}Service(
    {% if service_dependencies %}
    {% for dep in service_dependencies %}
    ref.read({{ dep }}),
    {% endfor %}
    {% endif %}
  );
});

final {{ screen_name }}StateProvider = StateNotifierProvider<{{ screen_name|title }}Notifier, {{ screen_name|title }}State>((ref) {
  final service = ref.watch({{ service_name }}ServiceProvider);
  return {{ screen_name|title }}Notifier(service);
});

/// Computed providers
{% for computed in computed_providers %}
final {{ computed.name }}Provider = Provider<{{ computed.type }}>((ref) {
  final state = ref.watch({{ screen_name }}StateProvider);
  {{ computed.body | indent(2) }}
});

{% endfor %}

/// Selector providers for performance
final {{ screen_name }}ItemsProvider = Provider<List<{{ model_name }}>>((ref) {
  return ref.watch({{ screen_name }}StateProvider.select((state) => state.items));
});

final {{ screen_name }}CurrentItemProvider = Provider<{{ model_name }}?>((ref) {
  return ref.watch({{ screen_name }}StateProvider.select((state) => state.currentItem));
});

final {{ screen_name }}LoadingProvider = Provider<bool>((ref) {
  return ref.watch({{ screen_name }}StateProvider.select((state) => state.isLoading));
});

final {{ screen_name }}ErrorProvider = Provider<String?>((ref) {
  return ref.watch({{ screen_name }}StateProvider.select((state) => state.error));
});