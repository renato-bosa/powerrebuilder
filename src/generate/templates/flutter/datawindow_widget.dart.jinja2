      decoration: BoxDecoration(
        color: isDark 
          ? AppDesignSystem.darkSurface.withOpacity(0.8)
          : AppDesignSystem.surfaceColor.withOpacity(0.8),
        border: Border(
          bottom: BorderSide(
            color: isDark
              ? AppDesignSystem.darkBorder
              : AppDesignSystem.borderColor,
            width: 0.5,
          ),
        ),
        boxShadow: [
          BoxShadow(
            color: AppDesignSystem.shadowColor.withOpacity(0.05),
            blurRadius: 4,
            offset: const Offset(0, 2),
          ),
        ],
      ),
      child: Row(
        children: [
          // Action buttons group
          Container(
            decoration: BoxDecoration(
              color: isDark
                ? AppDesignSystem.darkCardBackground
                : AppDesignSystem.cardBackground,
              borderRadius: BorderRadius.circular(8),
              border: Border.all(
                color: isDark
                  ? AppDesignSystem.darkBorder
                  : AppDesignSystem.borderColor,
                width: 0.5,
              ),
            ),
            child: Row(
              children: [
                // Refresh button
                _buildToolbarButton(
                  icon: CupertinoIcons.refresh,
                  onPressed: _retrieve,
                  tooltip: 'Refresh Data',
                  isFirst: true,
                  isLast: widget.onInsert == null && widget.onDelete == null,
                ),
                
                // Add button
                if (widget.onInsert != null) ...[
                  _buildToolbarDivider(),
                  _buildToolbarButton(
                    icon: CupertinoIcons.plus,
                    onPressed: () => _showAddDialog(),
                    tooltip: 'Add New Row',
                    isLast: widget.onDelete == null || _selectedRows.isEmpty,
                  ),
                ],
                
                // Delete button
                if (widget.onDelete != null && _selectedRows.isNotEmpty) ...[
                  _buildToolbarDivider(),
                  _buildToolbarButton(
                    icon: CupertinoIcons.trash,
                    onPressed: () => _confirmDelete(),
                    tooltip: 'Delete Selected',
                    isLast: true,
                    isDestructive: true,
                  ),
                ],
              ],
            ),
          ),
          
          const Spacer(),
          
          // Search field
          if (widget.allowFilter)
            SizedBox(
              width: 280,
              child: Container(
                height: 36,
                decoration: BoxDecoration(
                  color: isDark
                    ? AppDesignSystem.darkTextFieldBackground
                    : AppDesignSystem.textFieldBackground,
                  borderRadius: BorderRadius.circular(8),
                  border: Border.all(
                    color: _searchFocusNode.hasFocus
                      ? AppDesignSystem.primaryColor
                      : isDark
                        ? AppDesignSystem.darkBorder
                        : AppDesignSystem.borderColor,
                    width: _searchFocusNode.hasFocus ? 1 : 0.5,
                  ),
                  boxShadow: _searchFocusNode.hasFocus
                    ? [
                        BoxShadow(
                          color: AppDesignSystem.primaryColor.withOpacity(0.15),
                          blurRadius: 8,
                          spreadRadius: 0,
                        ),
                      ]
                    : null,
                ),
                child: Row(
                  children: [
                    Padding(
                      padding: const EdgeInsets.symmetric(horizontal: 10),
                      child: Icon(
                        CupertinoIcons.search,
                        size: 16,
                        color: isDark
                          ? AppDesignSystem.darkTextSecondary
                          : AppDesignSystem.textSecondary,
                      ),
                    ),
                    Expanded(
                      child: TextField(
                        controller: _searchController,
                        focusNode: _searchFocusNode,
                        style: TextStyle(
                          fontSize: 14,
                          color: isDark
                            ? AppDesignSystem.darkTextPrimary
                            : AppDesignSystem.textPrimary,
                        ),
                        decoration: InputDecoration(
                          hintText: 'Search in all columns...',
                          hintStyle: TextStyle(
                            fontSize: 14,
                            color: isDark
                              ? AppDesignSystem.darkTextTertiary
                              : AppDesignSystem.textTertiary,
                          ),
                          border: InputBorder.none,
                          contentPadding: const EdgeInsets.only(right: 10),
                        ),
                        onChanged: (_) => _applyFilters(),
                      ),
                    ),
                    if (_searchController.text.isNotEmpty)
                      GestureDetector(
                        onTap: () {
                          _searchController.clear();
                          _applyFilters();
                        },
                        child: Container(
                          padding: const EdgeInsets.all(4),
                          margin: const EdgeInsets.only(right: 6),
                          decoration: BoxDecoration(
                            color: isDark
                              ? AppDesignSystem.darkTextTertiary.withOpacity(0.2)
                              : AppDesignSystem.textTertiary.withOpacity(0.2),
                            shape: BoxShape.circle,
                          ),
                          child: Icon(
                            CupertinoIcons.xmark,
                            size: 12,
                            color: isDark
                              ? AppDesignSystem.darkTextSecondary
                              : AppDesignSystem.textSecondary,
                          ),
                        ),
                      ),
                  ],
                ),
              ),
            ),
          
          const SizedBox(width: 12),
          
          // Export button
          if (widget.allowExport)
