import 'package:flutter/material.dart';
import 'package:provider/provider.dart';
import '../models/{{ datawindow.name|lower }}_model.dart';
import '../services/datawindow_service.dart';

class {{ datawindow.name|pascal_case }}DataWindow extends StatefulWidget {
  final String dataSource;
  
  const {{ datawindow.name|pascal_case }}DataWindow({
    Key? key,
    this.dataSource = '{{ data_source }}',
  }) : super(key: key);

  @override
  State<{{ datawindow.name|pascal_case }}DataWindow> createState() => _{{ datawindow.name|pascal_case }}DataWindowState();
}

class _{{ datawindow.name|pascal_case }}DataWindowState extends State<{{ datawindow.name|pascal_case }}DataWindow> {
  final DataWindowService _dataWindowService = DataWindowService();
  List<{{ datawindow.row_type }}> _rows = [];
  bool _isLoading = false;
  String? _error;
  
  @override
  void initState() {
    super.initState();
    _loadData();
  }
  
  Future<void> _loadData() async {
    setState(() {
      _isLoading = true;
      _error = null;
    });
    
    try {
      final data = await _dataWindowService.retrieve(widget.dataSource);
      setState(() {
        _rows = data;
        _isLoading = false;
      });
    } catch (e) {
      setState(() {
        _error = e.toString();
        _isLoading = false;
      });
    }
  }
  
  @override
  Widget build(BuildContext context) {
    if (_isLoading) {
      return const Center(child: CircularProgressIndicator());
    }
    
    if (_error != null) {
      return Center(
        child: Column(
          mainAxisAlignment: MainAxisAlignment.center,
          children: [
            Text('Error: $_error'),
            ElevatedButton(
              onPressed: _loadData,
              child: const Text('Retry'),
            ),
          ],
        ),
      );
    }
    
    {% if datawindow.presentation_style == 'grid' %}
    return SingleChildScrollView(
      scrollDirection: Axis.horizontal,
      child: DataTable(
        columns: [
          {% for column in datawindow.columns %}
          DataColumn(label: Text('{{ column.name|humanize }}')),
          {% endfor %}
        ],
        rows: _rows.map((row) => DataRow(
          cells: [
            {% for column in datawindow.columns %}
            DataCell(Text(row['{{ column.name }}']?.toString() ?? '')),
            {% endfor %}
          ],
        )).toList(),
      ),
    );
    {% elif datawindow.presentation_style == 'freeform' %}
    return ListView.builder(
      itemCount: _rows.length,
      itemBuilder: (context, index) {
        final row = _rows[index];
        return Card(
          margin: const EdgeInsets.all(8.0),
          child: Padding(
            padding: const EdgeInsets.all(16.0),
            child: Column(
              crossAxisAlignment: CrossAxisAlignment.start,
              children: [
                {% for column in datawindow.columns %}
                Row(
                  children: [
                    Text('{{ column.name|humanize }}: ', style: const TextStyle(fontWeight: FontWeight.bold)),
                    Text(row['{{ column.name }}']?.toString() ?? ''),
                  ],
                ),
                const SizedBox(height: 8),
                {% endfor %}
              ],
            ),
          ),
        );
      },
    );
    {% else %}
    // Default list view
    return ListView.builder(
      itemCount: _rows.length,
      itemBuilder: (context, index) {
        final row = _rows[index];
        return ListTile(
          {% if datawindow.columns %}
          title: Text(row['{{ datawindow.columns[0].name }}']?.toString() ?? ''),
          {% if datawindow.columns|length > 1 %}
          subtitle: Text(row['{{ datawindow.columns[1].name }}']?.toString() ?? ''),
          {% endif %}
          {% endif %}
        );
      },
    );
    {% endif %}
  }
}