  String _formatValue(dynamic value, DataWindowColumn column) {
    if (value == null) return '';
    
    {%- if datawindow.format_value %}
    {{ datawindow.format_value | indent(4) }}
    {%- else %}
    // Apply column format if specified
    if (column.format != null) {
      // Implement PowerBuilder format string parsing
      return value.toString();
    }
    
    // Default formatting
    if (value is DateTime) {
      return value.toString().split(' ')[0];
    } else if (value is double) {
      return value.toStringAsFixed(2);
    }
    
    return value.toString();
    {%- endif %}
  }

  {%- if datawindow.presentation_style == 'freeform' %}
  Widget _buildFreeformView() {
    final isDark = Theme.of(context).brightness == Brightness.dark;
    
    return FadeTransition(
      opacity: _fadeAnimation,
      child: SlideTransition(
        position: _slideAnimation,
        child: Column(
          children: [
            if (widget.showToolbar) _buildToolbar(),
            Expanded(
              child: Container(
                padding: widget.padding ?? const EdgeInsets.all(16),
                child: _filteredData.isEmpty
                  ? _buildEmptyState()
                  : ListView.builder(
                      itemCount: _filteredData.length,
                      itemBuilder: (context, index) {
                        final row = _filteredData[index];
                        final isSelected = _selectedRows.contains(index);
                        
                        return AnimatedContainer(
                          duration: const Duration(milliseconds: 200),
                          margin: const EdgeInsets.only(bottom: 12),
                          decoration: BoxDecoration(
                            color: isDark
                              ? AppDesignSystem.darkCardBackground
                              : AppDesignSystem.cardBackground,
                            borderRadius: BorderRadius.circular(12),
                            border: Border.all(
                              color: isSelected
                                ? AppDesignSystem.primaryColor
                                : isDark
                                  ? AppDesignSystem.darkBorder
                                  : AppDesignSystem.borderColor,
                              width: isSelected ? 2 : 0.5,
                            ),
                            boxShadow: [
                              BoxShadow(
                                color: isSelected
                                  ? AppDesignSystem.primaryColor.withOpacity(0.1)
                                  : AppDesignSystem.shadowColor.withOpacity(0.06),
                                blurRadius: isSelected ? 12 : 8,
                                offset: const Offset(0, 4),
                              ),
                            ],
                          ),
                          child: InkWell(
                            onTap: () {
                              setState(() {
                                if (_selectedRows.contains(index)) {
                                  _selectedRows.remove(index);
                                } else {
                                  if (!widget.allowMultiSelect) {
                                    _selectedRows.clear();
                                  }
                                  _selectedRows.add(index);
                                }
                              });
                              if (widget.onRowSelected != null) {
                                widget.onRowSelected!(row);
                              }
                            },
                            borderRadius: BorderRadius.circular(12),
                            child: Padding(
                              padding: const EdgeInsets.all(20),
                              child: Column(
                                crossAxisAlignment: CrossAxisAlignment.start,
                                children: [
                                  // Selection indicator and actions
                                  Row(
                                    children: [
                                      if (widget.allowMultiSelect)
                                        Checkbox(
                                          value: isSelected,
                                          onChanged: (value) {
                                            setState(() {
                                              if (value ?? false) {
                                                _selectedRows.add(index);
                                              } else {
                                                _selectedRows.remove(index);
                                              }
                                            });
                                          },
                                          activeColor: AppDesignSystem.primaryColor,
                                        ),
                                      const Spacer(),
                                      if (widget.onUpdate != null)
                                        IconButton(
                                          icon: Icon(
                                            CupertinoIcons.pencil,
                                            size: 18,
                                            color: isDark
                                              ? AppDesignSystem.darkTextSecondary
                                              : AppDesignSystem.textSecondary,
                                          ),
                                          onPressed: () {
                                            // Show edit form
                                          },
                                        ),
                                      if (widget.onDelete != null)
                                        IconButton(
                                          icon: Icon(
                                            CupertinoIcons.trash,
                                            size: 18,
                                            color: AppDesignSystem.errorColor,
                                          ),
                                          onPressed: () async {
                                            if (widget.onDelete != null) {
                                              await widget.onDelete!(row);
                                              _retrieve();
                                            }
                                          },
                                        ),
                                    ],
                                  ),
                                  // Field data
                                  {%- for field in datawindow.freeform_fields %}
                                  Container(
                                    padding: const EdgeInsets.symmetric(vertical: 8),
                                    decoration: BoxDecoration(
                                      border: Border(
                                        bottom: BorderSide(
                                          color: isDark
                                            ? AppDesignSystem.darkBorder.withOpacity(0.3)
                                            : AppDesignSystem.borderColor.withOpacity(0.3),
                                          width: 0.5,
                                        ),
                                      ),
                                    ),
                                    child: Row(
                                      crossAxisAlignment: CrossAxisAlignment.start,
                                      children: [
                                        SizedBox(
                                          width: {{ field.label_width | default(140) }},
                                          child: Text(
                                            '{{ field.label }}',
                                            style: TextStyle(
                                              fontSize: 13,
                                              fontWeight: FontWeight.w600,
                                              color: isDark
                                                ? AppDesignSystem.darkTextSecondary
                                                : AppDesignSystem.textSecondary,
                                              letterSpacing: 0.5,
                                            ),
                                          ),
                                        ),
                                        Expanded(
                                          child: Text(
                                            _getColumnValue(row, '{{ field.column }}')?.toString() ?? '',
                                            style: TextStyle(
                                              fontSize: 14,
                                              color: isDark
                                                ? AppDesignSystem.darkTextPrimary
                                                : AppDesignSystem.textPrimary,
                                            ),
                                          ),
                                        ),
                                      ],
                                    ),
                                  ),
                                  {%- endfor %}
                                ],
                              ),
                            ),
                          ),
                        );
                      },
                    ),
              ),
            ),
            if (_filteredData.isNotEmpty) _buildPaginationBar(),
          ],
        ),
      ),
    );
  }
  {%- endif %}
}

class DataWindowColumn {
  final String name;
  final String label;
  final String dataType;
  final double? width;
  final TextAlign alignment;
  final String? format;
  final bool editable;
  final List<DropdownValue>? dropdownValues;

  DataWindowColumn({
    required this.name,
    required this.label,
    required this.dataType,
    this.width,
    this.alignment = TextAlign.left,
    this.format,
    this.editable = false,
    this.dropdownValues,
  });
}

class DropdownValue {
  final String display;
  final String data;
  
  DropdownValue(this.display, this.data);
}