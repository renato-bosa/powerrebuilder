  void _confirmDelete() async {
    final isDark = Theme.of(context).brightness == Brightness.dark;
    
    final confirmed = await showDialog<bool>(
      context: context,
      builder: (context) => AlertDialog(
        backgroundColor: isDark
          ? AppDesignSystem.darkCardBackground
          : AppDesignSystem.cardBackground,
        shape: RoundedRectangleBorder(
          borderRadius: BorderRadius.circular(12),
        ),
        title: Text(
          'Delete Selected Rows',
          style: TextStyle(
            color: isDark
              ? AppDesignSystem.darkTextPrimary
              : AppDesignSystem.textPrimary,
          ),
        ),
        content: Text(
          'Are you sure you want to delete ${_selectedRows.length} selected row${_selectedRows.length > 1 ? 's' : ''}?',
          style: TextStyle(
            color: isDark
              ? AppDesignSystem.darkTextSecondary
              : AppDesignSystem.textSecondary,
          ),
        ),
        actions: [
          TextButton(
            onPressed: () => Navigator.pop(context, false),
            child: Text(
              'Cancel',
              style: TextStyle(
                color: isDark
                  ? AppDesignSystem.darkTextSecondary
                  : AppDesignSystem.textSecondary,
              ),
            ),
          ),
          TextButton(
            onPressed: () => Navigator.pop(context, true),
            style: TextButton.styleFrom(
              foregroundColor: AppDesignSystem.errorColor,
            ),
            child: const Text('Delete'),
          ),
        ],
      ),
    );
    
    if (confirmed ?? false) {
      // Delete selected rows
      for (final index in _selectedRows) {
        if (widget.onDelete != null) {
          await widget.onDelete!(_filteredData[index]);
        }
      }
      _selectedRows.clear();
      _retrieve();
    }
  }
  
