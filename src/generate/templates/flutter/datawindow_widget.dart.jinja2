/// DataWindow widget converted from PowerBuilder: {{ datawindow.name }}
/// Original type: {{ datawindow.presentation_style | default("grid") }}
class {{ datawindow.name }}DataWindow extends StatefulWidget {
  // Data source
  final Future<List<{{ datawindow.row_type }}>> Function()? retrieveData;
  final List<{{ datawindow.row_type }}>? initialData;
  
  // CRUD callbacks
  final Future<void> Function({{ datawindow.row_type }})? onInsert;
  final Future<void> Function({{ datawindow.row_type }})? onUpdate;
  final Future<void> Function({{ datawindow.row_type }})? onDelete;
  
  // Selection
  final void Function({{ datawindow.row_type }})? onRowSelected;
  final bool allowMultiSelect;
  
  // Display options
  final bool showToolbar;
  final bool allowSort;
  final bool allowFilter;
  final bool allowExport;
  final EdgeInsets? padding;

  const {{ datawindow.name }}DataWindow({
    Key? key,
    this.retrieveData,
    this.initialData,
    this.onInsert,
    this.onUpdate,
    this.onDelete,
    this.onRowSelected,
    this.allowMultiSelect = false,
    this.showToolbar = true,
    this.allowSort = true,
    this.allowFilter = false,
    this.allowExport = false,
    this.padding,
  }) : super(key: key);

  @override
  State<{{ datawindow.name }}DataWindow> createState() => _{{ datawindow.name }}DataWindowState();
}

class _{{ datawindow.name }}DataWindowState extends State<{{ datawindow.name }}DataWindow> with TickerProviderStateMixin {
  // Data management
  List<{{ datawindow.row_type }}> _data = [];
  List<{{ datawindow.row_type }}> _filteredData = [];
  bool _isLoading = false;
  String? _error;
  
  // Selection
  final Set<int> _selectedRows = {};
  int? _hoveredRow;
  
  // Sorting
  int? _sortColumnIndex;
  bool _sortAscending = true;
  
  // Filtering
  final Map<String, String> _filters = {};
  final TextEditingController _searchController = TextEditingController();
  final FocusNode _searchFocusNode = FocusNode();
  
  // Pagination
  int _currentPage = 0;
  int _rowsPerPage = 10;
  final List<int> _availableRowsPerPage = [10, 25, 50, 100];
  
  // Animation controllers
  late AnimationController _fadeController;
  late AnimationController _slideController;
  late Animation<double> _fadeAnimation;
  late Animation<Offset> _slideAnimation;
  
  // Column definitions from PowerBuilder
  final List<DataWindowColumn> _columns = [
    {%- for column in datawindow.columns %}
    DataWindowColumn(
      name: '{{ column.name }}',
      label: '{{ column.label }}',
      dataType: '{{ column.data_type }}',
      width: {{ column.width | default("null") }},
      alignment: {{ column.alignment | default("TextAlign.left") }},
      format: {{ column.format | default("null") }},
      editable: {{ column.editable | default("false") }},
      {%- if column.values %}
      dropdownValues: [
        {%- for value in column.values %}
        DropdownValue('{{ value.display }}', '{{ value.data }}'),
        {%- endfor %}
      ],
      {%- endif %}
    ),
    {%- endfor %}
  ];

  @override
  void initState() {
    super.initState();
    
    // Initialize animations
    _fadeController = AnimationController(
      duration: const Duration(milliseconds: 300),
      vsync: this,
    );
    _slideController = AnimationController(
      duration: const Duration(milliseconds: 400),
      vsync: this,
    );
    
    _fadeAnimation = CurvedAnimation(
      parent: _fadeController,
      curve: Curves.easeInOut,
    );
    _slideAnimation = Tween<Offset>(
      begin: const Offset(0, 0.1),
      end: Offset.zero,
    ).animate(CurvedAnimation(
      parent: _slideController,
      curve: AppDesignSystem.animationCurve,
    ));
    
    if (widget.initialData != null) {
      _data = List.from(widget.initialData!);
      _filteredData = List.from(_data);
      _fadeController.forward();
      _slideController.forward();
    } else {
      _retrieve();
    }
  }

  @override
  void dispose() {
    _searchController.dispose();
    _searchFocusNode.dispose();
    _fadeController.dispose();
    _slideController.dispose();
    super.dispose();
  }

  Future<void> _retrieve() async {
    if (widget.retrieveData == null) return;
    
    setState(() {
      _isLoading = true;
      _error = null;
    });
    
    try {
      final data = await widget.retrieveData!();
      setState(() {
        _data = data;
        _filteredData = data;
        _isLoading = false;
      });
      _fadeController.forward();
      _slideController.forward();
    } catch (e) {
      setState(() {
        _error = e.toString();
        _isLoading = false;
      });
    }
  }

  void _applyFilters() {
    setState(() {
      _filteredData = _data.where((row) {
        // Apply search filter
        if (_searchController.text.isNotEmpty) {
          final searchLower = _searchController.text.toLowerCase();
          bool matchesSearch = false;
          for (final column in _columns) {
            final value = _getColumnValue(row, column.name)?.toString().toLowerCase() ?? '';
            if (value.contains(searchLower)) {
              matchesSearch = true;
              break;
            }
          }
          if (!matchesSearch) return false;
        }
        
        // Apply column filters
        for (final entry in _filters.entries) {
          final columnValue = _getColumnValue(row, entry.key)?.toString() ?? '';
          if (!columnValue.toLowerCase().contains(entry.value.toLowerCase())) {
            return false;
          }
        }
        
        return true;
      }).toList();
    });
  }

  dynamic _getColumnValue({{ datawindow.row_type }} row, String columnName) {
    {%- if datawindow.get_column_value %}
    {{ datawindow.get_column_value | indent(4) }}
    {%- else %}
    // Default implementation - customize based on your data model
    switch (columnName) {
      {%- for column in datawindow.columns %}
      case '{{ column.name }}':
        return row.{{ column.property | default(column.name) }};
      {%- endfor %}
      default:
        return null;
    }
    {%- endif %}
  }

  void _setColumnValue({{ datawindow.row_type }} row, String columnName, dynamic value) {
    {%- if datawindow.set_column_value %}
    {{ datawindow.set_column_value | indent(4) }}
    {%- else %}
    // Default implementation - customize based on your data model
    switch (columnName) {
      {%- for column in datawindow.columns %}
      {%- if column.editable %}
      case '{{ column.name }}':
        row.{{ column.property | default(column.name) }} = value;
        break;
      {%- endif %}
      {%- endfor %}
    }
    {%- endif %}
  }

  void _sort(int columnIndex, bool ascending) {
    final column = _columns[columnIndex];
    setState(() {
      _sortColumnIndex = columnIndex;
      _sortAscending = ascending;
      _filteredData.sort((a, b) {
        final aValue = _getColumnValue(a, column.name);
        final bValue = _getColumnValue(b, column.name);
        
        int compare;
        if (aValue == null) {
          compare = 1;
        } else if (bValue == null) {
          compare = -1;
        } else if (aValue is num && bValue is num) {
          compare = aValue.compareTo(bValue);
        } else {
          compare = aValue.toString().compareTo(bValue.toString());
        }
        
        return ascending ? compare : -compare;
      });
    });
  }

