  }
  
  Widget _buildToolbarButton({
    required IconData icon,
    required VoidCallback onPressed,
    required String tooltip,
    bool isFirst = false,
    bool isLast = false,
    bool isDestructive = false,
    bool standalone = false,
  }) {
    final isDark = Theme.of(context).brightness == Brightness.dark;
    
    return Tooltip(
      message: tooltip,
      child: InkWell(
        onTap: onPressed,
        borderRadius: BorderRadius.horizontal(
          left: Radius.circular(standalone || isFirst ? 7 : 0),
          right: Radius.circular(standalone || isLast ? 7 : 0),
        ),
        child: Container(
          padding: const EdgeInsets.symmetric(horizontal: 12, vertical: 8),
          decoration: standalone
            ? BoxDecoration(
                color: isDark
                  ? AppDesignSystem.darkCardBackground
                  : AppDesignSystem.cardBackground,
                borderRadius: BorderRadius.circular(8),
                border: Border.all(
                  color: isDark
                    ? AppDesignSystem.darkBorder
                    : AppDesignSystem.borderColor,
                  width: 0.5,
                ),
              )
            : null,
          child: Icon(
            icon,
            size: 18,
            color: isDestructive
              ? AppDesignSystem.errorColor
              : isDark
                ? AppDesignSystem.darkTextPrimary
                : AppDesignSystem.textPrimary,
          ),
        ),
      ),
    );
  }
  
  Widget _buildToolbarDivider() {
    final isDark = Theme.of(context).brightness == Brightness.dark;
    return Container(
      width: 1,
      height: 20,
      color: isDark
        ? AppDesignSystem.darkBorder
        : AppDesignSystem.borderColor,
    );
  }

  @override
  Widget build(BuildContext context) {
    final isDark = Theme.of(context).brightness == Brightness.dark;
    
    if (_isLoading) {
      return Center(
        child: Column(
          mainAxisAlignment: MainAxisAlignment.center,
          children: [
            CupertinoActivityIndicator(
              radius: 20,
              color: AppDesignSystem.primaryColor,
            ),
            const SizedBox(height: 16),
            Text(
              'Loading data...',
              style: TextStyle(
                color: isDark
                  ? AppDesignSystem.darkTextSecondary
                  : AppDesignSystem.textSecondary,
              ),
            ),
          ],
        ),
      );
    }
    
    if (_error != null) {
      return Center(
        child: Container(
          padding: const EdgeInsets.all(24),
          constraints: const BoxConstraints(maxWidth: 400),
          child: Column(
            mainAxisAlignment: MainAxisAlignment.center,
            children: [
              Icon(
                CupertinoIcons.exclamationmark_triangle,
                size: 48,
                color: AppDesignSystem.errorColor,
              ),
              const SizedBox(height: 16),
              Text(
                'Unable to load data',
                style: TextStyle(
                  fontSize: 18,
                  fontWeight: FontWeight.w600,
                  color: isDark
                    ? AppDesignSystem.darkTextPrimary
                    : AppDesignSystem.textPrimary,
                ),
              ),
              const SizedBox(height: 8),
              Text(
                _error!,
                style: TextStyle(
                  fontSize: 14,
                  color: isDark
                    ? AppDesignSystem.darkTextSecondary
                    : AppDesignSystem.textSecondary,
                ),
                textAlign: TextAlign.center,
              ),
              const SizedBox(height: 24),
              ElevatedButton(
                onPressed: _retrieve,
                style: ElevatedButton.styleFrom(
                  backgroundColor: AppDesignSystem.primaryColor,
                  foregroundColor: Colors.white,
                  padding: const EdgeInsets.symmetric(horizontal: 24, vertical: 12),
                  shape: RoundedRectangleBorder(
                    borderRadius: BorderRadius.circular(8),
                  ),
                ),
                child: const Text('Try Again'),
              ),
            ],
          ),
        ),
      );
    }

    {%- if datawindow.presentation_style == 'freeform' %}
    // Freeform presentation style
    return _buildFreeformView();
    {%- elif datawindow.presentation_style == 'crosstab' %}
    // Crosstab presentation style
    return _buildCrosstabView();
    {%- else %}
    // Grid presentation style (default)
    return FadeTransition(
      opacity: _fadeAnimation,
      child: SlideTransition(
        position: _slideAnimation,
        child: Column(
          children: [
            if (widget.showToolbar) _buildToolbar(),
            Expanded(
              child: _buildDataGrid(),
            ),
            if (_filteredData.isNotEmpty) _buildPaginationBar(),
          ],
        ),
      ),
    );
    {%- endif %}
  }
  
  Widget _buildDataGrid() {
    final isDark = Theme.of(context).brightness == Brightness.dark;
    final startIndex = _currentPage * _rowsPerPage;
    final endIndex = (startIndex + _rowsPerPage).clamp(0, _filteredData.length);
    final pageData = _filteredData.sublist(startIndex, endIndex);
    
    return Container(
      margin: const EdgeInsets.all(16),
      decoration: BoxDecoration(
        color: isDark
          ? AppDesignSystem.darkCardBackground
          : AppDesignSystem.cardBackground,
        borderRadius: BorderRadius.circular(12),
        border: Border.all(
          color: isDark
            ? AppDesignSystem.darkBorder
            : AppDesignSystem.borderColor,
          width: 0.5,
        ),
        boxShadow: [
          BoxShadow(
            color: AppDesignSystem.shadowColor.withOpacity(0.08),
            blurRadius: 12,
            offset: const Offset(0, 4),
          ),
        ],
      ),
      child: ClipRRect(
        borderRadius: BorderRadius.circular(12),
        child: Column(
          children: [
            // Header
            _buildTableHeader(),
            // Body
            Expanded(
              child: _filteredData.isEmpty
                ? _buildEmptyState()
                : ListView.builder(
                    itemCount: pageData.length,
                    itemBuilder: (context, index) {
                      final globalIndex = startIndex + index;
                      final row = pageData[index];
                      return _buildDataRow(globalIndex, row);
                    },
                  ),
            ),
          ],
        ),
      ),
    );
  }
  
  Widget _buildTableHeader() {
    final isDark = Theme.of(context).brightness == Brightness.dark;
    
    return Container(
      decoration: BoxDecoration(
        color: isDark
          ? AppDesignSystem.darkSurface.withOpacity(0.5)
          : AppDesignSystem.surfaceColor.withOpacity(0.5),
        border: Border(
          bottom: BorderSide(
            color: isDark
              ? AppDesignSystem.darkBorder
              : AppDesignSystem.borderColor,
            width: 0.5,
          ),
        ),
      ),
      child: Row(
        children: [
          if (widget.allowMultiSelect)
            SizedBox(
              width: 48,
              child: Checkbox(
                value: _selectedRows.length == _filteredData.length && _filteredData.isNotEmpty,
                onChanged: (value) {
                  setState(() {
                    if (value ?? false) {
                      _selectedRows.addAll(List.generate(_filteredData.length, (i) => i));
                    } else {
                      _selectedRows.clear();
                    }
                  });
                },
                activeColor: AppDesignSystem.primaryColor,
              ),
            ),
          ..._columns.asMap().entries.map((entry) {
            final index = entry.key;
            final column = entry.value;
            return Expanded(
              flex: column.width?.toInt() ?? 100,
              child: InkWell(
                onTap: widget.allowSort
                  ? () => _sort(index, _sortColumnIndex == index ? !_sortAscending : true)
                  : null,
                child: Container(
                  padding: const EdgeInsets.symmetric(horizontal: 16, vertical: 12),
                  child: Row(
                    children: [
                      Text(
                        column.label,
                        style: TextStyle(
                          fontSize: 13,
                          fontWeight: FontWeight.w600,
                          color: isDark
                            ? AppDesignSystem.darkTextPrimary
                            : AppDesignSystem.textPrimary,
                          letterSpacing: 0.5,
                        ),
                      ),
                      if (widget.allowSort) ...[
                        const SizedBox(width: 4),
                        Icon(
                          _sortColumnIndex == index
                            ? (_sortAscending ? CupertinoIcons.chevron_up : CupertinoIcons.chevron_down)
                            : CupertinoIcons.chevron_up_chevron_down,
                          size: 12,
                          color: _sortColumnIndex == index
                            ? AppDesignSystem.primaryColor
                            : isDark
                              ? AppDesignSystem.darkTextTertiary
                              : AppDesignSystem.textTertiary,
                        ),
                      ],
                    ],
                  ),
                ),
              ),
            );
          }).toList(),
        ],
      ),
    );
  }
  
  Widget _buildDataRow(int index, {{ datawindow.row_type }} row) {
    final isDark = Theme.of(context).brightness == Brightness.dark;
    final isSelected = _selectedRows.contains(index);
    final isHovered = _hoveredRow == index;
    
    return MouseRegion(
      onEnter: (_) => setState(() => _hoveredRow = index),
      onExit: (_) => setState(() => _hoveredRow = null),
      child: AnimatedContainer(
        duration: const Duration(milliseconds: 150),
        decoration: BoxDecoration(
          color: isSelected
            ? AppDesignSystem.primaryColor.withOpacity(0.08)
            : isHovered
              ? (isDark
                  ? AppDesignSystem.darkSurface.withOpacity(0.3)
                  : AppDesignSystem.surfaceColor.withOpacity(0.5))
              : Colors.transparent,
          border: Border(
            bottom: BorderSide(
              color: isDark
                ? AppDesignSystem.darkBorder.withOpacity(0.5)
                : AppDesignSystem.borderColor.withOpacity(0.5),
              width: 0.5,
            ),
          ),
        ),
        child: InkWell(
          onTap: widget.onRowSelected != null
            ? () => widget.onRowSelected!(row)
            : null,
          child: Row(
            children: [
              if (widget.allowMultiSelect)
                SizedBox(
                  width: 48,
                  child: Checkbox(
                    value: isSelected,
                    onChanged: (value) {
                      setState(() {
                        if (value ?? false) {
                          if (!widget.allowMultiSelect) {
                            _selectedRows.clear();
                          }
                          _selectedRows.add(index);
                        } else {
                          _selectedRows.remove(index);
                        }
                      });
                    },
                    activeColor: AppDesignSystem.primaryColor,
                  ),
                ),
              ..._columns.map((column) {
                final value = _getColumnValue(row, column.name);
                return Expanded(
                  flex: column.width?.toInt() ?? 100,
                  child: Container(
                    padding: const EdgeInsets.symmetric(horizontal: 16, vertical: 12),
                    child: column.editable
                      ? _buildEditableCell(row, column, value)
                      : Text(
                          _formatValue(value, column),
                          style: TextStyle(
                            fontSize: 14,
                            color: isDark
                              ? AppDesignSystem.darkTextPrimary
                              : AppDesignSystem.textPrimary,
                          ),
                          textAlign: column.alignment,
                        ),
                  ),
                );
              }).toList(),
            ],
          ),
        ),
      ),
    );
  }
  
  Widget _buildEmptyState() {
    final isDark = Theme.of(context).brightness == Brightness.dark;
    
    return Center(
      child: Container(
        padding: const EdgeInsets.all(48),
        child: Column(
          mainAxisAlignment: MainAxisAlignment.center,
          children: [
            Icon(
              CupertinoIcons.doc_text_search,
              size: 64,
              color: isDark
                ? AppDesignSystem.darkTextTertiary
                : AppDesignSystem.textTertiary,
            ),
            const SizedBox(height: 16),
            Text(
              'No data found',
              style: TextStyle(
                fontSize: 18,
                fontWeight: FontWeight.w600,
                color: isDark
                  ? AppDesignSystem.darkTextPrimary
                  : AppDesignSystem.textPrimary,
              ),
            ),
            const SizedBox(height: 8),
            Text(
              _searchController.text.isNotEmpty
                ? 'Try adjusting your search criteria'
                : 'No data available to display',
              style: TextStyle(
                fontSize: 14,
                color: isDark
                  ? AppDesignSystem.darkTextSecondary
                  : AppDesignSystem.textSecondary,
              ),
            ),
          ],
        ),
      ),
    );
  }
  
  Widget _buildPaginationBar() {
    final isDark = Theme.of(context).brightness == Brightness.dark;
    final totalPages = (_filteredData.length / _rowsPerPage).ceil();
    final startRow = _currentPage * _rowsPerPage + 1;
    final endRow = ((_currentPage + 1) * _rowsPerPage).clamp(0, _filteredData.length);
    
    return Container(
      height: 56,
      padding: const EdgeInsets.symmetric(horizontal: 16),
      decoration: BoxDecoration(
        color: isDark
          ? AppDesignSystem.darkSurface.withOpacity(0.8)
          : AppDesignSystem.surfaceColor.withOpacity(0.8),
        border: Border(
          top: BorderSide(
            color: isDark
              ? AppDesignSystem.darkBorder
              : AppDesignSystem.borderColor,
            width: 0.5,
          ),
        ),
      ),
      child: Row(
        children: [
          Text(
            'Showing $startRow-$endRow of ${_filteredData.length}',
            style: TextStyle(
              fontSize: 13,
              color: isDark
                ? AppDesignSystem.darkTextSecondary
                : AppDesignSystem.textSecondary,
            ),
          ),
          const SizedBox(width: 24),
          Text(
            'Rows per page:',
            style: TextStyle(
              fontSize: 13,
              color: isDark
                ? AppDesignSystem.darkTextSecondary
                : AppDesignSystem.textSecondary,
            ),
          ),
          const SizedBox(width: 8),
          DropdownButton<int>(
            value: _rowsPerPage,
            items: _availableRowsPerPage.map((value) {
              return DropdownMenuItem(
                value: value,
                child: Text(value.toString()),
              );
            }).toList(),
            onChanged: (value) {
              setState(() {
                _rowsPerPage = value!;
                _currentPage = 0;
              });
            },
            underline: const SizedBox(),
            style: TextStyle(
              fontSize: 13,
              color: isDark
                ? AppDesignSystem.darkTextPrimary
                : AppDesignSystem.textPrimary,
            ),
          ),
          const Spacer(),
          IconButton(
            icon: Icon(
              CupertinoIcons.chevron_left,
              size: 18,
              color: _currentPage > 0
                ? (isDark
                    ? AppDesignSystem.darkTextPrimary
                    : AppDesignSystem.textPrimary)
                : (isDark
                    ? AppDesignSystem.darkTextTertiary
                    : AppDesignSystem.textTertiary),
            ),
            onPressed: _currentPage > 0
              ? () => setState(() => _currentPage--)
              : null,
          ),
          Container(
            padding: const EdgeInsets.symmetric(horizontal: 12),
            child: Text(
              'Page ${_currentPage + 1} of $totalPages',
              style: TextStyle(
                fontSize: 13,
                color: isDark
                  ? AppDesignSystem.darkTextPrimary
                  : AppDesignSystem.textPrimary,
              ),
            ),
          ),
          IconButton(
            icon: Icon(
              CupertinoIcons.chevron_right,
              size: 18,
              color: _currentPage < totalPages - 1
                ? (isDark
                    ? AppDesignSystem.darkTextPrimary
                    : AppDesignSystem.textPrimary)
                : (isDark
                    ? AppDesignSystem.darkTextTertiary
                    : AppDesignSystem.textTertiary),
            ),
            onPressed: _currentPage < totalPages - 1
              ? () => setState(() => _currentPage++)
              : null,
          ),
        ],
      ),
    );
  }

  Widget _buildEditableCell({{ datawindow.row_type }} row, DataWindowColumn column, dynamic value) {
    final isDark = Theme.of(context).brightness == Brightness.dark;
    
    if (column.dropdownValues != null) {
      return Container(
        padding: const EdgeInsets.symmetric(horizontal: 8, vertical: 4),
        decoration: BoxDecoration(
          color: isDark
            ? AppDesignSystem.darkTextFieldBackground
            : AppDesignSystem.textFieldBackground,
          borderRadius: BorderRadius.circular(6),
          border: Border.all(
            color: isDark
              ? AppDesignSystem.darkBorder
              : AppDesignSystem.borderColor,
            width: 0.5,
          ),
        ),
        child: DropdownButton<String>(
          value: value?.toString(),
          isExpanded: true,
          underline: const SizedBox(),
          style: TextStyle(
            fontSize: 14,
            color: isDark
              ? AppDesignSystem.darkTextPrimary
              : AppDesignSystem.textPrimary,
          ),
          items: column.dropdownValues!.map((item) {
            return DropdownMenuItem(
              value: item.data,
              child: Text(item.display),
            );
          }).toList(),
          onChanged: (newValue) async {
            _setColumnValue(row, column.name, newValue);
            if (widget.onUpdate != null) {
              await widget.onUpdate!(row);
            }
            setState(() {});
          },
        ),
      );
    } else {
      return InkWell(
        onTap: () => _showEditDialog(row, column, value),
        borderRadius: BorderRadius.circular(6),
        child: Container(
          padding: const EdgeInsets.symmetric(horizontal: 8, vertical: 4),
          decoration: BoxDecoration(
            color: isDark
              ? AppDesignSystem.darkTextFieldBackground.withOpacity(0.5)
              : AppDesignSystem.textFieldBackground.withOpacity(0.5),
            borderRadius: BorderRadius.circular(6),
            border: Border.all(
              color: isDark
                ? AppDesignSystem.darkBorder.withOpacity(0.5)
                : AppDesignSystem.borderColor.withOpacity(0.5),
              width: 0.5,
            ),
          ),
          child: Row(
            children: [
              Expanded(
                child: Text(
                  _formatValue(value, column),
                  style: TextStyle(
                    fontSize: 14,
                    color: isDark
                      ? AppDesignSystem.darkTextPrimary
                      : AppDesignSystem.textPrimary,
                  ),
                ),
              ),
              Icon(
                CupertinoIcons.pencil,
                size: 14,
                color: isDark
                  ? AppDesignSystem.darkTextSecondary
                  : AppDesignSystem.textSecondary,
              ),
            ],
          ),
        ),
      );
    }
  }
  
  Future<void> _showEditDialog({{ datawindow.row_type }} row, DataWindowColumn column, dynamic value) async {
    final isDark = Theme.of(context).brightness == Brightness.dark;
    final controller = TextEditingController(text: value?.toString() ?? '');
    
    final result = await showDialog<String>(
      context: context,
      builder: (context) => AlertDialog(
        backgroundColor: isDark
          ? AppDesignSystem.darkCardBackground
          : AppDesignSystem.cardBackground,
        shape: RoundedRectangleBorder(
          borderRadius: BorderRadius.circular(12),
        ),
        title: Text(
          'Edit ${column.label}',
          style: TextStyle(
            color: isDark
              ? AppDesignSystem.darkTextPrimary
              : AppDesignSystem.textPrimary,
          ),
        ),
        content: TextField(
          controller: controller,
          autofocus: true,
          style: TextStyle(
            color: isDark
              ? AppDesignSystem.darkTextPrimary
              : AppDesignSystem.textPrimary,
          ),
          decoration: InputDecoration(
            filled: true,
            fillColor: isDark
              ? AppDesignSystem.darkTextFieldBackground
              : AppDesignSystem.textFieldBackground,
            border: OutlineInputBorder(
              borderRadius: BorderRadius.circular(8),
              borderSide: BorderSide(
                color: isDark
                  ? AppDesignSystem.darkBorder
                  : AppDesignSystem.borderColor,
              ),
            ),
            focusedBorder: OutlineInputBorder(
              borderRadius: BorderRadius.circular(8),
              borderSide: BorderSide(
                color: AppDesignSystem.primaryColor,
                width: 2,
              ),
            ),
          ),
        ),
        actions: [
          TextButton(
            onPressed: () => Navigator.pop(context),
            child: Text(
              'Cancel',
              style: TextStyle(
                color: isDark
                  ? AppDesignSystem.darkTextSecondary
                  : AppDesignSystem.textSecondary,
              ),
            ),
          ),
          TextButton(
            onPressed: () => Navigator.pop(context, controller.text),
            style: TextButton.styleFrom(
              foregroundColor: AppDesignSystem.primaryColor,
            ),
            child: const Text('Save'),
          ),
        ],
      ),
    );
    
    if (result != null) {
      _setColumnValue(row, column.name, result);
      if (widget.onUpdate != null) {
        await widget.onUpdate!(row);
      }
      setState(() {});
    }
  }
  
