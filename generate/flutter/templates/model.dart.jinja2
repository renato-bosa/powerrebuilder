import 'package:freezed_annotation/freezed_annotation.dart';
{%- for import_stmt in model.imports %}
{{ import_stmt }}
{%- endfor %}

part '{{ model.filename }}.freezed.dart';
part '{{ model.filename }}.g.dart';

/// {{ model.description | default("Data model for " + model.name) }}
@freezed
class {{ model.name }} with _${{ model.name }} {
  const factory {{ model.name }}({
    {%- for field in model.fields %}
    {%- if field.required %}@required {% endif %}{{ field.type }}{% if field.nullable %}?{% endif %} {{ field.name }},
    {%- endfor %}
  }) = _{{ model.name }};

  {%- if model.has_custom_methods %}
  const {{ model.name }}._();
  
  {%- for method in model.custom_methods %}
  {{ method.return_type }} {{ method.name }}({{ method.params }}) {
    {{ method.body | indent(4) }}
  }
  {%- endfor %}
  {%- endif %}

  factory {{ model.name }}.fromJson(Map<String, dynamic> json) => 
    _${{ model.name }}FromJson(json);

  {%- if model.from_domain %}
  /// Create from domain model
  factory {{ model.name }}.fromDomain({{ model.domain_type }} domain) {
    return {{ model.name }}(
      {%- for field in model.fields %}
      {{ field.name }}: {{ field.from_domain | default("domain." + field.name) }},
      {%- endfor %}
    );
  }
  {%- endif %}

  {%- if model.to_domain %}
  /// Convert to domain model
  {{ model.domain_type }} toDomain() {
    return {{ model.domain_type }}(
      {%- for field in model.fields %}
      {{ field.name }}: {{ field.to_domain | default(field.name) }},
      {%- endfor %}
    );
  }
  {%- endif %}

  {%- if model.default_values %}
  /// Create with default values
  factory {{ model.name }}.withDefaults() {
    return {{ model.name }}(
      {%- for field in model.fields %}
      {%- if field.default %}
      {{ field.name }}: {{ field.default }},
      {%- endif %}
      {%- endfor %}
    );
  }
  {%- endif %}
}

{%- if model.enums %}
// Enums used by this model
{%- for enum in model.enums %}
enum {{ enum.name }} {
  {%- for value in enum.values %}
  @JsonValue('{{ value.json_value | default(value.name) }}')
  {{ value.name }}{% if not loop.last %},{% endif %}
  {%- endfor %}
}

extension {{ enum.name }}Extension on {{ enum.name }} {
  String get displayName {
    switch (this) {
      {%- for value in enum.values %}
      case {{ enum.name }}.{{ value.name }}:
        return '{{ value.display | default(value.name) }}';
      {%- endfor %}
    }
  }
}
{%- endfor %}
{%- endif %}

{%- if model.validators %}
// Validators
class {{ model.name }}Validator {
  {%- for validator in model.validators %}
  static String? validate{{ validator.field | capitalize }}({{ validator.type }}? value) {
    {{ validator.body | indent(4) }}
  }
  {%- endfor %}
  
  static Map<String, String?> validateAll({{ model.name }} model) {
    return {
      {%- for validator in model.validators %}
      '{{ validator.field }}': validate{{ validator.field | capitalize }}(model.{{ validator.field }}),
      {%- endfor %}
    };
  }
  
  static bool isValid({{ model.name }} model) {
    final errors = validateAll(model);
    return errors.values.every((error) => error == null);
  }
}
{%- endif %}