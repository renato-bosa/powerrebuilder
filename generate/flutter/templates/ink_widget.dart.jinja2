                separatorBuilder: (_, __) => const SizedBox(width: AppDesignSystem.space3),
                itemBuilder: (context, index) {
                  final width = _availableStrokeWidths[index];
                  final isSelected = _currentStrokeWidth == width;
                  
                  return GestureDetector(
