class _{{ name }}State extends State<{{ name }}> with SingleTickerProviderStateMixin {
  final List<InkStroke> _strokes = [];
  final List<InkStroke> _undoStack = [];
  late Color _currentColor;
  late double _currentStrokeWidth;
  late DrawingMode _drawingMode;
  InkStroke? _currentStroke;
  
  late AnimationController _animationController;
  late Animation<double> _fadeAnimation;
  
  // Available colors for quick selection
  final List<Color> _availableColors = [
    Colors.black,
    Colors.red,
    Colors.blue,
    Colors.green,
    Colors.orange,
    Colors.purple,
    Colors.brown,
    Colors.pink,
  ];
  
  // Available stroke widths
  final List<double> _availableStrokeWidths = [1.0, 3.0, 5.0, 8.0, 12.0];
  
  @override
  void initState() {
    super.initState();
    _currentColor = widget.initialColor;
    _currentStrokeWidth = widget.initialStrokeWidth;
    _drawingMode = widget.initialMode;
    
    _animationController = AnimationController(
      duration: const Duration(milliseconds: 150),
      vsync: this,
    );
    _fadeAnimation = CurvedAnimation(
      parent: _animationController,
      curve: Curves.easeIn,
    );
    {%- if init_code %}
    // Custom initialization
    {{ init_code | indent(4) }}
    {%- endif %}
  }
  
  @override
  void dispose() {
    _animationController.dispose();
    {%- if dispose_code %}
    // Custom disposal
    {{ dispose_code | indent(4) }}
    {%- endif %}
    super.dispose();
  }
  
  void _onPanStart(DragStartDetails details) {
    if (!widget.allowDrawing) return;
    
    final renderBox = context.findRenderObject() as RenderBox;
    final localPosition = renderBox.globalToLocal(details.globalPosition);
    
    setState(() {
      _currentStroke = InkStroke(
        points: [localPosition],
        color: _drawingMode == DrawingMode.erase ? Colors.transparent : _currentColor,
        strokeWidth: _drawingMode == DrawingMode.erase ? _currentStrokeWidth * 3 : _currentStrokeWidth,
        mode: _drawingMode,
      );
    });
    
    _animationController.forward();
  }
  
  void _onPanUpdate(DragUpdateDetails details) {
    if (!widget.allowDrawing || _currentStroke == null) return;
    
    final renderBox = context.findRenderObject() as RenderBox;
    final localPosition = renderBox.globalToLocal(details.globalPosition);
    
    setState(() {
      _currentStroke!.points.add(localPosition);
    });
  }
  
  void _onPanEnd(DragEndDetails details) {
    if (!widget.allowDrawing || _currentStroke == null) return;
    
    setState(() {
      if (widget.smoothStrokes) {
        _currentStroke!.smooth();
      }
      
      if (_drawingMode == DrawingMode.erase) {
        // Remove strokes that intersect with eraser path
        _strokes.removeWhere((stroke) => stroke.intersectsWith(_currentStroke!));
      } else {
        // Check max strokes limit
        if (widget.maxStrokes != null && _strokes.length >= widget.maxStrokes!) {
          _strokes.removeAt(0);
        }
        _strokes.add(_currentStroke!);
        widget.onStrokeAdded?.call(_currentStroke!);
      }
      
      _currentStroke = null;
      _undoStack.clear(); // Clear redo stack on new stroke
    });
    
    widget.onStrokesChanged?.call(_strokes);
    _animationController.reverse();
  }
  
  void _undo() {
    if (_strokes.isNotEmpty) {
      setState(() {
        final stroke = _strokes.removeLast();
        _undoStack.add(stroke);
      });
      widget.onStrokesChanged?.call(_strokes);
    }
  }
  
  void _redo() {
    if (_undoStack.isNotEmpty) {
      setState(() {
        final stroke = _undoStack.removeLast();
        _strokes.add(stroke);
      });
      widget.onStrokesChanged?.call(_strokes);
    }
  }
  
  void _clear() {
    setState(() {
      _strokes.clear();
      _undoStack.clear();
      _currentStroke = null;
    });
    widget.onClear?.call();
    widget.onStrokesChanged?.call(_strokes);
  }
  
  @override
  Widget build(BuildContext context) {
    final theme = Theme.of(context);
    final isDark = theme.brightness == Brightness.dark;
    
    return Container(
      height: widget.height,
      width: widget.width,
      padding: widget.padding ?? const EdgeInsets.all(AppDesignSystem.space4),
      decoration: AppDesignSystem.containerDecoration(
        color: isDark ? AppDesignSystem.darkSurfaceColor : AppDesignSystem.surfaceColor,
        radius: AppDesignSystem.radiusLg,
      ),
      child: Column(
        children: [
          if (widget.showToolbar) ...[
            _buildToolbar(isDark),
            const SizedBox(height: AppDesignSystem.space3),
          ],
          Expanded(
            child: ClipRRect(
              borderRadius: BorderRadius.circular(AppDesignSystem.radiusMd),
              child: Container(
                decoration: BoxDecoration(
                  color: widget.backgroundColor ?? 
                      (isDark ? AppDesignSystem.darkBackgroundSecondary : Colors.white),
                  border: Border.all(
                    color: isDark ? AppDesignSystem.darkBorderColor : AppDesignSystem.borderColor,
                    width: 1,
                  ),
                ),
                child: GestureDetector(
                  onPanStart: _onPanStart,
                  onPanUpdate: _onPanUpdate,
                  onPanEnd: _onPanEnd,
                  child: CustomPaint(
                    painter: InkPainter(
                      strokes: _strokes,
                      currentStroke: _currentStroke,
                      backgroundImage: widget.backgroundImage,
                    ),
                    child: Container(),
                  ),
                ),
              ),
            ),
          ),
        ],
      ),
    );
  }
  
  Widget _buildToolbar(bool isDark) {
    return Column(
      children: [
        // Drawing mode and actions
        Row(
          mainAxisAlignment: MainAxisAlignment.spaceBetween,
          children: [
            // Mode selection
            Container(
