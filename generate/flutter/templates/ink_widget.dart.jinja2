                    ),
                ],
              ),
            ),
            
            // Actions
            Row(
              children: [
                IconButton(
                  icon: Icon(
                    CupertinoIcons.arrow_uturn_left,
                    color: _strokes.isNotEmpty
                        ? (isDark ? AppDesignSystem.darkTextPrimary : AppDesignSystem.textPrimary)
                        : (isDark ? AppDesignSystem.darkTextSecondary : AppDesignSystem.textSecondary),
                  ),
                  onPressed: _strokes.isNotEmpty ? _undo : null,
                ),
                IconButton(
                  icon: Icon(
                    CupertinoIcons.arrow_uturn_right,
                    color: _undoStack.isNotEmpty
                        ? (isDark ? AppDesignSystem.darkTextPrimary : AppDesignSystem.textPrimary)
                        : (isDark ? AppDesignSystem.darkTextSecondary : AppDesignSystem.textSecondary),
                  ),
                  onPressed: _undoStack.isNotEmpty ? _redo : null,
                ),
                IconButton(
                  icon: Icon(
                    CupertinoIcons.trash,
                    color: AppDesignSystem.errorColor,
                  ),
