{% extends "widget.dart.jinja2" %}

{% block imports %}
import 'package:flutter/material.dart';
import 'dart:math' as math;
import '../core/app_design_system.dart';
{% endblock %}

{% block additional_classes %}
enum DrawingType {
  line,
  rectangle,
  roundedRectangle,
  oval,
  arc,
  polygon,
  freehand,
  text,
}

enum FillPattern {
  solid,
  transparent,
  horizontal,
  vertical,
  cross,
  diagonal,
  diagonalCross,
  dots,
}

class DrawObjectPainter extends CustomPainter {
  final DrawingType drawingType;
  final Color strokeColor;
  final Color fillColor;
  final double strokeWidth;
  final FillPattern fillPattern;
  final List<Offset> points;
  final double cornerRadius;
  final String? text;
  final TextStyle? textStyle;
  final double startAngle;
  final double sweepAngle;
  final bool antiAlias;
  
  DrawObjectPainter({
    required this.drawingType,
    required this.strokeColor,
    required this.fillColor,
    required this.strokeWidth,
    required this.fillPattern,
    required this.points,
    this.cornerRadius = 0,
    this.text,
    this.textStyle,
    this.startAngle = 0,
    this.sweepAngle = math.pi * 2,
    this.antiAlias = true,
  });
  
  @override
  void paint(Canvas canvas, Size size) {
    final strokePaint = Paint()
      ..color = strokeColor
      ..strokeWidth = strokeWidth
      ..style = PaintingStyle.stroke
      ..isAntiAlias = antiAlias;
    
    final fillPaint = Paint()
      ..color = fillColor
      ..style = PaintingStyle.fill
      ..isAntiAlias = antiAlias;
    
    // Apply fill pattern
    if (fillPattern != FillPattern.solid && fillPattern != FillPattern.transparent) {
      fillPaint.shader = _createPatternShader(size);
    }
    
    switch (drawingType) {
      case DrawingType.line:
        if (points.length >= 2) {
          canvas.drawLine(points[0], points[1], strokePaint);
        }
        break;
        
      case DrawingType.rectangle:
        final rect = Rect.fromLTWH(0, 0, size.width, size.height);
        if (fillPattern != FillPattern.transparent) {
          canvas.drawRect(rect, fillPaint);
        }
        canvas.drawRect(rect, strokePaint);
        break;
        
      case DrawingType.roundedRectangle:
        final rrect = RRect.fromRectAndRadius(
          Rect.fromLTWH(0, 0, size.width, size.height),
          Radius.circular(cornerRadius),
        );
        if (fillPattern != FillPattern.transparent) {
          canvas.drawRRect(rrect, fillPaint);
        }
        canvas.drawRRect(rrect, strokePaint);
        break;
        
      case DrawingType.oval:
        final rect = Rect.fromLTWH(0, 0, size.width, size.height);
        if (fillPattern != FillPattern.transparent) {
          canvas.drawOval(rect, fillPaint);
        }
        canvas.drawOval(rect, strokePaint);
        break;
        
      case DrawingType.arc:
        final rect = Rect.fromLTWH(0, 0, size.width, size.height);
        if (fillPattern != FillPattern.transparent) {
          final path = Path()
            ..moveTo(rect.center.dx, rect.center.dy)
            ..arcTo(rect, startAngle, sweepAngle, false)
            ..close();
          canvas.drawPath(path, fillPaint);
        }
        canvas.drawArc(rect, startAngle, sweepAngle, false, strokePaint);
        break;
        
      case DrawingType.polygon:
        if (points.length >= 3) {
          final path = Path()..moveTo(points[0].dx, points[0].dy);
          for (int i = 1; i < points.length; i++) {
            path.lineTo(points[i].dx, points[i].dy);
          }
          path.close();
          
          if (fillPattern != FillPattern.transparent) {
            canvas.drawPath(path, fillPaint);
          }
          canvas.drawPath(path, strokePaint);
        }
        break;
        
      case DrawingType.freehand:
        if (points.length >= 2) {
          final path = Path()..moveTo(points[0].dx, points[0].dy);
          for (int i = 1; i < points.length; i++) {
            path.lineTo(points[i].dx, points[i].dy);
          }
          canvas.drawPath(path, strokePaint);
        }
        break;
        
      case DrawingType.text:
        if (text != null) {
          final textPainter = TextPainter(
            text: TextSpan(
              text: text,
              style: textStyle ?? TextStyle(color: strokeColor),
            ),
            textDirection: TextDirection.ltr,
          );
          textPainter.layout(
            minWidth: 0,
            maxWidth: size.width,
          );
          textPainter.paint(canvas, Offset.zero);
        }
        break;
    }
  }
  
  Shader? _createPatternShader(Size size) {
    switch (fillPattern) {
      case FillPattern.horizontal:
        return LinearGradient(
          colors: [fillColor, fillColor.withOpacity(0), fillColor],
          stops: const [0.4, 0.5, 0.6],
          transform: const GradientRotation(0),
        ).createShader(Rect.fromLTWH(0, 0, size.width, 10));
        
      case FillPattern.vertical:
        return LinearGradient(
          colors: [fillColor, fillColor.withOpacity(0), fillColor],
          stops: const [0.4, 0.5, 0.6],
          transform: const GradientRotation(math.pi / 2),
        ).createShader(Rect.fromLTWH(0, 0, 10, size.height));
        
      case FillPattern.diagonal:
        return LinearGradient(
          colors: [fillColor, fillColor.withOpacity(0)],
          transform: const GradientRotation(math.pi / 4),
        ).createShader(Rect.fromLTWH(0, 0, size.width, size.height));
        
      default:
        return null;
    }
  }
  
  @override
  bool shouldRepaint(covariant DrawObjectPainter oldDelegate) {
    return drawingType != oldDelegate.drawingType ||
        strokeColor != oldDelegate.strokeColor ||
        fillColor != oldDelegate.fillColor ||
        strokeWidth != oldDelegate.strokeWidth ||
        fillPattern != oldDelegate.fillPattern ||
        points != oldDelegate.points ||
        cornerRadius != oldDelegate.cornerRadius ||
        text != oldDelegate.text ||
        startAngle != oldDelegate.startAngle ||
        sweepAngle != oldDelegate.sweepAngle;
  }
}
{% endblock %}

{% block build_method %}
  @override
  Widget build(BuildContext context) {
    final theme = Theme.of(context);
    final design = AppDesignSystem.of(context);
    final isDark = theme.brightness == Brightness.dark;
    
    return SizedBox(
      width: widget.width ?? 200,
      height: widget.height ?? 200,
      child: CustomPaint(
        painter: DrawObjectPainter(
          drawingType: widget.drawingType,
          strokeColor: widget.strokeColor ?? (isDark ? design.borderDark : design.borderLight),
          fillColor: widget.fillColor ?? Colors.transparent,
          strokeWidth: widget.strokeWidth ?? 1.0,
          fillPattern: widget.fillPattern ?? FillPattern.solid,
          points: widget.points ?? [],
          cornerRadius: widget.cornerRadius ?? 0,
          text: widget.text,
          textStyle: widget.textStyle,
          startAngle: widget.startAngle ?? 0,
          sweepAngle: widget.sweepAngle ?? (math.pi * 2),
          antiAlias: widget.antiAlias ?? true,
        ),
        child: widget.child,
      ),
    );
  }
{% endblock %}

{% block widget_class %}
class {{ widget_name }} extends StatelessWidget {
  final DrawingType drawingType;
  final Color? strokeColor;
  final Color? fillColor;
  final double? strokeWidth;
  final FillPattern? fillPattern;
  final List<Offset>? points;
  final double? cornerRadius;
  final String? text;
  final TextStyle? textStyle;
  final double? startAngle;
  final double? sweepAngle;
  final bool? antiAlias;
  final double? width;
  final double? height;
  final Widget? child;
  
  const {{ widget_name }}({
    super.key,
    required this.drawingType,
    this.strokeColor,
    this.fillColor,
    this.strokeWidth,
    this.fillPattern,
    this.points,
    this.cornerRadius,
    this.text,
    this.textStyle,
    this.startAngle,
    this.sweepAngle,
    this.antiAlias,
    this.width,
    this.height,
    this.child,
  });
  
  @override
  Widget build(BuildContext context) {
    return _DrawObjectWidget(
      drawingType: drawingType,
      strokeColor: strokeColor,
      fillColor: fillColor,
      strokeWidth: strokeWidth,
      fillPattern: fillPattern,
      points: points,
      cornerRadius: cornerRadius,
      text: text,
      textStyle: textStyle,
      startAngle: startAngle,
      sweepAngle: sweepAngle,
      antiAlias: antiAlias,
      width: width,
      height: height,
      child: child,
    );
  }
}

class _DrawObjectWidget extends StatelessWidget {
  final DrawingType drawingType;
  final Color? strokeColor;
  final Color? fillColor;
  final double? strokeWidth;
  final FillPattern? fillPattern;
  final List<Offset>? points;
  final double? cornerRadius;
  final String? text;
  final TextStyle? textStyle;
  final double? startAngle;
  final double? sweepAngle;
  final bool? antiAlias;
  final double? width;
  final double? height;
  final Widget? child;
  
  const _DrawObjectWidget({
    required this.drawingType,
    this.strokeColor,
    this.fillColor,
    this.strokeWidth,
    this.fillPattern,
    this.points,
    this.cornerRadius,
    this.text,
    this.textStyle,
    this.startAngle,
    this.sweepAngle,
    this.antiAlias,
    this.width,
    this.height,
    this.child,
  });
  
  {% block build_method %}{% endblock %}
}
{% endblock %}