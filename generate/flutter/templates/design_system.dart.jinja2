/// Design System for {{ app_name|default('App') }}
/// Modern, minimal, macOS-inspired design system
class AppDesignSystem {
  // Private constructor to prevent instantiation
  AppDesignSystem._();

  // ===== Color Palette =====
  static const Color primaryColor = Color(0xFF007AFF); // macOS blue
  static const Color secondaryColor = Color(0xFF5AC8FA); // light blue
  static const Color accentColor = Color(0xFF32D74B); // success green
  static const Color errorColor = Color(0xFFFF3B30); // system red
  static const Color warningColor = Color(0xFFFF9500); // system orange
  
  // Neutral colors
  static const Color backgroundPrimary = Color(0xFFFAFAFA); // light gray background
  static const Color backgroundSecondary = Color(0xFFFFFFFF); // pure white
  static const Color backgroundTertiary = Color(0xFFF2F2F7); // system gray6
  
  static const Color surfaceColor = Color(0xFFFFFFFF);
  static const Color surfaceHover = Color(0xFFF5F5F7);
  static const Color surfacePressed = Color(0xFFE5E5EA);
  
  static const Color textPrimary = Color(0xFF000000);
  static const Color textSecondary = Color(0xFF3C3C43);
  static const Color textTertiary = Color(0xFF8E8E93);
  static const Color textQuaternary = Color(0xFFC7C7CC);
  
  static const Color borderColor = Color(0xFFD1D1D6);
  static const Color borderSubtle = Color(0xFFE5E5EA);
  static const Color dividerColor = Color(0xFFC6C6C8);
  
  // Dark mode colors
  static const Color darkBackgroundPrimary = Color(0xFF000000);
  static const Color darkBackgroundSecondary = Color(0xFF1C1C1E);
  static const Color darkBackgroundTertiary = Color(0xFF2C2C2E);
  static const Color darkSurfaceColor = Color(0xFF1C1C1E);
  static const Color darkTextPrimary = Color(0xFFFFFFFF);
  static const Color darkTextSecondary = Color(0xFFEBEBF5);
  static const Color darkBorderColor = Color(0xFF38383A);

  // ===== Typography =====
  static const String fontFamily = '.SF Pro Display';
  static const String monoFontFamily = 'SF Mono';
  
  static const TextStyle displayLarge = TextStyle(
    fontSize: 34,
    fontWeight: FontWeight.w700,
    letterSpacing: -0.5,
    height: 1.2,
  );
  
  static const TextStyle displayMedium = TextStyle(
    fontSize: 28,
    fontWeight: FontWeight.w600,
    letterSpacing: -0.4,
    height: 1.25,
  );
  
  static const TextStyle displaySmall = TextStyle(
    fontSize: 22,
    fontWeight: FontWeight.w600,
    letterSpacing: -0.3,
    height: 1.3,
  );
  
  static const TextStyle headlineLarge = TextStyle(
    fontSize: 20,
    fontWeight: FontWeight.w600,
    letterSpacing: -0.2,
    height: 1.35,
  );
  
  static const TextStyle headlineMedium = TextStyle(
    fontSize: 17,
    fontWeight: FontWeight.w600,
    letterSpacing: -0.1,
    height: 1.4,
  );
  
  static const TextStyle headlineSmall = TextStyle(
    fontSize: 15,
    fontWeight: FontWeight.w600,
    height: 1.4,
  );
  
  static const TextStyle bodyLarge = TextStyle(
    fontSize: 17,
    fontWeight: FontWeight.w400,
    letterSpacing: -0.1,
    height: 1.5,
  );
  
  static const TextStyle bodyMedium = TextStyle(
    fontSize: 15,
    fontWeight: FontWeight.w400,
    height: 1.5,
  );
  
  static const TextStyle bodySmall = TextStyle(
    fontSize: 13,
    fontWeight: FontWeight.w400,
    height: 1.5,
  );
  
  static const TextStyle labelLarge = TextStyle(
    fontSize: 15,
    fontWeight: FontWeight.w500,
    height: 1.4,
  );
  
  static const TextStyle labelMedium = TextStyle(
    fontSize: 13,
    fontWeight: FontWeight.w500,
    height: 1.4,
  );
  
  static const TextStyle labelSmall = TextStyle(
    fontSize: 11,
    fontWeight: FontWeight.w500,
    letterSpacing: 0.1,
    height: 1.4,
  );
  
  static const TextStyle caption = TextStyle(
    fontSize: 12,
    fontWeight: FontWeight.w400,
    letterSpacing: 0.1,
    height: 1.4,
  );

  // ===== Spacing =====
  static const double space0 = 0;
  static const double space1 = 4;
  static const double space2 = 8;
  static const double space3 = 12;
  static const double space4 = 16;
  static const double space5 = 20;
  static const double space6 = 24;
  static const double space7 = 28;
  static const double space8 = 32;
  static const double space9 = 36;
  static const double space10 = 40;
  static const double space12 = 48;
  static const double space16 = 64;
  static const double space20 = 80;
  static const double space24 = 96;

  // ===== Border Radius =====
  static const double radiusNone = 0;
  static const double radiusXs = 4;
  static const double radiusSm = 6;
  static const double radiusMd = 8;
  static const double radiusLg = 10;
  static const double radiusXl = 12;
  static const double radius2xl = 16;
  static const double radius3xl = 20;
  static const double radiusFull = 9999;

  // ===== Shadows =====
  static final List<BoxShadow> shadowNone = [];
  
  static final List<BoxShadow> shadowSm = [
    BoxShadow(
      color: Colors.black.withOpacity(0.05),
      blurRadius: 4,
      offset: const Offset(0, 2),
    ),
  ];
  
  static final List<BoxShadow> shadowMd = [
    BoxShadow(
      color: Colors.black.withOpacity(0.08),
      blurRadius: 8,
      offset: const Offset(0, 4),
    ),
  ];
  
  static final List<BoxShadow> shadowLg = [
    BoxShadow(
      color: Colors.black.withOpacity(0.1),
      blurRadius: 16,
      offset: const Offset(0, 8),
    ),
  ];
  
  static final List<BoxShadow> shadowXl = [
    BoxShadow(
      color: Colors.black.withOpacity(0.12),
      blurRadius: 24,
      offset: const Offset(0, 12),
    ),
  ];

  // ===== Animation =====
  static const Duration durationInstant = Duration(milliseconds: 50);
  static const Duration durationFast = Duration(milliseconds: 150);
  static const Duration durationNormal = Duration(milliseconds: 250);
  static const Duration durationSlow = Duration(milliseconds: 350);
  static const Duration durationSlowest = Duration(milliseconds: 500);
  
  static const Curve curveEaseInOut = Curves.easeInOut;
  static const Curve curveEaseOut = Curves.easeOut;
  static const Curve curveEaseIn = Curves.easeIn;
  static const Curve curveBounce = Curves.elasticOut;

  // ===== Component Styles =====
  
  // Button styles
  static ButtonStyle primaryButtonStyle(BuildContext context) {
    final isDark = Theme.of(context).brightness == Brightness.dark;
    return ButtonStyle(
      backgroundColor: MaterialStateProperty.resolveWith((states) {
        if (states.contains(MaterialState.pressed)) {
          return primaryColor.withOpacity(0.8);
        }
        if (states.contains(MaterialState.hovered)) {
          return primaryColor.withOpacity(0.9);
        }
        if (states.contains(MaterialState.disabled)) {
          return isDark ? darkBorderColor : borderSubtle;
        }
        return primaryColor;
      }),
      foregroundColor: MaterialStateProperty.resolveWith((states) {
        if (states.contains(MaterialState.disabled)) {
          return isDark ? darkTextSecondary.withOpacity(0.5) : textTertiary;
        }
        return Colors.white;
      }),
      elevation: MaterialStateProperty.all(0),
      padding: MaterialStateProperty.all(
        const EdgeInsets.symmetric(horizontal: space4, vertical: space3),
      ),
      shape: MaterialStateProperty.all(
        RoundedRectangleBorder(
          borderRadius: BorderRadius.circular(radiusMd),
        ),
      ),
      textStyle: MaterialStateProperty.all(labelLarge),
    );
  }

  static ButtonStyle secondaryButtonStyle(BuildContext context) {
    final isDark = Theme.of(context).brightness == Brightness.dark;
    return ButtonStyle(
      backgroundColor: MaterialStateProperty.resolveWith((states) {
        if (states.contains(MaterialState.pressed)) {
          return isDark ? darkBackgroundTertiary : surfacePressed;
        }
        if (states.contains(MaterialState.hovered)) {
          return isDark ? darkBackgroundSecondary : surfaceHover;
        }
        return Colors.transparent;
      }),
      foregroundColor: MaterialStateProperty.resolveWith((states) {
        if (states.contains(MaterialState.disabled)) {
          return isDark ? darkTextSecondary.withOpacity(0.5) : textTertiary;
        }
        return primaryColor;
      }),
      elevation: MaterialStateProperty.all(0),
      side: MaterialStateProperty.resolveWith((states) {
        final color = states.contains(MaterialState.disabled)
            ? (isDark ? darkBorderColor : borderSubtle)
            : (isDark ? darkBorderColor : borderColor);
        return BorderSide(color: color, width: 1);
      }),
      padding: MaterialStateProperty.all(
        const EdgeInsets.symmetric(horizontal: space4, vertical: space3),
      ),
      shape: MaterialStateProperty.all(
        RoundedRectangleBorder(
          borderRadius: BorderRadius.circular(radiusMd),
        ),
      ),
      textStyle: MaterialStateProperty.all(labelLarge),
    );
  }

  static ButtonStyle textButtonStyle(BuildContext context) {
    return ButtonStyle(
      backgroundColor: MaterialStateProperty.resolveWith((states) {
        if (states.contains(MaterialState.pressed)) {
          return primaryColor.withOpacity(0.1);
        }
        if (states.contains(MaterialState.hovered)) {
          return primaryColor.withOpacity(0.05);
        }
        return Colors.transparent;
      }),
      foregroundColor: MaterialStateProperty.resolveWith((states) {
        if (states.contains(MaterialState.disabled)) {
          return textTertiary;
        }
        return primaryColor;
      }),
      elevation: MaterialStateProperty.all(0),
      padding: MaterialStateProperty.all(
        const EdgeInsets.symmetric(horizontal: space3, vertical: space2),
      ),
      shape: MaterialStateProperty.all(
        RoundedRectangleBorder(
          borderRadius: BorderRadius.circular(radiusMd),
        ),
      ),
      textStyle: MaterialStateProperty.all(labelLarge),
    );
  }

  // Input decoration
  static InputDecoration inputDecoration({
    String? labelText,
    String? hintText,
    Widget? prefixIcon,
    Widget? suffixIcon,
    bool isDense = false,
    String? errorText,
  }) {
    return InputDecoration(
      labelText: labelText,
      hintText: hintText,
      prefixIcon: prefixIcon,
      suffixIcon: suffixIcon,
      isDense: isDense,
      errorText: errorText,
      filled: true,
      fillColor: backgroundSecondary,
      contentPadding: EdgeInsets.symmetric(
        horizontal: space3,
        vertical: isDense ? space2 : space3,
      ),
      border: OutlineInputBorder(
        borderRadius: BorderRadius.circular(radiusMd),
        borderSide: const BorderSide(color: borderColor),
      ),
      enabledBorder: OutlineInputBorder(
        borderRadius: BorderRadius.circular(radiusMd),
        borderSide: const BorderSide(color: borderColor),
      ),
      focusedBorder: OutlineInputBorder(
        borderRadius: BorderRadius.circular(radiusMd),
        borderSide: const BorderSide(color: primaryColor, width: 2),
      ),
      errorBorder: OutlineInputBorder(
        borderRadius: BorderRadius.circular(radiusMd),
        borderSide: const BorderSide(color: errorColor),
      ),
      focusedErrorBorder: OutlineInputBorder(
        borderRadius: BorderRadius.circular(radiusMd),
        borderSide: const BorderSide(color: errorColor, width: 2),
      ),
      disabledBorder: OutlineInputBorder(
        borderRadius: BorderRadius.circular(radiusMd),
        borderSide: const BorderSide(color: borderSubtle),
      ),
      labelStyle: bodyMedium.copyWith(color: textSecondary),
      hintStyle: bodyMedium.copyWith(color: textTertiary),
      errorStyle: caption.copyWith(color: errorColor),
    );
  }

  // Card decoration
  static BoxDecoration cardDecoration({
    Color? color,
    List<BoxShadow>? shadows,
    double? radius,
  }) {
    return BoxDecoration(
      color: color ?? surfaceColor,
      borderRadius: BorderRadius.circular(radius ?? radiusLg),
      boxShadow: shadows ?? shadowSm,
      border: Border.all(
        color: borderSubtle,
        width: 1,
      ),
    );
  }

  // Container decoration
  static BoxDecoration containerDecoration({
    Color? color,
    double? radius,
    bool hasBorder = false,
  }) {
    return BoxDecoration(
      color: color ?? backgroundTertiary,
      borderRadius: BorderRadius.circular(radius ?? radiusMd),
      border: hasBorder
          ? Border.all(
              color: borderColor,
              width: 1,
            )
          : null,
    );
  }

  // ===== Glassmorphism / Liquid Glass =====
  
  // Glass colors
  static const Color glassBackground = Color(0x0DFFFFFF);
  static const Color glassBorder = Color(0x33FFFFFF);
  static const Color glassHighlight = Color(0x1AFFFFFF);
  static const Color glassShadow = Color(0x1A000000);
  
  // Dark mode glass colors
  static const Color darkGlassBackground = Color(0x1AFFFFFF);
  static const Color darkGlassBorder = Color(0x4DFFFFFF);
  static const Color darkGlassHighlight = Color(0x26FFFFFF);
  
  // Glass blur values
  static const double glassBlurLight = 10.0;
  static const double glassBlurMedium = 20.0;
  static const double glassBlurHeavy = 30.0;
  static const double glassBlurMax = 40.0;
  
  // Glass opacity values
  static const double glassOpacitySubtle = 0.05;
  static const double glassOpacityLight = 0.1;
  static const double glassOpacityMedium = 0.15;
  static const double glassOpacityHeavy = 0.2;
  
  // Glass styles for different components
  static GlassmorphicFlexContainer glassContainer({
    required Widget child,
    double? width,
    double? height,
    double blur = glassBlurMedium,
    double borderRadius = radiusLg,
    double borderWidth = 1.5,
    EdgeInsetsGeometry? padding,
    EdgeInsetsGeometry? margin,
    bool isDark = false,
  }) {
    return GlassmorphicFlexContainer(
      width: width ?? double.infinity,
      height: height ?? double.infinity,
      borderRadius: borderRadius,
      blur: blur,
      border: borderWidth,
      linearGradient: LinearGradient(
        begin: Alignment.topLeft,
        end: Alignment.bottomRight,
        colors: isDark
            ? [
                darkGlassHighlight,
                darkGlassBackground,
              ]
            : [
                glassHighlight,
                glassBackground,
              ],
        stops: const [0.1, 1.0],
      ),
      borderGradient: LinearGradient(
        begin: Alignment.topLeft,
        end: Alignment.bottomRight,
        colors: isDark
            ? [
                darkGlassBorder,
                darkGlassBorder.withOpacity(0.5),
              ]
            : [
                glassBorder,
                glassBorder.withOpacity(0.5),
              ],
      ),
      padding: padding,
      margin: margin,
      child: child,
    );
  }
  
  // Glass card widget
  static Widget glassCard({
    required Widget child,
    double? width,
    double? height,
    EdgeInsetsGeometry? padding,
    EdgeInsetsGeometry? margin,
    double elevation = 0,
    bool isDark = false,
  }) {
    return Container(
      width: width,
      height: height,
      margin: margin,
      decoration: BoxDecoration(
        borderRadius: BorderRadius.circular(radius2xl),
        boxShadow: elevation > 0
            ? [
                BoxShadow(
                  color: glassShadow,
                  blurRadius: elevation * 4,
                  offset: Offset(0, elevation * 2),
                ),
              ]
            : null,
      ),
      child: glassContainer(
        child: padding != null
            ? Padding(padding: padding, child: child)
            : child,
        borderRadius: radius2xl,
        blur: glassBlurMedium,
        isDark: isDark,
      ),
    );
  }
  
  // Glass button style
  static ButtonStyle glassButtonStyle(BuildContext context) {
    final isDark = Theme.of(context).brightness == Brightness.dark;
    return ButtonStyle(
      backgroundColor: MaterialStateProperty.all(Colors.transparent),
      foregroundColor: MaterialStateProperty.resolveWith((states) {
        if (states.contains(MaterialState.disabled)) {
          return isDark ? darkTextSecondary.withOpacity(0.5) : textTertiary;
        }
        return isDark ? darkTextPrimary : textPrimary;
      }),
      elevation: MaterialStateProperty.all(0),
      padding: MaterialStateProperty.all(
        const EdgeInsets.symmetric(horizontal: space4, vertical: space3),
      ),
      shape: MaterialStateProperty.all(
        RoundedRectangleBorder(
          borderRadius: BorderRadius.circular(radiusMd),
        ),
      ),
      textStyle: MaterialStateProperty.all(labelLarge),
    );
  }
  
  // Glass input decoration
  static InputDecoration glassInputDecoration({
    String? labelText,
    String? hintText,
    Widget? prefixIcon,
    Widget? suffixIcon,
    bool isDense = false,
    String? errorText,
    bool isDark = false,
  }) {
    return InputDecoration(
      labelText: labelText,
      hintText: hintText,
      prefixIcon: prefixIcon,
      suffixIcon: suffixIcon,
      isDense: isDense,
      errorText: errorText,
      filled: false,
      contentPadding: EdgeInsets.symmetric(
        horizontal: space3,
        vertical: isDense ? space2 : space3,
      ),
      border: InputBorder.none,
      enabledBorder: InputBorder.none,
      focusedBorder: InputBorder.none,
      errorBorder: InputBorder.none,
      focusedErrorBorder: InputBorder.none,
      disabledBorder: InputBorder.none,
      labelStyle: bodyMedium.copyWith(
        color: isDark ? darkTextSecondary : textSecondary,
      ),
      hintStyle: bodyMedium.copyWith(
        color: isDark ? darkTextSecondary.withOpacity(0.7) : textTertiary,
      ),
      errorStyle: caption.copyWith(color: errorColor),
    );
  }
  
  // Glass app bar
  static PreferredSizeWidget glassAppBar({
    required String title,
    List<Widget>? actions,
    Widget? leading,
    bool isDark = false,
    double? toolbarHeight,
  }) {
    return PreferredSize(
      preferredSize: Size.fromHeight(toolbarHeight ?? kToolbarHeight),
      child: ClipRect(
        child: BackdropFilter(
          filter: ImageFilter.blur(sigmaX: glassBlurHeavy, sigmaY: glassBlurHeavy),
          child: Container(
            height: toolbarHeight ?? kToolbarHeight,
            decoration: BoxDecoration(
              gradient: LinearGradient(
                begin: Alignment.topCenter,
                end: Alignment.bottomCenter,
                colors: isDark
                    ? [
                        darkGlassBackground.withOpacity(0.8),
                        darkGlassBackground.withOpacity(0.6),
                      ]
                    : [
                        glassBackground.withOpacity(0.8),
                        glassBackground.withOpacity(0.6),
                      ],
              ),
              border: Border(
                bottom: BorderSide(
                  color: isDark ? darkGlassBorder : glassBorder,
                  width: 0.5,
                ),
              ),
            ),
            child: AppBar(
              backgroundColor: Colors.transparent,
              elevation: 0,
              title: Text(
                title,
                style: headlineMedium.copyWith(
                  color: isDark ? darkTextPrimary : textPrimary,
                ),
              ),
              actions: actions,
              leading: leading,
              systemOverlayStyle: isDark ? SystemUiOverlayStyle.light : SystemUiOverlayStyle.dark,
            ),
          ),
        ),
      ),
    );
  }
  
  // Glass theme data
  static ThemeData glassTheme({
    required Brightness brightness,
  }) {
    final isDark = brightness == Brightness.dark;
    return ThemeData(
      brightness: brightness,
      primaryColor: primaryColor,
      scaffoldBackgroundColor: isDark ? darkBackgroundPrimary : backgroundPrimary,
      fontFamily: fontFamily,
      textTheme: TextTheme(
        displayLarge: displayLarge.copyWith(color: isDark ? darkTextPrimary : textPrimary),
        displayMedium: displayMedium.copyWith(color: isDark ? darkTextPrimary : textPrimary),
        displaySmall: displaySmall.copyWith(color: isDark ? darkTextPrimary : textPrimary),
        headlineLarge: headlineLarge.copyWith(color: isDark ? darkTextPrimary : textPrimary),
        headlineMedium: headlineMedium.copyWith(color: isDark ? darkTextPrimary : textPrimary),
        headlineSmall: headlineSmall.copyWith(color: isDark ? darkTextPrimary : textPrimary),
        bodyLarge: bodyLarge.copyWith(color: isDark ? darkTextPrimary : textPrimary),
        bodyMedium: bodyMedium.copyWith(color: isDark ? darkTextPrimary : textPrimary),
        bodySmall: bodySmall.copyWith(color: isDark ? darkTextSecondary : textSecondary),
        labelLarge: labelLarge.copyWith(color: isDark ? darkTextPrimary : textPrimary),
        labelMedium: labelMedium.copyWith(color: isDark ? darkTextSecondary : textSecondary),
        labelSmall: labelSmall.copyWith(color: isDark ? darkTextSecondary : textTertiary),
      ),
      colorScheme: ColorScheme(
        brightness: brightness,
        primary: primaryColor,
        onPrimary: Colors.white,
        secondary: secondaryColor,
        onSecondary: Colors.white,
        error: errorColor,
        onError: Colors.white,
        background: isDark ? darkBackgroundPrimary : backgroundPrimary,
        onBackground: isDark ? darkTextPrimary : textPrimary,
        surface: isDark ? darkSurfaceColor : surfaceColor,
        onSurface: isDark ? darkTextPrimary : textPrimary,
      ),
      elevatedButtonTheme: ElevatedButtonThemeData(
        style: primaryButtonStyle,
      ),
      outlinedButtonTheme: OutlinedButtonThemeData(
        style: secondaryButtonStyle,
      ),
      textButtonTheme: TextButtonThemeData(
        style: textButtonStyle,
      ),
    );
  }
  
  // Light theme with glassmorphism
  static final ThemeData lightTheme = glassTheme(brightness: Brightness.light);
  
  // Dark theme with glassmorphism
  static final ThemeData darkTheme = glassTheme(brightness: Brightness.dark);
}