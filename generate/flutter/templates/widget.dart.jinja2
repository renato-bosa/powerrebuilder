import 'package:flutter/material.dart';
import 'package:flutter/cupertino.dart';
import '../theme/design_system.dart';
{%- for import_stmt in widget.imports %}
{{ import_stmt }}
{%- endfor %}

{%- if widget.props %}
  {%- for prop in widget.props %}
  {%- if loop.first %}

/// Properties for {{ widget.name }}
  {%- endif %}
  {%- endfor %}
{%- endif %}

class {{ widget.name }} extends {% if widget.has_state %}StatefulWidget{% else %}StatelessWidget{% endif %} {
  {%- if widget.props %}
  {%- for prop in widget.props %}
  final {{ prop.type }} {{ prop.name }};
  {%- endfor %}
  {%- endif %}

  const {{ widget.name }}({
    Key? key,
    {%- if widget.props %}
    {%- for prop in widget.props %}
    {% if prop.required %}required {% endif %}this.{{ prop.name }},
    {%- endfor %}
    {%- endif %}
  }) : super(key: key);

  {%- if widget.has_state %}
  @override
  State<{{ widget.name }}> createState() => _{{ widget.name }}State();
  {%- else %}
  @override
  Widget build(BuildContext context) {
    return {{ widget.build_content | dedent(4) }};
  }
  {%- endif %}
}

{%- if widget.has_state %}
class _{{ widget.name }}State extends State<{{ widget.name }}> {
  {%- if widget.state %}
  // State variables
  {%- for state in widget.state %}
  {{ state.type }}{% if state.nullable %}?{% endif %} {{ state.name }}{% if state.initial %} = {{ state.initial }}{% endif %};
  {%- endfor %}
  {%- endif %}

  {%- if widget.controllers %}
  // Controllers
  {%- for controller in widget.controllers %}
  {{ controller.type }}? {{ controller.name }};
  {%- endfor %}
  {%- endif %}

  @override
  void initState() {
    super.initState();
    {%- if widget.controllers %}
    // Initialize controllers
    {%- for controller in widget.controllers %}
    {{ controller.name }} = {{ controller.type }}({% if controller.initial %}text: '{{ controller.initial }}'{% endif %});
    {%- endfor %}
    {%- endif %}
    {%- if widget.init_code %}
    // Custom initialization
    {{ widget.init_code | indent(4) }}
    {%- endif %}
  }

  @override
  void dispose() {
    {%- if widget.controllers %}
    // Dispose controllers
    {%- for controller in widget.controllers %}
    {{ controller.name }}?.dispose();
    {%- endfor %}
    {%- endif %}
    {%- if widget.dispose_code %}
    // Custom disposal
    {{ widget.dispose_code | indent(4) }}
    {%- endif %}
    super.dispose();
  }

  {%- if widget.methods %}
  // Methods
  {%- for method in widget.methods %}
  {{ method.return_type }} {{ method.name }}({{ method.params }}) {
    {{ method.body | indent(4) }}
  }
  {%- endfor %}
  {%- endif %}

  @override
  Widget build(BuildContext context) {
    final theme = Theme.of(context);
    final isDark = theme.brightness == Brightness.dark;
    
    return Container(
      {%- if widget.padding %}
      padding: {{ widget.padding }},
      {%- else %}
      padding: const EdgeInsets.all(AppDesignSystem.space4),
      {%- endif %}
      decoration: AppDesignSystem.containerDecoration(
        color: isDark ? AppDesignSystem.darkSurfaceColor : AppDesignSystem.surfaceColor,
        radius: AppDesignSystem.radiusLg,
      ),
      child: {% if widget.controls|length > 1 %}Column(
        crossAxisAlignment: CrossAxisAlignment.start,
        mainAxisSize: MainAxisSize.min,
        children: [
          {%- for control in widget.controls %}
          {%- if control.type == "input" %}
          Container(
            decoration: BoxDecoration(
              borderRadius: BorderRadius.circular(AppDesignSystem.radiusMd),
              color: isDark ? AppDesignSystem.darkBackgroundSecondary : AppDesignSystem.backgroundSecondary,
            ),
            child: TextField(
              controller: {{ control.controller }},
              style: AppDesignSystem.bodyMedium.copyWith(
                color: isDark ? AppDesignSystem.darkTextPrimary : AppDesignSystem.textPrimary,
              ),
              decoration: AppDesignSystem.inputDecoration(
                {%- if control.label %}
                labelText: '{{ control.label }}',
                {%- endif %}
                {%- if control.hint %}
                hintText: '{{ control.hint }}',
                {%- endif %}
                {%- if control.icon %}
                prefixIcon: Icon(
                  {{ control.icon }},
                  size: 20,
                  color: isDark ? AppDesignSystem.darkTextSecondary : AppDesignSystem.textSecondary,
                ),
                {%- endif %}
              ).copyWith(
                fillColor: Colors.transparent,
                filled: false,
              ),
              {%- if control.on_changed %}
              onChanged: (value) {
                {{ control.on_changed | indent(14) }}
              },
              {%- endif %}
            ),
          ),
          {%- elif control.type == "button" %}
          SizedBox(
            width: {% if control.full_width %}double.infinity{% else %}null{% endif %},
            child: ElevatedButton(
              onPressed: {{ control.on_pressed }},
              style: {% if control.variant == "secondary" %}AppDesignSystem.secondaryButtonStyle(context){% elif control.variant == "text" %}AppDesignSystem.textButtonStyle(context){% else %}AppDesignSystem.primaryButtonStyle(context){% endif %},
              child: Row(
                mainAxisSize: MainAxisSize.min,
                mainAxisAlignment: MainAxisAlignment.center,
                children: [
                  {%- if control.icon %}
                  Icon({{ control.icon }}, size: 18),
                  const SizedBox(width: AppDesignSystem.space2),
                  {%- endif %}
                  Text('{{ control.text }}'),
                ],
              ),
            ),
          ),
          {%- elif control.type == "text" %}
          Text(
            {{ control.text }},
            style: {% if control.variant == "title" %}AppDesignSystem.headlineMedium{% elif control.variant == "subtitle" %}AppDesignSystem.bodyLarge{% elif control.variant == "caption" %}AppDesignSystem.caption{% else %}AppDesignSystem.bodyMedium{% endif %}.copyWith(
              color: {% if control.variant == "secondary" %}(isDark ? AppDesignSystem.darkTextSecondary : AppDesignSystem.textSecondary){% elif control.variant == "tertiary" %}(isDark ? AppDesignSystem.darkTextSecondary.withOpacity(0.7) : AppDesignSystem.textTertiary){% else %}(isDark ? AppDesignSystem.darkTextPrimary : AppDesignSystem.textPrimary){% endif %},
            ),
          ),
          {%- elif control.type == "checkbox" %}
          Material(
            color: Colors.transparent,
            child: InkWell(
              onTap: () {
                setState(() {
                  {{ control.on_changed | indent(18) }}
                });
              },
              borderRadius: BorderRadius.circular(AppDesignSystem.radiusMd),
              child: Padding(
                padding: const EdgeInsets.symmetric(
                  horizontal: AppDesignSystem.space3,
                  vertical: AppDesignSystem.space2,
                ),
                child: Row(
                  children: [
                    SizedBox(
                      width: 20,
                      height: 20,
                      child: Checkbox(
                        value: {{ control.value }},
                        onChanged: (bool? value) {
                          setState(() {
                            {{ control.on_changed | indent(28) }}
                          });
                        },
                        shape: RoundedRectangleBorder(
                          borderRadius: BorderRadius.circular(AppDesignSystem.radiusXs),
                        ),
                        side: BorderSide(
                          color: isDark ? AppDesignSystem.darkBorderColor : AppDesignSystem.borderColor,
                          width: 1.5,
                        ),
                        activeColor: AppDesignSystem.primaryColor,
                      ),
                    ),
                    const SizedBox(width: AppDesignSystem.space3),
                    Expanded(
                      child: Text(
                        '{{ control.label }}',
                        style: AppDesignSystem.bodyMedium.copyWith(
                          color: isDark ? AppDesignSystem.darkTextPrimary : AppDesignSystem.textPrimary,
                        ),
                      ),
                    ),
                  ],
                ),
              ),
            ),
          ),
          {%- elif control.type == "dropdown" %}
          Container(
            padding: const EdgeInsets.symmetric(horizontal: AppDesignSystem.space3),
            decoration: BoxDecoration(
              borderRadius: BorderRadius.circular(AppDesignSystem.radiusMd),
              border: Border.all(
                color: isDark ? AppDesignSystem.darkBorderColor : AppDesignSystem.borderColor,
              ),
              color: isDark ? AppDesignSystem.darkBackgroundSecondary : AppDesignSystem.backgroundSecondary,
            ),
            child: DropdownButtonHideUnderline(
              child: DropdownButton<{{ control.item_type }}>(
                value: {{ control.value }},
                isExpanded: true,
                icon: Icon(
                  CupertinoIcons.chevron_down,
                  size: 16,
                  color: isDark ? AppDesignSystem.darkTextSecondary : AppDesignSystem.textSecondary,
                ),
                style: AppDesignSystem.bodyMedium.copyWith(
                  color: isDark ? AppDesignSystem.darkTextPrimary : AppDesignSystem.textPrimary,
                ),
                dropdownColor: isDark ? AppDesignSystem.darkBackgroundSecondary : AppDesignSystem.backgroundSecondary,
                borderRadius: BorderRadius.circular(AppDesignSystem.radiusMd),
                items: {{ control.items }}.map<DropdownMenuItem<{{ control.item_type }}>>(({{ control.item_type }} value) {
                  return DropdownMenuItem<{{ control.item_type }}>(
                    value: value,
                    child: Text(value.toString()),
                  );
                }).toList(),
                onChanged: ({{ control.item_type }}? newValue) {
                  setState(() {
                    {{ control.on_changed | indent(20) }}
                  });
                },
              ),
            ),
          ),
          {%- elif control.type == "custom" %}
          {{ control.widget }},
          {%- endif %}
          {%- if not loop.last %}
          SizedBox(height: {{ widget.spacing | default("AppDesignSystem.space3") }}),
          {%- endif %}
          {%- endfor %}
        ],
      ){% else %}{{ widget.controls[0].widget if widget.controls else "Container()" }}{% endif %},
    );
  }
}
{%- endif %}