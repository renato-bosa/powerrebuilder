import 'package:flutter/material.dart';
import 'package:flutter/cupertino.dart';
import 'package:flutter/services.dart';
import '../theme/design_system.dart';
{%- for import_stmt in screen.imports %}
{{ import_stmt }}
{%- endfor %}

/// {{ screen.description }}
class {{ screen.name }}Screen extends StatefulWidget {
  static const String routeName = '/{{ screen.route_name }}';
  
  {%- if screen.params %}
  // Screen parameters
  {%- for param in screen.params %}
  final {{ param.type }} {{ param.name }};
  {%- endfor %}
  {%- endif %}

  const {{ screen.name }}Screen({
    Key? key,
    {%- if screen.params %}
    {%- for param in screen.params %}
    {% if param.required %}required {% endif %}this.{{ param.name }},
    {%- endfor %}
    {%- endif %}
  }) : super(key: key);

  @override
  State<{{ screen.name }}Screen> createState() => _{{ screen.name }}ScreenState();
}

class _{{ screen.name }}ScreenState extends State<{{ screen.name }}Screen> {
  {%- if screen.state %}
  // State variables
  {%- for state in screen.state %}
  {{ state.type }}{% if state.nullable %}?{% endif %} {{ state.name }}{% if state.initial %} = {{ state.initial }}{% endif %};
  {%- endfor %}
  {%- endif %}

  {%- if screen.controllers %}
  // Controllers
  {%- for controller in screen.controllers %}
  {{ controller.type }}? {{ controller.name }};
  {%- endfor %}
  {%- endif %}

  {%- if screen.services %}
  // Services
  {%- for service in screen.services %}
  final {{ service.type }} {{ service.name }} = {{ service.initializer }};
  {%- endfor %}
  {%- endif %}

  @override
  void initState() {
    super.initState();
    {%- if screen.controllers %}
    // Initialize controllers
    {%- for controller in screen.controllers %}
    {{ controller.name }} = {{ controller.type }}({% if controller.initial %}text: '{{ controller.initial }}'{% endif %});
    {%- endfor %}
    {%- endif %}
    {%- if screen.init_code %}
    // Custom initialization
    {{ screen.init_code | indent(4) }}
    {%- endif %}
    {%- if screen.load_data %}
    // Load initial data
    _loadData();
    {%- endif %}
  }

  @override
  void dispose() {
    {%- if screen.controllers %}
    // Dispose controllers
    {%- for controller in screen.controllers %}
    {{ controller.name }}?.dispose();
    {%- endfor %}
    {%- endif %}
    {%- if screen.dispose_code %}
    // Custom disposal
    {{ screen.dispose_code | indent(4) }}
    {%- endif %}
    super.dispose();
  }

  {%- if screen.load_data %}
  Future<void> _loadData() async {
    {{ screen.load_data | indent(4) }}
  }
  {%- endif %}

  {%- if screen.methods %}
  // Methods
  {%- for method in screen.methods %}
  {{ method.return_type }} {{ method.name }}({{ method.params }}) {% if method.is_async %}async {% endif %}{
    {{ method.body | indent(4) }}
  }
  {%- endfor %}
  {%- endif %}

  @override
  Widget build(BuildContext context) {
    final theme = Theme.of(context);
    final isDark = theme.brightness == Brightness.dark;
    
    return Scaffold(
      backgroundColor: isDark ? AppDesignSystem.darkBackgroundPrimary : AppDesignSystem.backgroundPrimary,
      {%- if screen.app_bar %}
      appBar: PreferredSize(
        preferredSize: const Size.fromHeight(kToolbarHeight),
        child: AppBar(
          backgroundColor: isDark ? AppDesignSystem.darkBackgroundPrimary : AppDesignSystem.backgroundPrimary,
          elevation: 0,
          scrolledUnderElevation: 0,
          systemOverlayStyle: isDark ? SystemUiOverlayStyle.light : SystemUiOverlayStyle.dark,
          title: Text(
            '{{ screen.title }}',
            style: AppDesignSystem.headlineMedium.copyWith(
              color: isDark ? AppDesignSystem.darkTextPrimary : AppDesignSystem.textPrimary,
            ),
          ),
          {%- if screen.app_bar.actions %}
          actions: [
            {%- for action in screen.app_bar.actions %}
            Container(
              margin: const EdgeInsets.only(right: AppDesignSystem.space2),
              child: Material(
                color: Colors.transparent,
                child: InkWell(
                  onTap: {{ action.on_pressed }},
                  borderRadius: BorderRadius.circular(AppDesignSystem.radiusMd),
                  child: Container(
                    padding: const EdgeInsets.all(AppDesignSystem.space2),
                    child: Icon(
                      {{ action.icon }},
                      size: 22,
                      color: isDark ? AppDesignSystem.darkTextSecondary : AppDesignSystem.textSecondary,
                    ),
                  ),
                ),
              ),
            ),
            {%- endfor %}
          ],
          {%- endif %}
          bottom: PreferredSize(
            preferredSize: const Size.fromHeight(1),
            child: Container(
              height: 1,
              color: isDark ? AppDesignSystem.darkBorderColor : AppDesignSystem.borderSubtle,
            ),
          ),
        ),
      ),
      {%- endif %}
      {%- if screen.drawer %}
      drawer: {{ screen.drawer }},
      {%- endif %}
      {%- if screen.bottom_nav %}
      bottomNavigationBar: Container(
        decoration: BoxDecoration(
          color: isDark ? AppDesignSystem.darkBackgroundSecondary : AppDesignSystem.backgroundSecondary,
          border: Border(
            top: BorderSide(
              color: isDark ? AppDesignSystem.darkBorderColor : AppDesignSystem.borderSubtle,
              width: 1,
            ),
          ),
        ),
        child: SafeArea(
          child: Padding(
            padding: const EdgeInsets.symmetric(vertical: AppDesignSystem.space2),
            child: Row(
              mainAxisAlignment: MainAxisAlignment.spaceAround,
              children: [
                {%- for item in screen.bottom_nav.items %}
                Expanded(
                  child: InkWell(
                    onTap: () => {{ screen.bottom_nav.on_tap }}({{ loop.index0 }}),
                    child: Column(
                      mainAxisSize: MainAxisSize.min,
                      children: [
                        Icon(
                          {{ item.icon }},
                          size: 24,
                          color: {{ screen.bottom_nav.current_index }} == {{ loop.index0 }}
                              ? AppDesignSystem.primaryColor
                              : (isDark ? AppDesignSystem.darkTextSecondary : AppDesignSystem.textTertiary),
                        ),
                        const SizedBox(height: AppDesignSystem.space1),
                        Text(
                          '{{ item.label }}',
                          style: AppDesignSystem.labelSmall.copyWith(
                            color: {{ screen.bottom_nav.current_index }} == {{ loop.index0 }}
                                ? AppDesignSystem.primaryColor
                                : (isDark ? AppDesignSystem.darkTextSecondary : AppDesignSystem.textTertiary),
                          ),
                        ),
                      ],
                    ),
                  ),
                ),
                {%- endfor %}
              ],
            ),
          ),
        ),
      ),
      {%- endif %}
      {%- if screen.floating_action_button %}
      floatingActionButton: Container(
        decoration: BoxDecoration(
          borderRadius: BorderRadius.circular(AppDesignSystem.radiusLg),
          boxShadow: AppDesignSystem.shadowLg,
        ),
        child: Material(
          color: AppDesignSystem.primaryColor,
          borderRadius: BorderRadius.circular(AppDesignSystem.radiusLg),
          child: InkWell(
            onTap: {{ screen.floating_action_button.on_pressed }},
            borderRadius: BorderRadius.circular(AppDesignSystem.radiusLg),
            child: Container(
              width: 56,
              height: 56,
              alignment: Alignment.center,
              child: Icon(
                {{ screen.floating_action_button.icon }},
                color: Colors.white,
                size: 24,
              ),
            ),
          ),
        ),
      ),
      {%- endif %}
      body: {% if screen.loading_state %}{{ screen.loading_state }} ? 
        Center(
          child: Column(
            mainAxisAlignment: MainAxisAlignment.center,
            children: [
              Container(
                width: 48,
                height: 48,
                padding: const EdgeInsets.all(AppDesignSystem.space3),
                decoration: BoxDecoration(
                  color: isDark ? AppDesignSystem.darkBackgroundSecondary : AppDesignSystem.backgroundSecondary,
                  borderRadius: BorderRadius.circular(AppDesignSystem.radiusLg),
                ),
                child: CircularProgressIndicator(
                  strokeWidth: 3,
                  valueColor: AlwaysStoppedAnimation<Color>(AppDesignSystem.primaryColor),
                ),
              ),
              const SizedBox(height: AppDesignSystem.space4),
              Text(
                'Loading...',
                style: AppDesignSystem.bodyMedium.copyWith(
                  color: isDark ? AppDesignSystem.darkTextSecondary : AppDesignSystem.textSecondary,
                ),
              ),
            ],
          ),
        ) : 
      {% endif %}SafeArea(
        child: {{ screen.body | dedent(8) }},
      ),
    );
  }
}