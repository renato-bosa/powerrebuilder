/// Pipeline service for data transfer operations
/// Replaces PowerBuilder Pipeline object functionality
class {{ name }} {
  // Pipeline configuration
  final String sourceName;
  final String destinationName;
  final PipelineType pipelineType;
  final DataFormat sourceFormat;
  final DataFormat destinationFormat;
  
  // Connection details
  final String? sourceConnection;
  final String? destinationConnection;
  final Map<String, dynamic>? sourceConfig;
  final Map<String, dynamic>? destinationConfig;
  
  // Transfer options
  final int batchSize;
  final bool truncateDestination;
  final bool createDestination;
  final ConflictResolution conflictResolution;
  final Map<String, String>? columnMappings;
  final List<String>? excludeColumns;
  final String? whereClause;
  
  // Progress tracking
  final StreamController<PipelineProgress> _progressController = StreamController<PipelineProgress>.broadcast();
  final StreamController<PipelineError> _errorController = StreamController<PipelineError>.broadcast();
  
  Stream<PipelineProgress> get progressStream => _progressController.stream;
  Stream<PipelineError> get errorStream => _errorController.stream;
  
  // State
  bool _isRunning = false;
  bool _isCancelled = false;
  int _totalRows = 0;
  int _processedRows = 0;
  int _errorCount = 0;
  DateTime? _startTime;
  DateTime? _endTime;

  {{ name }}({
    required this.sourceName,
    required this.destinationName,
    this.pipelineType = PipelineType.tableToTable,
    this.sourceFormat = DataFormat.database,
    this.destinationFormat = DataFormat.database,
    this.sourceConnection,
    this.destinationConnection,
    this.sourceConfig,
    this.destinationConfig,
    this.batchSize = 1000,
    this.truncateDestination = false,
    this.createDestination = false,
    this.conflictResolution = ConflictResolution.fail,
    this.columnMappings,
    this.excludeColumns,
    this.whereClause,
  });

  /// Execute the pipeline transfer
  Future<PipelineResult> execute() async {
    if (_isRunning) {
      throw PipelineException('Pipeline is already running');
    }
    
    _isRunning = true;
    _isCancelled = false;
    _totalRows = 0;
    _processedRows = 0;
    _errorCount = 0;
    _startTime = DateTime.now();
    
    try {
      // Validate configuration
      _validateConfiguration();
      
      // Initialize connections
      final source = await _initializeSource();
      final destination = await _initializeDestination();
      
      // Get total row count
      _totalRows = await _getSourceRowCount(source);
      _emitProgress('Starting pipeline transfer', 0);
      
      // Prepare destination
      if (truncateDestination) {
        await _truncateDestination(destination);
      }
      
      if (createDestination) {
        await _createDestinationStructure(source, destination);
      }
      
      // Execute transfer
      await _executeTransfer(source, destination);
      
      _endTime = DateTime.now();
      
      return PipelineResult(
        success: _errorCount == 0,
        totalRows: _totalRows,
        processedRows: _processedRows,
        errorCount: _errorCount,
        duration: _endTime!.difference(_startTime!),
      );
      
    } catch (e) {
      _emitError('Pipeline execution failed', e);
      return PipelineResult(
        success: false,
        totalRows: _totalRows,
        processedRows: _processedRows,
        errorCount: _errorCount + 1,
        duration: DateTime.now().difference(_startTime!),
        error: e.toString(),
      );
    } finally {
      _isRunning = false;
    }
  }

  /// Cancel the running pipeline
  void cancel() {
    _isCancelled = true;
    _emitProgress('Pipeline cancelled', _processedRows / _totalRows);
  }

  /// Validate pipeline configuration
  void _validateConfiguration() {
    if (sourceName.isEmpty) {
      throw PipelineException('Source name is required');
    }
    
    if (destinationName.isEmpty) {
      throw PipelineException('Destination name is required');
    }
    
    // Validate based on pipeline type
    switch (pipelineType) {
      case PipelineType.tableToTable:
      case PipelineType.queryToTable:
        if (sourceFormat != DataFormat.database || destinationFormat != DataFormat.database) {
          throw PipelineException('Table operations require database format');
        }
        break;
        
      case PipelineType.fileToTable:
        if (sourceFormat == DataFormat.database) {
          throw PipelineException('File source cannot use database format');
        }
        if (destinationFormat != DataFormat.database) {
          throw PipelineException('Table destination requires database format');
        }
        break;
        
      case PipelineType.tableToFile:
        if (sourceFormat != DataFormat.database) {
          throw PipelineException('Table source requires database format');
        }
        if (destinationFormat == DataFormat.database) {
          throw PipelineException('File destination cannot use database format');
        }
        break;
    }
  }

  /// Initialize source connection/reader
  Future<DataSource> _initializeSource() async {
    switch (sourceFormat) {
      case DataFormat.database:
        return await _initializeDatabaseSource();
        
      case DataFormat.csv:
        return await _initializeCsvSource();
        
      case DataFormat.json:
        return await _initializeJsonSource();
        
      case DataFormat.excel:
        return await _initializeExcelSource();
        
      default:
        throw PipelineException('Unsupported source format: $sourceFormat');
    }
  }

  /// Initialize destination connection/writer
  Future<DataDestination> _initializeDestination() async {
    switch (destinationFormat) {
      case DataFormat.database:
        return await _initializeDatabaseDestination();
        
      case DataFormat.csv:
        return await _initializeCsvDestination();
        
      case DataFormat.json:
        return await _initializeJsonDestination();
        
      case DataFormat.excel:
        return await _initializeExcelDestination();
        
      default:
        throw PipelineException('Unsupported destination format: $destinationFormat');
    }
  }

  {%- if has_database %}
  /// Initialize database source
  Future<DatabaseSource> _initializeDatabaseSource() async {
    final db = await _openDatabase(sourceConnection ?? 'main');
    
    String query;
    if (pipelineType == PipelineType.queryToTable) {
      query = sourceName; // Source name contains the query
    } else {
      query = 'SELECT * FROM $sourceName';
      if (whereClause != null && whereClause!.isNotEmpty) {
        query += ' WHERE $whereClause';
      }
    }
    
    return DatabaseSource(db: db, query: query);
  }

  /// Initialize database destination
  Future<DatabaseDestination> _initializeDatabaseDestination() async {
    final db = await _openDatabase(destinationConnection ?? 'main');
    return DatabaseDestination(db: db, tableName: destinationName);
  }

  /// Open database connection
  Future<Database> _openDatabase(String connectionName) async {
    // This would use your actual database configuration
    // For now, using a simple implementation
    if (connectionName == 'main') {
      return await openDatabase('app_database.db');
    }
    throw PipelineException('Unknown database connection: $connectionName');
  }
  {%- endif %}

  {%- if has_file_operations %}
  /// Initialize CSV source
  Future<CsvSource> _initializeCsvSource() async {
    final file = File(sourceName);
    if (!await file.exists()) {
      throw PipelineException('Source file not found: $sourceName');
    }
    
    final contents = await file.readAsString();
    final csvData = const CsvToListConverter().convert(contents);
    
    return CsvSource(
      headers: csvData.isNotEmpty ? csvData.first.map((e) => e.toString()).toList() : [],
      rows: csvData.length > 1 ? csvData.sublist(1) : [],
    );
  }

  /// Initialize CSV destination
  Future<CsvDestination> _initializeCsvDestination() async {
    final file = File(destinationName);
    final exists = await file.exists();
    
    if (exists && !truncateDestination && conflictResolution == ConflictResolution.fail) {
      throw PipelineException('Destination file already exists: $destinationName');
    }
    
    return CsvDestination(file: file);
  }
  {%- endif %}

  /// Get source row count
  Future<int> _getSourceRowCount(DataSource source) async {
    if (source is DatabaseSource) {
      final countQuery = 'SELECT COUNT(*) FROM (${source.query}) AS cnt';
      final result = await source.db.rawQuery(countQuery);
      return Sqflite.firstIntValue(result) ?? 0;
    } else if (source is CsvSource) {
      return source.rows.length;
    }
    // Add other source types as needed
    return 0;
  }

  /// Execute the data transfer
  Future<void> _executeTransfer(DataSource source, DataDestination destination) async {
    // Get column information
    final sourceColumns = await _getSourceColumns(source);
    final destColumns = await _getDestinationColumns(destination);
    
    // Apply column mappings and exclusions
    final mappedColumns = _applyColumnMappings(sourceColumns, destColumns);
    
    // Process in batches
    var offset = 0;
    while (!_isCancelled && offset < _totalRows) {
      final batch = await _readBatch(source, offset, batchSize);
      if (batch.isEmpty) break;
      
      try {
        // Transform batch data according to mappings
        final transformedBatch = _transformBatch(batch, mappedColumns);
        
        // Write to destination
        await _writeBatch(destination, transformedBatch);
        
        _processedRows += batch.length;
        offset += batch.length;
        
        _emitProgress(
          'Processed $_processedRows of $_totalRows rows',
          _processedRows / _totalRows,
        );
        
      } catch (e) {
        _errorCount++;
        _emitError('Batch processing error at row $offset', e);
        
        if (conflictResolution == ConflictResolution.fail) {
          throw e;
        }
        // For skip mode, continue to next batch
        offset += batchSize;
      }
    }
  }

  /// Read a batch of data from source
  Future<List<Map<String, dynamic>>> _readBatch(
    DataSource source,
    int offset,
    int limit,
  ) async {
    if (source is DatabaseSource) {
      final query = '${source.query} LIMIT $limit OFFSET $offset';
      return await source.db.rawQuery(query);
    } else if (source is CsvSource) {
      final endIndex = (offset + limit).clamp(0, source.rows.length);
      final batch = source.rows.sublist(offset, endIndex);
      
      // Convert to map format
      return batch.map((row) {
        final map = <String, dynamic>{};
        for (int i = 0; i < source.headers.length && i < row.length; i++) {
          map[source.headers[i]] = row[i];
        }
        return map;
      }).toList();
    }
    
    return [];
  }

  /// Write a batch of data to destination
  Future<void> _writeBatch(
    DataDestination destination,
    List<Map<String, dynamic>> batch,
  ) async {
    if (destination is DatabaseDestination) {
      // Use transaction for better performance
      await destination.db.transaction((txn) async {
        for (final row in batch) {
          switch (conflictResolution) {
            case ConflictResolution.replace:
              await txn.insert(
                destination.tableName,
                row,
                conflictAlgorithm: ConflictAlgorithm.replace,
              );
              break;
              
            case ConflictResolution.ignore:
              await txn.insert(
                destination.tableName,
                row,
                conflictAlgorithm: ConflictAlgorithm.ignore,
              );
              break;
              
            default:
              await txn.insert(destination.tableName, row);
          }
        }
      });
    } else if (destination is CsvDestination) {
      // Convert to CSV format
      final rows = batch.map((map) => map.values.toList()).toList();
      final csv = const ListToCsvConverter().convert(rows);
      
      // Append or write
      if (await destination.file.exists() && !truncateDestination) {
        await destination.file.writeAsString(
          '\n$csv',
          mode: FileMode.append,
        );
      } else {
        // Include headers on first write
        final headers = batch.isNotEmpty ? batch.first.keys.toList() : [];
        final fullCsv = const ListToCsvConverter().convert([headers, ...rows]);
        await destination.file.writeAsString(fullCsv);
      }
    }
  }

  /// Get source columns
  Future<List<ColumnInfo>> _getSourceColumns(DataSource source) async {
    if (source is DatabaseSource) {
      // Get column info from query
      final result = await source.db.rawQuery('${source.query} LIMIT 0');
      // This is simplified - actual implementation would parse column metadata
      return [];
    } else if (source is CsvSource) {
      return source.headers.map((name) => ColumnInfo(
        name: name,
        type: 'TEXT',
        nullable: true,
      )).toList();
    }
    return [];
  }

  /// Get destination columns
  Future<List<ColumnInfo>> _getDestinationColumns(DataDestination destination) async {
    if (destination is DatabaseDestination) {
      // Get table info
      final result = await destination.db.rawQuery(
        'PRAGMA table_info(${destination.tableName})'
      );
      return result.map((row) => ColumnInfo(
        name: row['name'] as String,
        type: row['type'] as String,
        nullable: row['notnull'] != 1,
      )).toList();
    }
    return [];
  }

  /// Apply column mappings and exclusions
  List<ColumnMapping> _applyColumnMappings(
    List<ColumnInfo> sourceColumns,
    List<ColumnInfo> destColumns,
  ) {
    final mappings = <ColumnMapping>[];
    
    for (final sourceCol in sourceColumns) {
      // Skip excluded columns
      if (excludeColumns?.contains(sourceCol.name) ?? false) {
        continue;
      }
      
      // Apply custom mapping or use same name
      final destName = columnMappings?[sourceCol.name] ?? sourceCol.name;
      
      // Find destination column
      final destCol = destColumns.firstWhere(
        (col) => col.name == destName,
        orElse: () => ColumnInfo(name: destName, type: sourceCol.type, nullable: true),
      );
      
      mappings.add(ColumnMapping(
        sourceName: sourceCol.name,
        destName: destCol.name,
        sourceType: sourceCol.type,
        destType: destCol.type,
      ));
    }
    
    return mappings;
  }

  /// Transform batch according to column mappings
  List<Map<String, dynamic>> _transformBatch(
    List<Map<String, dynamic>> batch,
    List<ColumnMapping> mappings,
  ) {
    return batch.map((row) {
      final transformed = <String, dynamic>{};
      
      for (final mapping in mappings) {
        if (row.containsKey(mapping.sourceName)) {
          final value = row[mapping.sourceName];
          // Apply type conversion if needed
          transformed[mapping.destName] = _convertValue(
            value,
            mapping.sourceType,
            mapping.destType,
          );
        }
      }
      
      return transformed;
    }).toList();
  }

  /// Convert value between types
  dynamic _convertValue(dynamic value, String sourceType, String destType) {
    if (value == null) return null;
    
    // Add type conversion logic as needed
    // This is a simplified version
    if (destType.toUpperCase().contains('INT')) {
      return int.tryParse(value.toString()) ?? 0;
    } else if (destType.toUpperCase().contains('REAL') || 
               destType.toUpperCase().contains('FLOAT')) {
      return double.tryParse(value.toString()) ?? 0.0;
    } else if (destType.toUpperCase().contains('BOOL')) {
      return value.toString().toLowerCase() == 'true' || value == 1;
    }
    
    return value.toString();
  }

  /// Truncate destination table/file
  Future<void> _truncateDestination(DataDestination destination) async {
    _emitProgress('Truncating destination', 0);
    
    if (destination is DatabaseDestination) {
      await destination.db.delete(destination.tableName);
    } else if (destination is CsvDestination) {
      if (await destination.file.exists()) {
        await destination.file.delete();
      }
    }
  }

  /// Create destination structure
  Future<void> _createDestinationStructure(
    DataSource source,
    DataDestination destination,
  ) async {
    if (destination is DatabaseDestination) {
      // Get source structure
      final columns = await _getSourceColumns(source);
      
      // Generate CREATE TABLE statement
      final columnDefs = columns.map((col) {
        final type = _mapDataType(col.type);
        final nullable = col.nullable ? '' : ' NOT NULL';
        return '${col.name} $type$nullable';
      }).join(', ');
      
      final createSql = 'CREATE TABLE IF NOT EXISTS ${destination.tableName} ($columnDefs)';
      await destination.db.execute(createSql);
    }
  }

  /// Map data types between systems
  String _mapDataType(String sourceType) {
    // Simplified type mapping
    final upper = sourceType.toUpperCase();
    if (upper.contains('INT')) return 'INTEGER';
    if (upper.contains('CHAR') || upper.contains('TEXT')) return 'TEXT';
    if (upper.contains('FLOAT') || upper.contains('DOUBLE')) return 'REAL';
    if (upper.contains('DATE') || upper.contains('TIME')) return 'TEXT';
    if (upper.contains('BOOL')) return 'INTEGER';
    return 'TEXT';
  }

  /// Emit progress update
  void _emitProgress(String message, double progress) {
    if (!_progressController.isClosed) {
      _progressController.add(PipelineProgress(
        message: message,
        progress: progress,
        processedRows: _processedRows,
        totalRows: _totalRows,
      ));
    }
  }

  /// Emit error
  void _emitError(String message, dynamic error) {
    if (!_errorController.isClosed) {
      _errorController.add(PipelineError(
        message: message,
        error: error,
        rowNumber: _processedRows,
      ));
    }
  }

  /// Clean up resources
  void dispose() {
    _progressController.close();
    _errorController.close();
  }
}

/// Pipeline types
enum PipelineType {
  tableToTable,
  queryToTable,
  fileToTable,
  tableToFile,
}

/// Data formats
enum DataFormat {
  database,
  csv,
  json,
  excel,
  xml,
}

/// Conflict resolution strategies
enum ConflictResolution {
  fail,     // Fail on conflict
  replace,  // Replace existing rows
  ignore,   // Skip conflicting rows
  append,   // Always append (may create duplicates)
}

/// Progress information
class PipelineProgress {
  final String message;
  final double progress;
  final int processedRows;
  final int totalRows;

  PipelineProgress({
    required this.message,
    required this.progress,
    required this.processedRows,
    required this.totalRows,
  });
}

/// Error information
class PipelineError {
  final String message;
  final dynamic error;
  final int? rowNumber;

  PipelineError({
    required this.message,
    required this.error,
    this.rowNumber,
  });
}

/// Pipeline execution result
class PipelineResult {
  final bool success;
  final int totalRows;
  final int processedRows;
  final int errorCount;
  final Duration duration;
  final String? error;

  PipelineResult({
    required this.success,
    required this.totalRows,
    required this.processedRows,
    required this.errorCount,
    required this.duration,
    this.error,
  });
}

/// Pipeline exception
class PipelineException implements Exception {
  final String message;

  PipelineException(this.message);

  @override
  String toString() => 'PipelineException: $message';
}

// Data source/destination interfaces
abstract class DataSource {}
abstract class DataDestination {}

{%- if has_database %}
class DatabaseSource extends DataSource {
  final Database db;
  final String query;

  DatabaseSource({required this.db, required this.query});
}

class DatabaseDestination extends DataDestination {
  final Database db;
  final String tableName;

  DatabaseDestination({required this.db, required this.tableName});
}
{%- endif %}

{%- if has_file_operations %}
class CsvSource extends DataSource {
  final List<String> headers;
  final List<List<dynamic>> rows;

  CsvSource({required this.headers, required this.rows});
}

class CsvDestination extends DataDestination {
  final File file;

  CsvDestination({required this.file});
}
{%- endif %}

// Helper classes
class ColumnInfo {
  final String name;
  final String type;
  final bool nullable;

  ColumnInfo({
    required this.name,
    required this.type,
    required this.nullable,
  });
}

class ColumnMapping {
  final String sourceName;
  final String destName;
  final String sourceType;
  final String destType;

  ColumnMapping({
    required this.sourceName,
    required this.destName,
    required this.sourceType,
    required this.destType,
  });
}