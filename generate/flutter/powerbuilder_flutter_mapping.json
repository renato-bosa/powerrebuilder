{
  "version": "1.0.0",
  "description": "PowerBuilder to Flutter/Dart mapping specification",
  "type_mappings": {
    "basic_types": {
      "integer": {
        "dart_type": "int",
        "nullable_syntax": "int?",
        "default_value": "0"
      },
      "long": {
        "dart_type": "int",
        "nullable_syntax": "int?",
        "default_value": "0"
      },
      "decimal": {
        "dart_type": "double",
        "nullable_syntax": "double?",
        "default_value": "0.0",
        "precision_package": "decimal"
      },
      "real": {
        "dart_type": "double",
        "nullable_syntax": "double?",
        "default_value": "0.0"
      },
      "double": {
        "dart_type": "double",
        "nullable_syntax": "double?",
        "default_value": "0.0"
      },
      "string": {
        "dart_type": "String",
        "nullable_syntax": "String?",
        "default_value": "''"
      },
      "char": {
        "dart_type": "String",
        "nullable_syntax": "String?",
        "default_value": "''"
      },
      "boolean": {
        "dart_type": "bool",
        "nullable_syntax": "bool?",
        "default_value": "false"
      },
      "date": {
        "dart_type": "DateTime",
        "nullable_syntax": "DateTime?",
        "default_value": "DateTime.now()"
      },
      "time": {
        "dart_type": "DateTime",
        "nullable_syntax": "DateTime?",
        "default_value": "DateTime.now()"
      },
      "datetime": {
        "dart_type": "DateTime",
        "nullable_syntax": "DateTime?",
        "default_value": "DateTime.now()"
      },
      "timestamp": {
        "dart_type": "DateTime",
        "nullable_syntax": "DateTime?",
        "default_value": "DateTime.now()"
      },
      "blob": {
        "dart_type": "Uint8List",
        "nullable_syntax": "Uint8List?",
        "default_value": "Uint8List(0)",
        "import": "dart:typed_data"
      },
      "any": {
        "dart_type": "dynamic",
        "nullable_syntax": "dynamic",
        "default_value": "null"
      }
    },
    "complex_types": {
      "array": {
        "dart_type": "List<{element_type}>",
        "nullable_syntax": "List<{element_type}>?",
        "default_value": "[]"
      },
      "structure": {
        "dart_type": "class",
        "pattern": "freezed",
        "nullable_syntax": "{class_name}?",
        "default_value": "null"
      },
      "powerobject": {
        "dart_type": "Object",
        "nullable_syntax": "Object?",
        "default_value": "null"
      },
      "nonvisualobject": {
        "dart_type": "Service",
        "pattern": "singleton",
        "nullable_syntax": "{service_name}?",
        "default_value": "null"
      },
      "datastore": {
        "dart_type": "Repository",
        "pattern": "repository",
        "nullable_syntax": "{repository_name}?",
        "default_value": "null"
      }
    }
  },
  "control_mappings": {
    "basic_controls": {
      "statictext": {
        "flutter_widget": "Text",
        "properties": {
          "text": "data",
          "font": "style",
          "alignment": "textAlign",
          "color": "style.color"
        }
      },
      "singlelineedit": {
        "flutter_widget": "TextField",
        "properties": {
          "text": "controller.text",
          "maxlength": "maxLength",
          "password": "obscureText",
          "enabled": "enabled",
          "readonly": "readOnly"
        },
        "requires": ["TextEditingController"]
      },
      "multilineedit": {
        "flutter_widget": "TextField",
        "properties": {
          "text": "controller.text",
          "maxlength": "maxLength",
          "enabled": "enabled",
          "readonly": "readOnly"
        },
        "config": {
          "maxLines": null,
          "minLines": 3
        },
        "requires": ["TextEditingController"]
      },
      "commandbutton": {
        "flutter_widget": "ElevatedButton",
        "properties": {
          "text": "child: Text(text)",
          "enabled": "onPressed != null",
          "default": "autofocus"
        },
        "events": {
          "clicked": "onPressed"
        }
      },
      "checkbox": {
        "flutter_widget": "Checkbox",
        "properties": {
          "checked": "value",
          "enabled": "onChanged != null",
          "text": "title (use CheckboxListTile)",
          "tristate": "tristate"
        },
        "events": {
          "clicked": "onChanged"
        }
      },
      "radiobutton": {
        "flutter_widget": "Radio",
        "properties": {
          "checked": "value == groupValue",
          "enabled": "onChanged != null",
          "text": "title (use RadioListTile)"
        },
        "events": {
          "clicked": "onChanged"
        }
      },
      "dropdownlistbox": {
        "flutter_widget": "DropdownButton",
        "properties": {
          "items": "items",
          "selected": "value",
          "enabled": "onChanged != null"
        },
        "events": {
          "selectionchanged": "onChanged"
        }
      },
      "listbox": {
        "flutter_widget": "ListView",
        "properties": {
          "items": "children",
          "multiselect": "selectionMode",
          "sorted": "sort items before building"
        },
        "builder_pattern": "ListView.builder"
      },
      "combobox": {
        "flutter_widget": "Autocomplete",
        "properties": {
          "items": "options",
          "text": "initialValue",
          "allowedit": "enabled"
        }
      },
      "picture": {
        "flutter_widget": "Image",
        "properties": {
          "picturename": "image source",
          "stretch": "fit"
        },
        "source_types": {
          "asset": "Image.asset",
          "network": "Image.network",
          "file": "Image.file",
          "memory": "Image.memory"
        }
      },
      "picturebutton": {
        "flutter_widget": "IconButton",
        "properties": {
          "picturename": "icon",
          "text": "tooltip",
          "enabled": "onPressed != null"
        },
        "events": {
          "clicked": "onPressed"
        }
      },
      "groupbox": {
        "flutter_widget": "Container",
        "child_widget": "Column",
        "properties": {
          "text": "use label above Container",
          "border": "decoration: BoxDecoration"
        }
      },
      "tab": {
        "flutter_widget": "TabBar",
        "view_widget": "TabBarView",
        "properties": {
          "tabs": "tabs",
          "selectedtab": "controller.index"
        },
        "requires": ["TabController"]
      }
    },
    "advanced_controls": {
      "treeview": {
        "flutter_widget": "TreeView",
        "package": "flutter_treeview",
        "properties": {
          "items": "nodes",
          "expanded": "controller.expandedNodes",
          "selected": "controller.selectedNode"
        }
      },
      "listview": {
        "flutter_widget": "ListView",
        "builder_pattern": "ListView.builder",
        "properties": {
          "items": "itemCount/itemBuilder",
          "columns": "custom ListTile"
        }
      },
      "datawindow": {
        "flutter_widget": "DataTable",
        "custom_widget": "DataWindowWidget",
        "properties": {
          "columns": "columns",
          "rows": "rows",
          "sorting": "sortColumnIndex/sortAscending"
        }
      },
      "graph": {
        "flutter_widget": "charts_flutter",
        "type_mapping": {
          "line": "LineChart",
          "bar": "BarChart",
          "pie": "PieChart",
          "area": "LineChart with area",
          "scatter": "ScatterPlotChart"
        }
      },
      "richtextedit": {
        "flutter_widget": "flutter_quill",
        "package": "flutter_quill",
        "properties": {
          "document": "controller.document",
          "toolbar": "QuillToolbar"
        }
      },
      "statichyperlink": {
        "flutter_widget": "StaticHyperlinkWidget",
        "custom_widget": true,
        "properties": {
          "text": "text",
          "url": "url",
          "enabled": "enabled",
          "textcolor": "color",
          "font": "textStyle"
        },
        "events": {
          "clicked": "onClicked"
        }
      },
      "spin": {
        "flutter_widget": "SpinBoxWidget",
        "custom_widget": true,
        "properties": {
          "value": "initialValue",
          "minvalue": "minValue",
          "maxvalue": "maxValue",
          "increment": "stepValue",
          "acceleration": "acceleration",
          "enabled": "enabled"
        },
        "events": {
          "modified": "onChanged"
        }
      },
      "drawobject": {
        "flutter_widget": "DrawObjectWidget",
        "custom_widget": true,
        "properties": {
          "drawtype": "drawingType",
          "fillcolor": "fillColor",
          "linecolor": "strokeColor",
          "linewidth": "strokeWidth",
          "fillpattern": "fillPattern",
          "points": "points"
        }
      }
    }
  },
  "event_mappings": {
    "window_events": {
      "open": {
        "flutter_method": "initState",
        "lifecycle": "initialization"
      },
      "close": {
        "flutter_method": "dispose",
        "lifecycle": "cleanup"
      },
      "activate": {
        "flutter_method": "didChangeAppLifecycleState",
        "state": "AppLifecycleState.resumed"
      },
      "deactivate": {
        "flutter_method": "didChangeAppLifecycleState",
        "state": "AppLifecycleState.paused"
      },
      "resize": {
        "flutter_widget": "LayoutBuilder",
        "callback": "builder"
      },
      "key": {
        "flutter_widget": "RawKeyboardListener",
        "callback": "onKey"
      },
      "timer": {
        "flutter_class": "Timer.periodic",
        "callback": "callback"
      }
    },
    "control_events": {
      "clicked": {
        "flutter_callback": "onPressed",
        "alternate": "onTap"
      },
      "doubleclicked": {
        "flutter_callback": "onDoubleTap",
        "gesture": "GestureDetector"
      },
      "rightclicked": {
        "flutter_callback": "onSecondaryTap",
        "gesture": "GestureDetector"
      },
      "getfocus": {
        "flutter_callback": "focusNode.addListener",
        "check": "focusNode.hasFocus"
      },
      "losefocus": {
        "flutter_callback": "focusNode.addListener",
        "check": "!focusNode.hasFocus"
      },
      "modified": {
        "flutter_callback": "onChanged",
        "widget_specific": true
      },
      "itemchanged": {
        "flutter_callback": "onChanged",
        "widget": "DropdownButton"
      },
      "selectionchanged": {
        "flutter_callback": "onSelectionChanged",
        "custom": true
      }
    },
    "datawindow_events": {
      "itemchanged": {
        "flutter_callback": "onCellEdit",
        "parameters": ["rowIndex", "columnName", "newValue"]
      },
      "itemerror": {
        "flutter_callback": "onValidationError",
        "parameters": ["rowIndex", "columnName", "value", "error"]
      },
      "itemfocuschanged": {
        "flutter_callback": "onCellFocusChanged",
        "parameters": ["rowIndex", "columnName"]
      },
      "retrieverow": {
        "flutter_pattern": "StreamBuilder",
        "stream": "dataStream"
      },
      "retrievestart": {
        "flutter_callback": "onLoadStart",
        "state": "isLoading = true"
      },
      "retrieveend": {
        "flutter_callback": "onLoadEnd",
        "state": "isLoading = false"
      },
      "updatestart": {
        "flutter_callback": "onSaveStart",
        "validation": true
      },
      "updateend": {
        "flutter_callback": "onSaveEnd",
        "parameters": ["success", "rowsAffected"]
      },
      "rowfocuschanged": {
        "flutter_callback": "onRowSelected",
        "parameters": ["rowIndex"]
      },
      "rowfocuschanging": {
        "flutter_callback": "onRowSelecting",
        "parameters": ["currentRow", "newRow"],
        "returns": "bool"
      }
    }
  },
  "object_mappings": {
    "window": {
      "flutter_type": "Screen",
      "base_class": "StatefulWidget",
      "naming": "{name}Screen",
      "file_pattern": "{snake_name}_screen.dart"
    },
    "userobject": {
      "flutter_type": "Widget",
      "base_class": "StatelessWidget or StatefulWidget",
      "naming": "{name}Widget",
      "file_pattern": "{snake_name}_widget.dart"
    },
    "menu": {
      "flutter_type": "Navigation",
      "patterns": ["Drawer", "BottomNavigationBar", "PopupMenu"],
      "naming": "{name}Navigation",
      "file_pattern": "{snake_name}_navigation.dart"
    },
    "function": {
      "flutter_type": "Method",
      "scope": ["static", "instance", "extension"],
      "async": "determine from SQL usage"
    },
    "query": {
      "flutter_type": "Repository method",
      "returns": "Future<List<T>> or Future<T?>",
      "naming": "{operation}{Entity}"
    },
    "structure": {
      "flutter_type": "Model",
      "pattern": "freezed",
      "naming": "{name}",
      "file_pattern": "{snake_name}.dart"
    },
    "nonvisualobject": {
      "flutter_type": "Service",
      "pattern": "singleton",
      "naming": "{name}Service",
      "file_pattern": "{snake_name}_service.dart"
    }
  },
  "datawindow_mappings": {
    "presentation_styles": {
      "grid": {
        "flutter_widget": "DataTable",
        "features": ["sorting", "pagination", "selection"],
        "responsive": "SingleChildScrollView horizontal"
      },
      "freeform": {
        "flutter_widget": "Form",
        "layout": "Column with fields",
        "features": ["validation", "submission"]
      },
      "tabular": {
        "flutter_widget": "ListView",
        "item_widget": "ListTile or custom",
        "features": ["swipe actions", "reordering"]
      },
      "group": {
        "flutter_widget": "GroupedListView",
        "package": "grouped_list",
        "features": ["expandable groups", "sticky headers"]
      },
      "crosstab": {
        "flutter_widget": "PivotTable",
        "custom": true,
        "features": ["row/column grouping", "aggregation"]
      },
      "graph": {
        "flutter_widget": "charts_flutter",
        "chart_types": ["line", "bar", "pie", "scatter"],
        "features": ["interactive", "animated"]
      },
      "composite": {
        "flutter_widget": "CustomMultiChildLayout",
        "features": ["nested datawindows", "master-detail"]
      },
      "richtext": {
        "flutter_widget": "RichText",
        "document_style": true,
        "features": ["formatting", "embedded objects"]
      }
    },
    "sql_operations": {
      "retrieve": {
        "flutter_pattern": "Repository.findAll()",
        "returns": "Future<List<T>>",
        "error_handling": "try-catch"
      },
      "insert": {
        "flutter_pattern": "Repository.create(T)",
        "returns": "Future<T>",
        "validation": "pre-save"
      },
      "update": {
        "flutter_pattern": "Repository.update(T)",
        "returns": "Future<T>",
        "optimistic_locking": "version field"
      },
      "delete": {
        "flutter_pattern": "Repository.delete(id)",
        "returns": "Future<void>",
        "cascade": "handle relations"
      }
    }
  },
  "state_management": {
    "patterns": {
      "local_state": {
        "solution": "StatefulWidget",
        "use_case": "UI-only state",
        "example": "form inputs, animation"
      },
      "shared_state": {
        "solution": "Provider/Riverpod",
        "use_case": "Cross-widget state",
        "example": "user session, theme"
      },
      "remote_state": {
        "solution": "Repository + FutureBuilder",
        "use_case": "Server data",
        "example": "API responses"
      },
      "complex_state": {
        "solution": "BLoC",
        "use_case": "Business logic",
        "example": "multi-step workflows"
      }
    },
    "powerbuilder_mappings": {
      "instance_variables": "State class fields",
      "shared_variables": "Static fields",
      "global_variables": "Provider state",
      "window_parameters": "Constructor parameters",
      "message_object": "Navigation arguments"
    }
  },
  "navigation": {
    "window_operations": {
      "open": {
        "flutter": "Navigator.push",
        "route_type": "MaterialPageRoute"
      },
      "opensheet": {
        "flutter": "showModalBottomSheet",
        "modal": true
      },
      "openwithparm": {
        "flutter": "Navigator.push",
        "arguments": "RouteSettings.arguments"
      },
      "close": {
        "flutter": "Navigator.pop",
        "result": "optional"
      },
      "closewithreturn": {
        "flutter": "Navigator.pop(result)",
        "result": "required"
      }
    },
    "patterns": {
      "named_routes": {
        "definition": "Route name mapping",
        "navigation": "Navigator.pushNamed"
      },
      "generated_routes": {
        "definition": "Route generator",
        "navigation": "onGenerateRoute"
      },
      "deep_linking": {
        "package": "go_router",
        "pattern": "URL-based routing"
      }
    }
  },
  "styling": {
    "property_mappings": {
      "backcolor": "backgroundColor",
      "textcolor": "foregroundColor",
      "font": "TextStyle",
      "border": "Border/BoxDecoration",
      "enabled": "enabled property",
      "visible": "Visibility widget",
      "transparent": "Opacity widget"
    },
    "theme_system": {
      "material": {
        "light": "ThemeData.light()",
        "dark": "ThemeData.dark()",
        "custom": "ThemeData.from()"
      },
      "cupertino": {
        "platform": "iOS style",
        "widgets": "Cupertino prefix"
      }
    }
  }
}