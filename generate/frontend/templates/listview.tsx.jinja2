import React from 'react';
import { Table, TableBody, TableCell, TableContainer, TableHead, TableRow, Paper, TableSortLabel } from '@mui/material';

interface {{ component.name }}Props {
  {%- if component.props %}
  {%- for prop in component.props %}
  {{ prop.name }}: {{ prop.type }};
  {%- endfor %}
  {%- endif %}
  columns: {
    id: string;
    label: string;
    width?: number;
    align?: 'left' | 'right' | 'center';
  }[];
  items: any[];
  onRowClick?: (item: any) => void;
  defaultSortColumn?: string;
  defaultSortDirection?: 'asc' | 'desc';
}

export const {{ component.name }} = ({
  {%- if component.props %}
  {%- for prop in component.props %}
  {{ prop.name }},
  {%- endfor %}
  {%- endif %}
  columns,
  items,
  onRowClick,
  defaultSortColumn,
  defaultSortDirection = 'asc',
}: {{ component.name }}Props) => {
  const [order, setOrder] = React.useState<'asc' | 'desc'>(defaultSortDirection);
  const [orderBy, setOrderBy] = React.useState<string>(defaultSortColumn || '');
  const [selected, setSelected] = React.useState<any[]>([]);

  const handleRequestSort = (property: string) => {
    const isAsc = orderBy === property && order === 'asc';
    setOrder(isAsc ? 'desc' : 'asc');
    setOrderBy(property);
  };

  const handleRowClick = (item: any) => {
    if (onRowClick) {
      onRowClick(item);
    }
  };

  // Sort items based on column and direction
  const sortedItems = React.useMemo(() => {
    if (!orderBy) return items;
    
    return [...items].sort((a, b) => {
      const aValue = a[orderBy];
      const bValue = b[orderBy];
      
      if (aValue < bValue) {
        return order === 'asc' ? -1 : 1;
      }
      if (aValue > bValue) {
        return order === 'asc' ? 1 : -1;
      }
      return 0;
    });
  }, [items, order, orderBy]);

  return (
    <TableContainer component={Paper} className="{{ component.name|lower }}">
      <Table size="medium">
        <TableHead>
          <TableRow>
            {columns.map((column) => (
              <TableCell
                key={column.id}
                align={column.align || 'left'}
                style={{ width: column.width || 'auto' }}
                sortDirection={orderBy === column.id ? order : false}
              >
                <TableSortLabel
                  active={orderBy === column.id}
                  direction={orderBy === column.id ? order : 'asc'}
                  onClick={() => handleRequestSort(column.id)}
                >
                  {column.label}
                </TableSortLabel>
              </TableCell>
            ))}
          </TableRow>
        </TableHead>
        <TableBody>
          {sortedItems.map((item, index) => (
            <TableRow
              key={item.id || index}
              hover
              onClick={() => handleRowClick(item)}
              style={{ cursor: onRowClick ? 'pointer' : 'default' }}
            >
              {columns.map((column) => (
                <TableCell key={column.id} align={column.align || 'left'}>
                  {item[column.id]}
                </TableCell>
              ))}
            </TableRow>
          ))}
          {sortedItems.length === 0 && (
            <TableRow>
              <TableCell colSpan={columns.length} align="center">
                No data
              </TableCell>
            </TableRow>
          )}
        </TableBody>
      </Table>
    </TableContainer>
  );
}; 