import React from 'react';
{%- for import_stmt in component.imports %}
{{ import_stmt }}
{%- endfor %}

{%- if component.props %}
interface {{ component.name }}Props {
  {%- for prop in component.props %}
  {{ prop.name }}: {{ prop.type }};
  {%- endfor %}
}
{%- endif %}

export const {{ component.name }} = ({
  {%- for prop in component.props %}
  {{ prop.name }}{% if not loop.last %},{% endif %}
  {%- endfor %}
}: {{ component.name }}Props) => {
  {%- if component.state %}
  {%- for state in component.state %}
  const [{{ state.name }}, set{{ state.name|capitalize }}] = React.useState{{ "<" + state.type + ">" if state.type }}({{ state.initial }});
  {%- endfor %}
  {%- endif %}
  
  {%- if component.effects %}
  {%- for effect in component.effects %}
  React.useEffect(() => {
    {{ effect.body }}
  }, [{{ effect.deps|join(", ") }}]);
  {%- endfor %}
  {%- endif %}
  
  return (
    <div className="{{ component.name|lower }}">
      {%- for control in component.controls %}
      {/* {{ control.name }} ({{ control.type }}) */}
      {%- if control.type == "input" %}
      <input
        type="{{ control.input_type }}"
        value={ {{ control.value }} }
        onChange={ e => {{ control.on_change }}(e.target.value) }
        placeholder="{{ control.placeholder }}"
        className="{{ control.class_name }}"
      />
      {%- elif control.type == "button" %}
      <button
        onClick={ {{ control.on_click }} }
        className="{{ control.class_name }}"
      >
        {{ control.text }}
      </button>
      {%- elif control.type == "text" %}
      <span className="{{ control.class_name }}">
        {{ control.text }}
      </span>
      {%- endif %}
      {%- endfor %}
    </div>
  );
}; 