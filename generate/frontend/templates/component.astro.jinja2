---
{%- if component.props %}
interface Props {
  {%- for prop in component.props %}
  {{ prop.name }}: {{ prop.type }};
  {%- endfor %}
}

const {
  {%- for prop in component.props %}
  {{ prop.name }}{% if not loop.last %},{% endif %}
  {%- endfor %}
} = Astro.props;
{%- endif %}

{%- for import_stmt in component.imports %}
{{ import_stmt }}
{%- endfor %}
---

<div class="{{ component.name|lower }}">
  {%- for control in component.controls %}
  {/* {{ control.name }} ({{ control.type }}) */}
  {%- if control.type == "input" %}
  <input
    type="{{ control.input_type }}"
    value={ {{ control.value }} }
    placeholder="{{ control.placeholder }}"
    class="{{ control.class_name }}"
    client:load
  />
  {%- elif control.type == "button" %}
  <button
    class="{{ control.class_name }}"
    client:load
  >
    {{ control.text }}
  </button>
  {%- elif control.type == "text" %}
  <span class="{{ control.class_name }}">
    {{ control.text }}
  </span>
  {%- endif %}
  {%- endfor %}
</div>

<style>
.{{ component.name|lower }} {
  {%- for style in component.styles %}
  {{ style.property }}: {{ style.value }};
  {%- endfor %}
}
</style>

<script>
{%- if component.client_script %}
{{ component.client_script }}
{%- endif %}
</script> 