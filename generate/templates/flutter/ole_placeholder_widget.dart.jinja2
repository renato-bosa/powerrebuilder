/// OLE Placeholder widget for PowerBuilder OLE controls
/// Since Flutter doesn't support OLE, this provides a placeholder with information
class {{ name }} extends StatefulWidget {
  // OLE information
  final String oleClassName;
  final String? oleProgId;
  final String? displayName;
  final String? description;
  final OleObjectType objectType;
  
  // Placeholder behavior
  final void Function()? onTap;
  final void Function()? onOpenExternal;
  final String? externalUrl;
  final String? documentPath;
  
  // Display options
  final IconData? icon;
  final String? iconAsset;
  final double? width;
  final double? height;
  final EdgeInsets? padding;
  final bool showDetails;
  final bool showActions;
  
  // Styling
  final Color? backgroundColor;
  final Color? iconColor;
  final TextStyle? titleStyle;
  final TextStyle? subtitleStyle;

  const {{ name }}({
    Key? key,
    required this.oleClassName,
    this.oleProgId,
    this.displayName,
    this.description,
    this.objectType = OleObjectType.embedded,
    this.onTap,
    this.onOpenExternal,
    this.externalUrl,
    this.documentPath,
    this.icon,
    this.iconAsset,
    this.width,
    this.height,
    this.padding,
    this.showDetails = true,
    this.showActions = true,
    this.backgroundColor,
    this.iconColor,
    this.titleStyle,
    this.subtitleStyle,
  }) : super(key: key);

  @override
  State<{{ name }}> createState() => _{{ name }}State();
}

class _{{ name }}State extends State<{{ name }}> with SingleTickerProviderStateMixin {
  late AnimationController _animationController;
  late Animation<double> _scaleAnimation;
  bool _isHovered = false;
  
  // Common OLE class to icon/description mappings
  static final Map<String, OleInfo> _oleClassInfo = {
    'Excel.Application': OleInfo(
      icon: CupertinoIcons.table,
      displayName: 'Microsoft Excel',
      description: 'Excel Spreadsheet',
      color: Color(0xFF107C41),
    ),
    'Word.Application': OleInfo(
      icon: CupertinoIcons.doc_text,
      displayName: 'Microsoft Word',
      description: 'Word Document',
      color: Color(0xFF2B579A),
    ),
    'PowerPoint.Application': OleInfo(
      icon: CupertinoIcons.play_rectangle,
      displayName: 'Microsoft PowerPoint',
      description: 'PowerPoint Presentation',
      color: Color(0xFFD24726),
    ),
    'MSComCtl.TreeCtrl': OleInfo(
      icon: CupertinoIcons.list_bullet_indent,
      displayName: 'TreeView Control',
      description: 'ActiveX TreeView',
      color: Color(0xFF0078D4),
    ),
    'MSComCtl.ListView': OleInfo(
      icon: CupertinoIcons.list_bullet,
      displayName: 'ListView Control',
      description: 'ActiveX ListView',
      color: Color(0xFF0078D4),
    ),
    'MSChart.Chart': OleInfo(
      icon: CupertinoIcons.chart_bar,
      displayName: 'Chart Control',
      description: 'Microsoft Chart',
      color: Color(0xFF107C41),
    ),
    'AcroPDF.PDF': OleInfo(
      icon: CupertinoIcons.doc_fill,
      displayName: 'Adobe PDF',
      description: 'PDF Document',
      color: Color(0xFFDC2626),
    ),
  };
  
  @override
  void initState() {
    super.initState();
    _animationController = AnimationController(
      duration: const Duration(milliseconds: 150),
      vsync: this,
    );
    _scaleAnimation = Tween<double>(
      begin: 1.0,
      end: 0.95,
    ).animate(CurvedAnimation(
      parent: _animationController,
      curve: Curves.easeInOut,
    ));
    {%- if init_code %}
    // Custom initialization
    {{ init_code | indent(4) }}
    {%- endif %}
  }
  
  @override
  void dispose() {
    _animationController.dispose();
    {%- if dispose_code %}
    // Custom disposal
    {{ dispose_code | indent(4) }}
    {%- endif %}
    super.dispose();
  }
  
  OleInfo _getOleInfo() {
    // Check by class name
    var info = _oleClassInfo[widget.oleClassName];
    if (info != null) return info;
    
    // Check by ProgID
    if (widget.oleProgId != null) {
      info = _oleClassInfo[widget.oleProgId!];
      if (info != null) return info;
    }
    
    // Default OLE info
    return OleInfo(
      icon: CupertinoIcons.doc_on_doc,
      displayName: widget.displayName ?? 'OLE Object',
      description: widget.description ?? widget.oleClassName,
      color: AppDesignSystem.infoColor,
    );
  }
  
  void _handleTap() {
    _animationController.forward().then((_) {
      _animationController.reverse();
    });
    widget.onTap?.call();
  }
  
  @override
  Widget build(BuildContext context) {
    final theme = Theme.of(context);
    final isDark = theme.brightness == Brightness.dark;
    final oleInfo = _getOleInfo();
    
    return MouseRegion(
      onEnter: (_) => setState(() => _isHovered = true),
      onExit: (_) => setState(() => _isHovered = false),
      child: GestureDetector(
        onTap: _handleTap,
        child: ScaleTransition(
          scale: _scaleAnimation,
          child: AnimatedContainer(
            duration: const Duration(milliseconds: 200),
            width: widget.width,
            height: widget.height,
            padding: widget.padding ?? const EdgeInsets.all(AppDesignSystem.space4),
            decoration: BoxDecoration(
              color: widget.backgroundColor ?? 
                  (isDark ? AppDesignSystem.darkSurfaceColor : AppDesignSystem.surfaceColor),
              borderRadius: BorderRadius.circular(AppDesignSystem.radiusLg),
              border: Border.all(
                color: _isHovered 
                    ? oleInfo.color.withOpacity(0.3)
                    : (isDark ? AppDesignSystem.darkBorderColor : AppDesignSystem.borderColor),
                width: _isHovered ? 2 : 1,
              ),
              boxShadow: _isHovered
                  ? [
                      BoxShadow(
                        color: oleInfo.color.withOpacity(0.1),
                        blurRadius: 20,
                        spreadRadius: 2,
                      ),
                    ]
                  : null,
            ),
            child: Column(
              mainAxisAlignment: MainAxisAlignment.center,
              children: [
                // Icon
                Container(
                  width: 80,
                  height: 80,
                  decoration: BoxDecoration(
                    color: oleInfo.color.withOpacity(0.1),
                    shape: BoxShape.circle,
                  ),
                  child: Center(
                    child: widget.iconAsset != null
                        ? Image.asset(
                            widget.iconAsset!,
                            width: 48,
                            height: 48,
                            color: widget.iconColor ?? oleInfo.color,
                          )
                        : Icon(
                            widget.icon ?? oleInfo.icon,
                            size: 48,
                            color: widget.iconColor ?? oleInfo.color,
                          ),
                  ),
                ),
                
                const SizedBox(height: AppDesignSystem.space4),
                
                // Title
                Text(
                  oleInfo.displayName,
                  style: widget.titleStyle ?? AppDesignSystem.headlineMedium.copyWith(
                    color: isDark ? AppDesignSystem.darkTextPrimary : AppDesignSystem.textPrimary,
                  ),
                  textAlign: TextAlign.center,
                ),
                
                if (widget.showDetails) ...[
                  const SizedBox(height: AppDesignSystem.space2),
                  
                  // Subtitle
                  Text(
                    oleInfo.description,
                    style: widget.subtitleStyle ?? AppDesignSystem.bodyMedium.copyWith(
                      color: isDark ? AppDesignSystem.darkTextSecondary : AppDesignSystem.textSecondary,
                    ),
                    textAlign: TextAlign.center,
                  ),
                  
                  const SizedBox(height: AppDesignSystem.space1),
                  
                  // Technical details
                  Container(
                    padding: const EdgeInsets.symmetric(
                      horizontal: AppDesignSystem.space3,
                      vertical: AppDesignSystem.space2,
                    ),
                    decoration: BoxDecoration(
                      color: isDark 
                          ? AppDesignSystem.darkBackgroundSecondary 
                          : AppDesignSystem.backgroundSecondary,
                      borderRadius: BorderRadius.circular(AppDesignSystem.radiusSm),
                    ),
                    child: Text(
                      'Type: ${widget.objectType.name.toUpperCase()}',
                      style: AppDesignSystem.caption.copyWith(
                        color: isDark 
                            ? AppDesignSystem.darkTextSecondary 
                            : AppDesignSystem.textSecondary,
                        fontFamily: 'monospace',
                      ),
                    ),
                  ),
                ],
                
                if (widget.showActions && (widget.onOpenExternal != null || widget.externalUrl != null)) ...[
                  const SizedBox(height: AppDesignSystem.space4),
                  
                  // Action buttons
                  Row(
                    mainAxisSize: MainAxisSize.min,
                    children: [
                      if (widget.onOpenExternal != null)
                        ElevatedButton.icon(
                          onPressed: widget.onOpenExternal,
                          icon: Icon(CupertinoIcons.arrow_up_right_square, size: 18),
                          label: Text('Open External'),
                          style: AppDesignSystem.primaryButtonStyle(context),
                        ),
                      if (widget.externalUrl != null && widget.onOpenExternal != null)
                        const SizedBox(width: AppDesignSystem.space3),
                      if (widget.externalUrl != null)
                        OutlinedButton.icon(
                          onPressed: () {
                            // TODO: Implement URL launching
                          },
                          icon: Icon(CupertinoIcons.link, size: 18),
                          label: Text('View Online'),
                          style: OutlinedButton.styleFrom(
                            foregroundColor: oleInfo.color,
                            side: BorderSide(color: oleInfo.color),
                          ),
                        ),
                    ],
                  ),
                ],
                
                const SizedBox(height: AppDesignSystem.space4),
                
                // Informational message
                Container(
                  padding: const EdgeInsets.all(AppDesignSystem.space3),
                  decoration: BoxDecoration(
                    color: AppDesignSystem.warningColor.withOpacity(0.1),
                    borderRadius: BorderRadius.circular(AppDesignSystem.radiusSm),
                    border: Border.all(
                      color: AppDesignSystem.warningColor.withOpacity(0.3),
                    ),
                  ),
                  child: Row(
                    mainAxisSize: MainAxisSize.min,
                    children: [
                      Icon(
                        CupertinoIcons.info_circle,
                        size: 16,
                        color: AppDesignSystem.warningColor,
                      ),
                      const SizedBox(width: AppDesignSystem.space2),
                      Flexible(
                        child: Text(
                          'OLE controls are not supported in Flutter.\nThis is a placeholder representation.',
                          style: AppDesignSystem.caption.copyWith(
                            color: isDark 
                                ? AppDesignSystem.darkTextPrimary 
                                : AppDesignSystem.textPrimary,
                          ),
                          textAlign: TextAlign.center,
                        ),
                      ),
                    ],
                  ),
                ),
              ],
            ),
          ),
        ),
      ),
    );
  }
  
  {%- if methods %}
  // Custom methods
  {%- for method in methods %}
  {{ method.return_type }} {{ method.name }}({{ method.params }}) {
    {{ method.body | indent(4) }}
  }
  {%- endfor %}
  {%- endif %}
}

/// OLE object types
enum OleObjectType {
  embedded,
  linked,
  control,
}

/// OLE class information
class OleInfo {
  final IconData icon;
  final String displayName;
  final String description;
  final Color color;
  
  const OleInfo({
    required this.icon,
    required this.displayName,
    required this.description,
    required this.color,
  });
}