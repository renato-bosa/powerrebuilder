{% extends "widget.dart.jinja2" %}

{% block imports %}
import 'package:flutter/material.dart';
import 'package:flutter/gestures.dart';
import 'package:url_launcher/url_launcher.dart';
import '../core/app_design_system.dart';
{% endblock %}

{% block widget_state %}
  bool _isHovered = false;
  bool _isPressed = false;
  
  Future<void> _launchUrl() async {
    if (!widget.enabled || widget.url == null) return;
    
    final uri = Uri.tryParse(widget.url!);
    if (uri == null) {
      debugPrint('Invalid URL: ${widget.url}');
      return;
    }
    
    try {
      if (await canLaunchUrl(uri)) {
        await launchUrl(
          uri,
          mode: widget.openInBrowser 
              ? LaunchMode.externalApplication 
              : LaunchMode.platformDefault,
        );
        widget.onClicked?.call();
      } else {
        debugPrint('Could not launch URL: ${widget.url}');
        widget.onError?.call('Could not launch URL');
      }
    } catch (e) {
      debugPrint('Error launching URL: $e');
      widget.onError?.call(e.toString());
    }
  }
  
  void _handleTapDown(TapDownDetails details) {
    if (widget.enabled) {
      setState(() {
        _isPressed = true;
      });
    }
  }
  
  void _handleTapUp(TapUpDetails details) {
    setState(() {
      _isPressed = false;
    });
  }
  
  void _handleTapCancel() {
    setState(() {
      _isPressed = false;
    });
  }
  
  void _handleHover(bool hovering) {
    if (widget.enabled) {
      setState(() {
        _isHovered = hovering;
      });
    }
  }
{% endblock %}

{% block build_method %}
  @override
  Widget build(BuildContext context) {
    final theme = Theme.of(context);
    final design = AppDesignSystem.of(context);
    final isDark = theme.brightness == Brightness.dark;
    
    // Determine text color
    Color textColor;
    if (!widget.enabled) {
      textColor = design.textDisabled;
    } else if (_isPressed) {
      textColor = widget.pressedColor ?? design.primaryDark;
    } else if (_isHovered) {
      textColor = widget.hoverColor ?? design.primaryLight;
    } else {
      textColor = widget.color ?? design.primary;
    }
    
    // Build text style
    final textStyle = TextStyle(
      color: textColor,
      fontSize: widget.fontSize ?? design.fontSizeBody,
      fontWeight: widget.bold ? FontWeight.bold : FontWeight.normal,
      fontStyle: widget.italic ? FontStyle.italic : FontStyle.normal,
      decoration: widget.underline ? TextDecoration.underline : TextDecoration.none,
      decorationColor: textColor,
    );
    
    Widget linkContent = Text(
      widget.text ?? widget.url ?? 'Link',
      style: textStyle,
      textAlign: widget.alignment,
    );
    
    // Add icon if specified
    if (widget.icon != null) {
      linkContent = Row(
        mainAxisSize: MainAxisSize.min,
        children: [
          if (widget.iconPosition == IconPosition.left) ...[
            Icon(
              widget.icon,
              size: widget.iconSize ?? 16,
              color: textColor,
            ),
            const SizedBox(width: 4),
          ],
          linkContent,
          if (widget.iconPosition == IconPosition.right) ...[
            const SizedBox(width: 4),
            Icon(
              widget.icon,
              size: widget.iconSize ?? 16,
              color: textColor,
            ),
          ],
        ],
      );
    }
    
    // Add tooltip if specified
    if (widget.tooltip != null) {
      linkContent = Tooltip(
        message: widget.tooltip!,
        child: linkContent,
      );
    }
    
    return MouseRegion(
      cursor: widget.enabled 
          ? SystemMouseCursors.click 
          : SystemMouseCursors.basic,
      onEnter: (_) => _handleHover(true),
      onExit: (_) => _handleHover(false),
      child: GestureDetector(
        onTap: widget.enabled ? _launchUrl : null,
        onTapDown: _handleTapDown,
        onTapUp: _handleTapUp,
        onTapCancel: _handleTapCancel,
        child: Container(
          padding: widget.padding,
          decoration: widget.showBackground
              ? BoxDecoration(
                  color: _isPressed
                      ? design.surfaceVariantLight.withOpacity(0.1)
                      : null,
                  borderRadius: BorderRadius.circular(design.radiusSmall),
                )
              : null,
          child: linkContent,
        ),
      ),
    );
  }
{% endblock %}

{% block widget_class %}
enum IconPosition { left, right }

class {{ widget_name }} extends StatefulWidget {
  final String? text;
  final String? url;
  final bool enabled;
  final Color? color;
  final Color? hoverColor;
  final Color? pressedColor;
  final double? fontSize;
  final bool bold;
  final bool italic;
  final bool underline;
  final TextAlign? alignment;
  final IconData? icon;
  final IconPosition iconPosition;
  final double? iconSize;
  final String? tooltip;
  final EdgeInsetsGeometry? padding;
  final bool showBackground;
  final bool openInBrowser;
  final VoidCallback? onClicked;
  final ValueChanged<String>? onError;
  
  const {{ widget_name }}({
    super.key,
    this.text,
    this.url,
    this.enabled = true,
    this.color,
    this.hoverColor,
    this.pressedColor,
    this.fontSize,
    this.bold = false,
    this.italic = false,
    this.underline = true,
    this.alignment,
    this.icon,
    this.iconPosition = IconPosition.right,
    this.iconSize,
    this.tooltip,
    this.padding,
    this.showBackground = false,
    this.openInBrowser = false,
    this.onClicked,
    this.onError,
  });
  
  @override
  State<{{ widget_name }}> createState() => _{{ widget_name }}State();
}
{% endblock %}