/// TreeView widget converted from PowerBuilder
/// Provides hierarchical data display with expand/collapse functionality
class {{ name }} extends StatefulWidget {
  // Data
  final List<TreeNode> nodes;
  final String Function(TreeNode)? getNodeLabel;
  final IconData Function(TreeNode)? getNodeIcon;
  
  // Behavior
  final void Function(TreeNode)? onNodeTap;
  final void Function(TreeNode)? onNodeDoubleTap;
  final void Function(TreeNode)? onNodeExpanded;
  final void Function(TreeNode)? onNodeCollapsed;
  final bool Function(TreeNode)? canSelectNode;
  
  // Display options
  final bool showLines;
  final bool showIcons;
  final bool showCheckboxes;
  final bool allowMultiSelect;
  final double indentWidth;
  final EdgeInsets? padding;
  
  // Styling
  final TextStyle? nodeTextStyle;
  final Color? selectedColor;
  final Color? lineColor;

  const {{ name }}({
    Key? key,
    required this.nodes,
    this.getNodeLabel,
    this.getNodeIcon,
    this.onNodeTap,
    this.onNodeDoubleTap,
    this.onNodeExpanded,
    this.onNodeCollapsed,
    this.canSelectNode,
    this.showLines = true,
    this.showIcons = true,
    this.showCheckboxes = false,
    this.allowMultiSelect = false,
    this.indentWidth = 24.0,
    this.padding,
    this.nodeTextStyle,
    this.selectedColor,
    this.lineColor,
  }) : super(key: key);

  @override
  State<{{ name }}> createState() => _{{ name }}State();
}

class _{{ name }}State extends State<{{ name }}> with TickerProviderStateMixin {
  final Set<String> _expandedNodes = {};
  final Set<String> _selectedNodes = {};
  final Set<String> _checkedNodes = {};
  final Map<String, AnimationController> _animationControllers = {};
  
  @override
  void initState() {
    super.initState();
    // Initialize expanded state from nodes
    _initializeExpandedState(widget.nodes);
    {%- if init_code %}
    // Custom initialization
    {{ init_code | indent(4) }}
    {%- endif %}
  }
  
  @override
  void dispose() {
    // Dispose all animation controllers
    for (final controller in _animationControllers.values) {
      controller.dispose();
    }
    {%- if dispose_code %}
    // Custom disposal
    {{ dispose_code | indent(4) }}
    {%- endif %}
    super.dispose();
  }
  
  void _initializeExpandedState(List<TreeNode> nodes) {
    for (final node in nodes) {
      if (node.expanded) {
        _expandedNodes.add(node.id);
      }
      if (node.children.isNotEmpty) {
        _initializeExpandedState(node.children);
      }
    }
  }
  
  AnimationController _getAnimationController(String nodeId) {
    if (!_animationControllers.containsKey(nodeId)) {
      _animationControllers[nodeId] = AnimationController(
        duration: const Duration(milliseconds: 200),
        vsync: this,
      );
      if (_expandedNodes.contains(nodeId)) {
        _animationControllers[nodeId]!.value = 1.0;
      }
    }
    return _animationControllers[nodeId]!;
  }
  
  void _toggleNode(TreeNode node) {
    setState(() {
      if (_expandedNodes.contains(node.id)) {
        _expandedNodes.remove(node.id);
        _getAnimationController(node.id).reverse();
        widget.onNodeCollapsed?.call(node);
      } else {
        _expandedNodes.add(node.id);
        _getAnimationController(node.id).forward();
        widget.onNodeExpanded?.call(node);
      }
    });
  }
  
  void _selectNode(TreeNode node) {
    if (widget.canSelectNode?.call(node) ?? true) {
      setState(() {
        if (widget.allowMultiSelect) {
          if (_selectedNodes.contains(node.id)) {
            _selectedNodes.remove(node.id);
          } else {
            _selectedNodes.add(node.id);
          }
        } else {
          _selectedNodes.clear();
          _selectedNodes.add(node.id);
        }
      });
      widget.onNodeTap?.call(node);
    }
  }
  
  void _toggleCheckbox(TreeNode node) {
    setState(() {
      if (_checkedNodes.contains(node.id)) {
        _checkedNodes.remove(node.id);
        // Uncheck all children
        _uncheckChildren(node);
      } else {
        _checkedNodes.add(node.id);
        // Check all children
        _checkChildren(node);
      }
    });
  }
  
  void _checkChildren(TreeNode node) {
    for (final child in node.children) {
      _checkedNodes.add(child.id);
      _checkChildren(child);
    }
  }
  
  void _uncheckChildren(TreeNode node) {
    for (final child in node.children) {
      _checkedNodes.remove(child.id);
      _uncheckChildren(child);
    }
  }

  @override
  Widget build(BuildContext context) {
    final theme = Theme.of(context);
    final isDark = theme.brightness == Brightness.dark;
    
    return Container(
      padding: widget.padding ?? const EdgeInsets.all(AppDesignSystem.space4),
      decoration: AppDesignSystem.containerDecoration(
        color: isDark ? AppDesignSystem.darkSurfaceColor : AppDesignSystem.surfaceColor,
        radius: AppDesignSystem.radiusLg,
      ),
      child: SingleChildScrollView(
        child: Column(
          crossAxisAlignment: CrossAxisAlignment.start,
          children: _buildNodes(widget.nodes, 0, isDark),
        ),
      ),
    );
  }
  
  List<Widget> _buildNodes(List<TreeNode> nodes, int depth, bool isDark) {
    final widgets = <Widget>[];
    
    for (int i = 0; i < nodes.length; i++) {
      final node = nodes[i];
      final isLast = i == nodes.length - 1;
      final hasChildren = node.children.isNotEmpty;
      final isExpanded = _expandedNodes.contains(node.id);
      final isSelected = _selectedNodes.contains(node.id);
      final isChecked = _checkedNodes.contains(node.id);
      
      // Build node widget
      widgets.add(
        GestureDetector(
          onTap: () => _selectNode(node),
          onDoubleTap: widget.onNodeDoubleTap != null 
              ? () => widget.onNodeDoubleTap!(node) 
              : null,
          child: Container(
            padding: EdgeInsets.only(
              left: depth * widget.indentWidth,
              top: AppDesignSystem.space2,
              bottom: AppDesignSystem.space2,
            ),
            color: isSelected 
                ? (widget.selectedColor ?? AppDesignSystem.primaryColor.withOpacity(0.1))
                : Colors.transparent,
            child: Row(
              children: [
                // Expand/collapse button
                if (hasChildren)
                  _buildExpandButton(node, isExpanded, isDark)
                else
                  SizedBox(width: 24),
                
                // Checkbox
                if (widget.showCheckboxes) ...[
                  Checkbox(
                    value: isChecked,
                    onChanged: (_) => _toggleCheckbox(node),
                    shape: RoundedRectangleBorder(
                      borderRadius: BorderRadius.circular(AppDesignSystem.radiusXs),
                    ),
                    side: BorderSide(
                      color: isDark ? AppDesignSystem.darkBorderColor : AppDesignSystem.borderColor,
                      width: 1.5,
                    ),
                    activeColor: AppDesignSystem.primaryColor,
                  ),
                  const SizedBox(width: AppDesignSystem.space2),
                ],
                
                // Icon
                if (widget.showIcons) ...[
                  Icon(
                    widget.getNodeIcon?.call(node) ?? 
                        (hasChildren 
                            ? (isExpanded ? CupertinoIcons.folder_open : CupertinoIcons.folder)
                            : CupertinoIcons.doc),
                    size: 18,
                    color: isDark ? AppDesignSystem.darkTextSecondary : AppDesignSystem.textSecondary,
                  ),
                  const SizedBox(width: AppDesignSystem.space2),
                ],
                
                // Label
                Expanded(
                  child: Text(
                    widget.getNodeLabel?.call(node) ?? node.label,
                    style: (widget.nodeTextStyle ?? AppDesignSystem.bodyMedium).copyWith(
                      color: isDark ? AppDesignSystem.darkTextPrimary : AppDesignSystem.textPrimary,
                    ),
                  ),
                ),
                
                // Node data/value if provided
                if (node.data != null) ...[
                  const SizedBox(width: AppDesignSystem.space3),
                  Text(
                    node.data.toString(),
                    style: AppDesignSystem.caption.copyWith(
                      color: isDark ? AppDesignSystem.darkTextSecondary : AppDesignSystem.textSecondary,
                    ),
                  ),
                ],
              ],
            ),
          ),
        ),
      );
      
      // Build children with animation
      if (hasChildren) {
        widgets.add(
          SizeTransition(
            sizeFactor: CurvedAnimation(
              parent: _getAnimationController(node.id),
              curve: Curves.easeInOut,
            ),
            child: Column(
              crossAxisAlignment: CrossAxisAlignment.start,
              children: _buildNodes(node.children, depth + 1, isDark),
            ),
          ),
        );
      }
    }
    
    return widgets;
  }
  
  Widget _buildExpandButton(TreeNode node, bool isExpanded, bool isDark) {
    return GestureDetector(
      onTap: () => _toggleNode(node),
      child: Container(
        width: 24,
        height: 24,
        alignment: Alignment.center,
        child: AnimatedRotation(
          turns: isExpanded ? 0.25 : 0,
          duration: const Duration(milliseconds: 200),
          child: Icon(
            CupertinoIcons.chevron_right,
            size: 14,
            color: isDark ? AppDesignSystem.darkTextSecondary : AppDesignSystem.textSecondary,
          ),
        ),
      ),
    );
  }
}

/// TreeNode data model
class TreeNode {
  final String id;
  final String label;
  final List<TreeNode> children;
  final dynamic data;
  final bool expanded;
  
  TreeNode({
    required this.id,
    required this.label,
    this.children = const [],
    this.data,
    this.expanded = false,
  });
}