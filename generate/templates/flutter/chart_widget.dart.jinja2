/// Chart widget converted from PowerBuilder Graph control
/// Supports line, bar, pie, and scatter charts
class {{ name }} extends StatefulWidget {
  // Chart configuration
  final ChartType chartType;
  final List<ChartSeries> series;
  final String? title;
  final String? xAxisLabel;
  final String? yAxisLabel;
  
  // Display options
  final bool showLegend;
  final bool showGrid;
  final bool showTooltips;
  final bool animate;
  final Duration animationDuration;
  
  // Interaction
  final void Function(int, ChartDataPoint)? onPointTap;
  final void Function(int, ChartDataPoint)? onPointHover;
  
  // Styling
  final double? height;
  final EdgeInsets? padding;
  final TextStyle? titleStyle;
  final TextStyle? labelStyle;

  const {{ name }}({
    Key? key,
    required this.chartType,
    required this.series,
    this.title,
    this.xAxisLabel,
    this.yAxisLabel,
    this.showLegend = true,
    this.showGrid = true,
    this.showTooltips = true,
    this.animate = true,
    this.animationDuration = const Duration(milliseconds: 750),
    this.onPointTap,
    this.onPointHover,
    this.height,
    this.padding,
    this.titleStyle,
    this.labelStyle,
  }) : super(key: key);

  @override
  State<{{ name }}> createState() => _{{ name }}State();
}

class _{{ name }}State extends State<{{ name }}> with TickerProviderStateMixin {
  late AnimationController _animationController;
  int? _selectedSeriesIndex;
  int? _selectedPointIndex;
  
  @override
  void initState() {
    super.initState();
    _animationController = AnimationController(
      duration: widget.animationDuration,
      vsync: this,
    );
    if (widget.animate) {
      _animationController.forward();
    }
    {%- if init_code %}
    // Custom initialization
    {{ init_code | indent(4) }}
    {%- endif %}
  }
  
  @override
  void dispose() {
    _animationController.dispose();
    {%- if dispose_code %}
    // Custom disposal
    {{ dispose_code | indent(4) }}
    {%- endif %}
    super.dispose();
  }
  
  @override
  Widget build(BuildContext context) {
    final theme = Theme.of(context);
    final isDark = theme.brightness == Brightness.dark;
    
    return Container(
      height: widget.height ?? 300,
      padding: widget.padding ?? const EdgeInsets.all(AppDesignSystem.space4),
      decoration: AppDesignSystem.containerDecoration(
        color: isDark ? AppDesignSystem.darkSurfaceColor : AppDesignSystem.surfaceColor,
        radius: AppDesignSystem.radiusLg,
      ),
      child: Column(
        crossAxisAlignment: CrossAxisAlignment.stretch,
        children: [
          if (widget.title != null) ...[
            Text(
              widget.title!,
              style: widget.titleStyle ?? AppDesignSystem.headlineMedium.copyWith(
                color: isDark ? AppDesignSystem.darkTextPrimary : AppDesignSystem.textPrimary,
              ),
              textAlign: TextAlign.center,
            ),
            const SizedBox(height: AppDesignSystem.space4),
          ],
          Expanded(
            child: _buildChart(isDark),
          ),
          if (widget.showLegend) ...[
            const SizedBox(height: AppDesignSystem.space4),
            _buildLegend(isDark),
          ],
        ],
      ),
    );
  }
  
  Widget _buildChart(bool isDark) {
    switch (widget.chartType) {
      case ChartType.line:
        return _buildLineChart(isDark);
      case ChartType.bar:
        return _buildBarChart(isDark);
      case ChartType.pie:
        return _buildPieChart(isDark);
      case ChartType.scatter:
        return _buildScatterChart(isDark);
      default:
        return const Center(child: Text('Unsupported chart type'));
    }
  }
  
  Widget _buildLineChart(bool isDark) {
    return LineChart(
      LineChartData(
        lineBarsData: widget.series.map((series) {
          final seriesIndex = widget.series.indexOf(series);
          return LineChartBarData(
            spots: series.data.map((point) {
              return FlSpot(point.x.toDouble(), point.y.toDouble());
            }).toList(),
            isCurved: true,
            color: series.color ?? _getSeriesColor(seriesIndex),
            barWidth: 3,
            isStrokeCapRound: true,
            dotData: FlDotData(
              show: true,
              getDotPainter: (spot, percent, barData, index) {
                return FlDotCirclePainter(
                  radius: 4,
                  color: series.color ?? _getSeriesColor(seriesIndex),
                  strokeWidth: 2,
                  strokeColor: isDark ? AppDesignSystem.darkSurfaceColor : AppDesignSystem.surfaceColor,
                );
              },
            ),
            belowBarData: BarAreaData(
              show: true,
              color: (series.color ?? _getSeriesColor(seriesIndex)).withOpacity(0.1),
            ),
          );
        }).toList(),
        titlesData: _getFlTitlesData(isDark),
        gridData: FlGridData(
          show: widget.showGrid,
          drawVerticalLine: true,
          getDrawingHorizontalLine: (value) {
            return FlLine(
              color: isDark 
                  ? AppDesignSystem.darkBorderColor.withOpacity(0.3)
                  : AppDesignSystem.borderColor.withOpacity(0.3),
              strokeWidth: 1,
            );
          },
          getDrawingVerticalLine: (value) {
            return FlLine(
              color: isDark 
                  ? AppDesignSystem.darkBorderColor.withOpacity(0.3)
                  : AppDesignSystem.borderColor.withOpacity(0.3),
              strokeWidth: 1,
            );
          },
        ),
        borderData: FlBorderData(
          show: true,
          border: Border.all(
            color: isDark ? AppDesignSystem.darkBorderColor : AppDesignSystem.borderColor,
            width: 1,
          ),
        ),
        lineTouchData: LineTouchData(
          enabled: widget.showTooltips,
          touchCallback: (event, response) {
            if (event is FlTapUpEvent && response?.lineBarSpots != null) {
              final spot = response!.lineBarSpots!.first;
              final seriesIndex = spot.barIndex;
              final pointIndex = spot.spotIndex;
              final point = widget.series[seriesIndex].data[pointIndex];
              widget.onPointTap?.call(seriesIndex, point);
            }
          },
          touchTooltipData: LineTouchTooltipData(
            tooltipBgColor: isDark 
                ? AppDesignSystem.darkBackgroundSecondary 
                : AppDesignSystem.backgroundSecondary,
            getTooltipItems: (touchedSpots) {
              return touchedSpots.map((spot) {
                final series = widget.series[spot.barIndex];
                return LineTooltipItem(
                  '${series.name}: ${spot.y.toStringAsFixed(2)}',
                  AppDesignSystem.caption.copyWith(
                    color: isDark ? AppDesignSystem.darkTextPrimary : AppDesignSystem.textPrimary,
                  ),
                );
              }).toList();
            },
          ),
        ),
      ),
      swapAnimationDuration: widget.animationDuration,
      swapAnimationCurve: Curves.easeInOut,
    );
  }
  
  Widget _buildBarChart(bool isDark) {
    return BarChart(
      BarChartData(
        barGroups: _generateBarGroups(),
        titlesData: _getFlTitlesData(isDark),
        gridData: FlGridData(
          show: widget.showGrid,
          drawVerticalLine: false,
          getDrawingHorizontalLine: (value) {
            return FlLine(
              color: isDark 
                  ? AppDesignSystem.darkBorderColor.withOpacity(0.3)
                  : AppDesignSystem.borderColor.withOpacity(0.3),
              strokeWidth: 1,
            );
          },
        ),
        borderData: FlBorderData(
          show: true,
          border: Border(
            bottom: BorderSide(
              color: isDark ? AppDesignSystem.darkBorderColor : AppDesignSystem.borderColor,
              width: 1,
            ),
            left: BorderSide(
              color: isDark ? AppDesignSystem.darkBorderColor : AppDesignSystem.borderColor,
              width: 1,
            ),
          ),
        ),
        barTouchData: BarTouchData(
          enabled: widget.showTooltips,
          touchCallback: (event, response) {
            if (event is FlTapUpEvent && response?.spot != null) {
              final groupIndex = response!.spot!.touchedBarGroupIndex;
              final rodIndex = response.spot!.touchedRodDataIndex;
              if (groupIndex >= 0 && rodIndex >= 0) {
                final point = widget.series[rodIndex].data[groupIndex];
                widget.onPointTap?.call(rodIndex, point);
              }
            }
          },
          touchTooltipData: BarTouchTooltipData(
            tooltipBgColor: isDark 
                ? AppDesignSystem.darkBackgroundSecondary 
                : AppDesignSystem.backgroundSecondary,
            getTooltipItem: (group, groupIndex, rod, rodIndex) {
              final series = widget.series[rodIndex];
              return BarTooltipItem(
                '${series.name}\n',
                AppDesignSystem.caption.copyWith(
                  color: isDark ? AppDesignSystem.darkTextPrimary : AppDesignSystem.textPrimary,
                ),
                children: [
                  TextSpan(
                    text: rod.toY.toStringAsFixed(2),
                    style: AppDesignSystem.bodyMedium.copyWith(
                      color: isDark ? AppDesignSystem.darkTextPrimary : AppDesignSystem.textPrimary,
                      fontWeight: FontWeight.bold,
                    ),
                  ),
                ],
              );
            },
          ),
        ),
      ),
      swapAnimationDuration: widget.animationDuration,
      swapAnimationCurve: Curves.easeInOut,
    );
  }
  
  Widget _buildPieChart(bool isDark) {
    final firstSeries = widget.series.first;
    return PieChart(
      PieChartData(
        sections: firstSeries.data.asMap().entries.map((entry) {
          final index = entry.key;
          final point = entry.value;
          final isSelected = _selectedPointIndex == index;
          
          return PieChartSectionData(
            value: point.y,
            title: point.label ?? point.y.toStringAsFixed(0),
            color: _getSeriesColor(index),
            radius: isSelected ? 110 : 100,
            titleStyle: AppDesignSystem.caption.copyWith(
              color: Colors.white,
              fontWeight: FontWeight.bold,
            ),
            titlePositionPercentageOffset: 0.7,
          );
        }).toList(),
        sectionsSpace: 2,
        centerSpaceRadius: 40,
        pieTouchData: PieTouchData(
          enabled: widget.showTooltips,
          touchCallback: (event, response) {
            setState(() {
              if (event is FlTapUpEvent && response?.touchedSection != null) {
                final index = response!.touchedSection!.touchedSectionIndex;
                if (index >= 0) {
                  _selectedPointIndex = index;
                  final point = firstSeries.data[index];
                  widget.onPointTap?.call(0, point);
                }
              }
            });
          },
        ),
      ),
      swapAnimationDuration: widget.animationDuration,
      swapAnimationCurve: Curves.easeInOut,
    );
  }
  
  Widget _buildScatterChart(bool isDark) {
    return ScatterChart(
      ScatterChartData(
        scatterSpots: widget.series.expand((series) {
          final seriesIndex = widget.series.indexOf(series);
          return series.data.map((point) {
            return ScatterSpot(
              point.x.toDouble(),
              point.y.toDouble(),
              color: series.color ?? _getSeriesColor(seriesIndex),
              radius: 6,
            );
          });
        }).toList(),
        titlesData: _getFlTitlesData(isDark),
        gridData: FlGridData(
          show: widget.showGrid,
          getDrawingHorizontalLine: (value) {
            return FlLine(
              color: isDark 
                  ? AppDesignSystem.darkBorderColor.withOpacity(0.3)
                  : AppDesignSystem.borderColor.withOpacity(0.3),
              strokeWidth: 1,
            );
          },
          getDrawingVerticalLine: (value) {
            return FlLine(
              color: isDark 
                  ? AppDesignSystem.darkBorderColor.withOpacity(0.3)
                  : AppDesignSystem.borderColor.withOpacity(0.3),
              strokeWidth: 1,
            );
          },
        ),
        borderData: FlBorderData(
          show: true,
          border: Border.all(
            color: isDark ? AppDesignSystem.darkBorderColor : AppDesignSystem.borderColor,
            width: 1,
          ),
        ),
        scatterTouchData: ScatterTouchData(
          enabled: widget.showTooltips,
          touchTooltipData: ScatterTouchTooltipData(
            tooltipBgColor: isDark 
                ? AppDesignSystem.darkBackgroundSecondary 
                : AppDesignSystem.backgroundSecondary,
            getTooltipItems: (spot) {
              return ScatterTooltipItem(
                '(${spot.x.toStringAsFixed(2)}, ${spot.y.toStringAsFixed(2)})',
                textStyle: AppDesignSystem.caption.copyWith(
                  color: isDark ? AppDesignSystem.darkTextPrimary : AppDesignSystem.textPrimary,
                ),
              );
            },
          ),
        ),
      ),
      swapAnimationDuration: widget.animationDuration,
      swapAnimationCurve: Curves.easeInOut,
    );
  }
  
  FlTitlesData _getFlTitlesData(bool isDark) {
    return FlTitlesData(
      show: true,
      bottomTitles: AxisTitles(
        axisNameWidget: widget.xAxisLabel != null 
            ? Text(
                widget.xAxisLabel!,
                style: widget.labelStyle ?? AppDesignSystem.caption.copyWith(
                  color: isDark ? AppDesignSystem.darkTextSecondary : AppDesignSystem.textSecondary,
                ),
              )
            : null,
        sideTitles: SideTitles(
          showTitles: true,
          reservedSize: 30,
          getTitlesWidget: (value, meta) {
            return Padding(
              padding: const EdgeInsets.only(top: 8.0),
              child: Text(
                value.toInt().toString(),
                style: AppDesignSystem.caption.copyWith(
                  color: isDark ? AppDesignSystem.darkTextSecondary : AppDesignSystem.textSecondary,
                ),
              ),
            );
          },
        ),
      ),
      leftTitles: AxisTitles(
        axisNameWidget: widget.yAxisLabel != null 
            ? Text(
                widget.yAxisLabel!,
                style: widget.labelStyle ?? AppDesignSystem.caption.copyWith(
                  color: isDark ? AppDesignSystem.darkTextSecondary : AppDesignSystem.textSecondary,
                ),
              )
            : null,
        sideTitles: SideTitles(
          showTitles: true,
          reservedSize: 40,
          getTitlesWidget: (value, meta) {
            return Text(
              value.toInt().toString(),
              style: AppDesignSystem.caption.copyWith(
                color: isDark ? AppDesignSystem.darkTextSecondary : AppDesignSystem.textSecondary,
              ),
            );
          },
        ),
      ),
      topTitles: AxisTitles(sideTitles: SideTitles(showTitles: false)),
      rightTitles: AxisTitles(sideTitles: SideTitles(showTitles: false)),
    );
  }
  
  List<BarChartGroupData> _generateBarGroups() {
    // Find the maximum number of data points across all series
    final maxPoints = widget.series.map((s) => s.data.length).reduce((a, b) => a > b ? a : b);
    
    return List.generate(maxPoints, (index) {
      return BarChartGroupData(
        x: index,
        barRods: widget.series.map((series) {
          final seriesIndex = widget.series.indexOf(series);
          final value = index < series.data.length ? series.data[index].y : 0;
          
          return BarChartRodData(
            toY: value.toDouble(),
            color: series.color ?? _getSeriesColor(seriesIndex),
            width: 16,
            borderRadius: const BorderRadius.vertical(
              top: Radius.circular(AppDesignSystem.radiusXs),
            ),
          );
        }).toList(),
        showingTooltipIndicators: _selectedPointIndex == index ? [0] : [],
      );
    });
  }
  
  Widget _buildLegend(bool isDark) {
    return Wrap(
      spacing: AppDesignSystem.space4,
      runSpacing: AppDesignSystem.space2,
      children: widget.series.asMap().entries.map((entry) {
        final index = entry.key;
        final series = entry.value;
        
        return Row(
          mainAxisSize: MainAxisSize.min,
          children: [
            Container(
              width: 16,
              height: 16,
              decoration: BoxDecoration(
                color: series.color ?? _getSeriesColor(index),
                borderRadius: BorderRadius.circular(AppDesignSystem.radiusXs),
              ),
            ),
            const SizedBox(width: AppDesignSystem.space2),
            Text(
              series.name,
              style: AppDesignSystem.caption.copyWith(
                color: isDark ? AppDesignSystem.darkTextSecondary : AppDesignSystem.textSecondary,
              ),
            ),
          ],
        );
      }).toList(),
    );
  }
  
  Color _getSeriesColor(int index) {
    final colors = [
      AppDesignSystem.primaryColor,
      AppDesignSystem.secondaryColor,
      AppDesignSystem.successColor,
      AppDesignSystem.warningColor,
      AppDesignSystem.errorColor,
      AppDesignSystem.infoColor,
    ];
    return colors[index % colors.length];
  }
}

/// Chart types
enum ChartType { line, bar, pie, scatter }

/// Chart series data model
class ChartSeries {
  final String name;
  final List<ChartDataPoint> data;
  final Color? color;
  
  ChartSeries({
    required this.name,
    required this.data,
    this.color,
  });
}

/// Chart data point model
class ChartDataPoint {
  final num x;
  final num y;
  final String? label;
  final dynamic data;
  
  ChartDataPoint({
    required this.x,
    required this.y,
    this.label,
    this.data,
  });
}