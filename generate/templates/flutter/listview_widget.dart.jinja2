import 'package:flutter/material.dart';
{%- for import_stmt in widget.imports %}
{{ import_stmt }}
{%- endfor %}

/// Column definition for {{ widget.name }}
class {{ widget.name }}Column {
  final String id;
  final String label;
  final double? width;
  final TextAlign align;
  final bool sortable;
  
  const {{ widget.name }}Column({
    required this.id,
    required this.label,
    this.width,
    this.align = TextAlign.left,
    this.sortable = true,
  });
}

/// {{ widget.description | default("ListView/DataTable widget") }}
class {{ widget.name }} extends StatefulWidget {
  {%- if widget.props %}
  {%- for prop in widget.props %}
  final {{ prop.type }} {{ prop.name }};
  {%- endfor %}
  {%- endif %}
  final List<{{ widget.name }}Column> columns;
  final List<{{ widget.item_type }}> items;
  final void Function({{ widget.item_type }})? onItemTap;
  final void Function({{ widget.item_type }})? onItemLongPress;
  final bool enableSorting;
  final String? defaultSortColumn;
  final bool defaultSortAscending;
  final bool showDividers;
  final EdgeInsets? padding;

  const {{ widget.name }}({
    Key? key,
    {%- if widget.props %}
    {%- for prop in widget.props %}
    required this.{{ prop.name }},
    {%- endfor %}
    {%- endif %}
    required this.columns,
    required this.items,
    this.onItemTap,
    this.onItemLongPress,
    this.enableSorting = true,
    this.defaultSortColumn,
    this.defaultSortAscending = true,
    this.showDividers = true,
    this.padding,
  }) : super(key: key);

  @override
  State<{{ widget.name }}> createState() => _{{ widget.name }}State();
}

class _{{ widget.name }}State extends State<{{ widget.name }}> {
  late String? _sortColumn;
  late bool _sortAscending;
  List<{{ widget.item_type }}> _sortedItems = [];

  @override
  void initState() {
    super.initState();
    _sortColumn = widget.defaultSortColumn;
    _sortAscending = widget.defaultSortAscending;
    _sortItems();
  }

  @override
  void didUpdateWidget({{ widget.name }} oldWidget) {
    super.didUpdateWidget(oldWidget);
    if (oldWidget.items != widget.items) {
      _sortItems();
    }
  }

  void _sortItems() {
    _sortedItems = List.from(widget.items);
    
    if (_sortColumn != null && widget.enableSorting) {
      _sortedItems.sort((a, b) {
        final aValue = _getFieldValue(a, _sortColumn!);
        final bValue = _getFieldValue(b, _sortColumn!);
        
        int result;
        if (aValue == null && bValue == null) {
          result = 0;
        } else if (aValue == null) {
          result = 1;
        } else if (bValue == null) {
          result = -1;
        } else if (aValue is num && bValue is num) {
          result = aValue.compareTo(bValue);
        } else {
          result = aValue.toString().compareTo(bValue.toString());
        }
        
        return _sortAscending ? result : -result;
      });
    }
  }

  dynamic _getFieldValue({{ widget.item_type }} item, String fieldName) {
    {%- if widget.get_field_value %}
    // Custom field value getter
    {{ widget.get_field_value | indent(4) }}
    {%- else %}
    // Default implementation - override this for complex objects
    try {
      // This is a simple implementation - replace with proper reflection or getters
      switch (fieldName) {
        {%- for column in widget.known_columns %}
        case '{{ column.id }}':
          return item.{{ column.getter | default(column.id) }};
        {%- endfor %}
        default:
          return null;
      }
    } catch (e) {
      return null;
    }
    {%- endif %}
  }

  void _handleSort(String columnId) {
    setState(() {
      if (_sortColumn == columnId) {
        _sortAscending = !_sortAscending;
      } else {
        _sortColumn = columnId;
        _sortAscending = true;
      }
      _sortItems();
    });
  }

  @override
  Widget build(BuildContext context) {
    final theme = Theme.of(context);

    {%- if widget.use_data_table %}
    // DataTable implementation
    return SingleChildScrollView(
      scrollDirection: Axis.horizontal,
      child: DataTable(
        sortColumnIndex: _sortColumn != null 
          ? widget.columns.indexWhere((col) => col.id == _sortColumn)
          : null,
        sortAscending: _sortAscending,
        columns: widget.columns.map((column) {
          return DataColumn(
            label: Text(
              column.label,
              style: theme.textTheme.titleSmall?.copyWith(
                fontWeight: FontWeight.bold,
              ),
            ),
            numeric: column.align == TextAlign.right,
            onSort: column.sortable && widget.enableSorting
              ? (columnIndex, ascending) => _handleSort(column.id)
              : null,
          );
        }).toList(),
        rows: _sortedItems.map((item) {
          return DataRow(
            onSelectChanged: widget.onItemTap != null 
              ? (_) => widget.onItemTap!(item)
              : null,
            onLongPress: widget.onItemLongPress != null
              ? () => widget.onItemLongPress!(item)
              : null,
            cells: widget.columns.map((column) {
              final value = _getFieldValue(item, column.id);
              return DataCell(
                Text(
                  value?.toString() ?? '',
                  textAlign: column.align,
                ),
              );
            }).toList(),
          );
        }).toList(),
      ),
    );
    {%- else %}
    // ListView implementation
    return ListView.builder(
      padding: widget.padding,
      itemCount: _sortedItems.length + 1, // +1 for header
      itemBuilder: (context, index) {
        if (index == 0) {
          // Header row
          return Container(
            decoration: BoxDecoration(
              color: theme.colorScheme.surfaceVariant,
              border: Border(
                bottom: BorderSide(
                  color: theme.dividerColor,
                  width: 2,
                ),
              ),
            ),
            child: Row(
              children: widget.columns.map((column) {
                final isCurrentSort = _sortColumn == column.id;
                return Expanded(
                  flex: column.width?.toInt() ?? 1,
                  child: InkWell(
                    onTap: column.sortable && widget.enableSorting
                      ? () => _handleSort(column.id)
                      : null,
                    child: Padding(
                      padding: const EdgeInsets.all(12.0),
                      child: Row(
                        children: [
                          Text(
                            column.label,
                            style: theme.textTheme.titleSmall?.copyWith(
                              fontWeight: FontWeight.bold,
                            ),
                            textAlign: column.align,
                          ),
                          if (column.sortable && widget.enableSorting) ...[
                            const SizedBox(width: 4),
                            if (isCurrentSort)
                              Icon(
                                _sortAscending 
                                  ? Icons.arrow_upward 
                                  : Icons.arrow_downward,
                                size: 16,
                              )
                            else
                              const Icon(
                                Icons.unfold_more,
                                size: 16,
                                color: Colors.grey,
                              ),
                          ],
                        ],
                      ),
                    ),
                  ),
                );
              }).toList(),
            ),
          );
        }

        // Data rows
        final itemIndex = index - 1;
        final item = _sortedItems[itemIndex];
        
        return InkWell(
          onTap: widget.onItemTap != null 
            ? () => widget.onItemTap!(item)
            : null,
          onLongPress: widget.onItemLongPress != null
            ? () => widget.onItemLongPress!(item)
            : null,
          child: Container(
            decoration: widget.showDividers
              ? BoxDecoration(
                  border: Border(
                    bottom: BorderSide(
                      color: theme.dividerColor,
                    ),
                  ),
                )
              : null,
            child: Row(
              children: widget.columns.map((column) {
                final value = _getFieldValue(item, column.id);
                return Expanded(
                  flex: column.width?.toInt() ?? 1,
                  child: Padding(
                    padding: const EdgeInsets.all(12.0),
                    child: Text(
                      value?.toString() ?? '',
                      textAlign: column.align,
                    ),
                  ),
                );
              }).toList(),
            ),
          ),
        );
      },
    );
    {%- endif %}
  }
}