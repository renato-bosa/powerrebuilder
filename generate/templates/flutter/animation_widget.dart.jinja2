/// Animation widget converted from PowerBuilder Animation control
/// Supports animated GIFs, Lottie animations, and simple image sequences
class {{ name }} extends StatefulWidget {
  // Animation source
  final AnimationSource source;
  final String? assetPath;
  final String? networkUrl;
  final List<String>? imageSequence;
  
  // Animation control
  final bool autoPlay;
  final bool repeat;
  final bool reverse;
  final double speed;
  final Duration? duration;
  
  // Callbacks
  final void Function()? onAnimationComplete;
  final void Function(double)? onProgressUpdate;
  final void Function()? onTap;
  
  // Display options
  final BoxFit fit;
  final Alignment alignment;
  final double? width;
  final double? height;
  final EdgeInsets? padding;
  final Color? backgroundColor;
  final BorderRadius? borderRadius;
  
  // Controls
  final bool showControls;
  final bool showProgressBar;
  final Color? controlsColor;

  const {{ name }}({
    Key? key,
    required this.source,
    this.assetPath,
    this.networkUrl,
    this.imageSequence,
    this.autoPlay = true,
    this.repeat = true,
    this.reverse = false,
    this.speed = 1.0,
    this.duration,
    this.onAnimationComplete,
    this.onProgressUpdate,
    this.onTap,
    this.fit = BoxFit.contain,
    this.alignment = Alignment.center,
    this.width,
    this.height,
    this.padding,
    this.backgroundColor,
    this.borderRadius,
    this.showControls = false,
    this.showProgressBar = false,
    this.controlsColor,
  }) : super(key: key);

  @override
  State<{{ name }}> createState() => _{{ name }}State();
}

class _{{ name }}State extends State<{{ name }}> with TickerProviderStateMixin {
  late AnimationController _controller;
  late Animation<double> _animation;
  AnimationController? _lottieController;
  
  bool _isPlaying = false;
  bool _isLoading = true;
  String? _error;
  double _progress = 0.0;
  
  // For image sequence animation
  int _currentImageIndex = 0;
  
  @override
  void initState() {
    super.initState();
    
    _controller = AnimationController(
      duration: widget.duration ?? const Duration(seconds: 1),
      vsync: this,
    );
    
    _animation = Tween<double>(
      begin: 0.0,
      end: 1.0,
    ).animate(CurvedAnimation(
      parent: _controller,
      curve: Curves.linear,
    ));
    
    _controller.addStatusListener(_onAnimationStatusChanged);
    _controller.addListener(_onAnimationUpdate);
    
    if (widget.autoPlay) {
      _play();
    }
    
    {%- if init_code %}
    // Custom initialization
    {{ init_code | indent(4) }}
    {%- endif %}
  }
  
  @override
  void dispose() {
    _controller.removeStatusListener(_onAnimationStatusChanged);
    _controller.removeListener(_onAnimationUpdate);
    _controller.dispose();
    _lottieController?.dispose();
    {%- if dispose_code %}
    // Custom disposal
    {{ dispose_code | indent(4) }}
    {%- endif %}
    super.dispose();
  }
  
  void _onAnimationStatusChanged(AnimationStatus status) {
    if (status == AnimationStatus.completed) {
      widget.onAnimationComplete?.call();
      
      if (widget.repeat) {
        if (widget.reverse) {
          _controller.reverse();
        } else {
          _controller.reset();
          _controller.forward();
        }
      } else {
        setState(() {
          _isPlaying = false;
        });
      }
    } else if (status == AnimationStatus.dismissed && widget.reverse && widget.repeat) {
      _controller.forward();
    }
  }
  
  void _onAnimationUpdate() {
    setState(() {
      _progress = _controller.value;
      if (widget.source == AnimationSource.imageSequence && widget.imageSequence != null) {
        _currentImageIndex = (_progress * (widget.imageSequence!.length - 1)).round();
      }
    });
    widget.onProgressUpdate?.call(_progress);
  }
  
  void _play() {
    setState(() {
      _isPlaying = true;
    });
    
    if (widget.source == AnimationSource.lottie) {
      _lottieController?.forward();
    } else {
      _controller.forward();
    }
  }
  
  void _pause() {
    setState(() {
      _isPlaying = false;
    });
    
    if (widget.source == AnimationSource.lottie) {
      _lottieController?.stop();
    } else {
      _controller.stop();
    }
  }
  
  void _reset() {
    setState(() {
      _isPlaying = false;
      _progress = 0.0;
      _currentImageIndex = 0;
    });
    
    if (widget.source == AnimationSource.lottie) {
      _lottieController?.reset();
    } else {
      _controller.reset();
    }
  }
  
  @override
  Widget build(BuildContext context) {
    final theme = Theme.of(context);
    final isDark = theme.brightness == Brightness.dark;
    
    return Container(
      width: widget.width,
      height: widget.height,
      padding: widget.padding,
      decoration: BoxDecoration(
        color: widget.backgroundColor ?? 
            (isDark ? AppDesignSystem.darkSurfaceColor : AppDesignSystem.surfaceColor),
        borderRadius: widget.borderRadius ?? BorderRadius.circular(AppDesignSystem.radiusMd),
      ),
      child: Column(
        mainAxisSize: MainAxisSize.min,
        children: [
          Expanded(
            child: GestureDetector(
              onTap: widget.onTap,
              child: ClipRRect(
                borderRadius: widget.borderRadius ?? BorderRadius.circular(AppDesignSystem.radiusMd),
                child: Stack(
                  alignment: Alignment.center,
                  children: [
                    _buildAnimation(isDark),
                    if (_isLoading && widget.source != AnimationSource.imageSequence)
                      Center(
                        child: CircularProgressIndicator(
                          valueColor: AlwaysStoppedAnimation<Color>(
                            widget.controlsColor ?? AppDesignSystem.primaryColor,
                          ),
                        ),
                      ),
                    if (_error != null)
                      Center(
                        child: Column(
                          mainAxisSize: MainAxisSize.min,
                          children: [
                            Icon(
                              CupertinoIcons.exclamationmark_triangle,
                              size: 48,
                              color: AppDesignSystem.errorColor,
                            ),
                            const SizedBox(height: AppDesignSystem.space2),
                            Text(
                              'Failed to load animation',
                              style: AppDesignSystem.bodyMedium.copyWith(
                                color: isDark 
                                    ? AppDesignSystem.darkTextSecondary 
                                    : AppDesignSystem.textSecondary,
                              ),
                            ),
                          ],
                        ),
                      ),
                  ],
                ),
              ),
            ),
          ),
          if (widget.showProgressBar) ...[
            const SizedBox(height: AppDesignSystem.space2),
            _buildProgressBar(isDark),
          ],
          if (widget.showControls) ...[
            const SizedBox(height: AppDesignSystem.space3),
            _buildControls(isDark),
          ],
        ],
      ),
    );
  }
  
  Widget _buildAnimation(bool isDark) {
    switch (widget.source) {
      case AnimationSource.gif:
        return _buildGifAnimation();
      case AnimationSource.lottie:
        return _buildLottieAnimation();
      case AnimationSource.imageSequence:
        return _buildImageSequenceAnimation();
    }
  }
  
  Widget _buildGifAnimation() {
    if (widget.assetPath != null) {
      return Image.asset(
        widget.assetPath!,
        fit: widget.fit,
        alignment: widget.alignment,
        frameBuilder: (context, child, frame, wasSynchronouslyLoaded) {
          if (wasSynchronouslyLoaded || frame != null) {
            WidgetsBinding.instance.addPostFrameCallback((_) {
              if (mounted && _isLoading) {
                setState(() {
                  _isLoading = false;
                });
              }
            });
            return child;
          }
          return Container();
        },
        errorBuilder: (context, error, stackTrace) {
          WidgetsBinding.instance.addPostFrameCallback((_) {
            if (mounted) {
              setState(() {
                _isLoading = false;
                _error = error.toString();
              });
            }
          });
          return Container();
        },
      );
    } else if (widget.networkUrl != null) {
      return Image.network(
        widget.networkUrl!,
        fit: widget.fit,
        alignment: widget.alignment,
        loadingBuilder: (context, child, loadingProgress) {
          if (loadingProgress == null) {
            WidgetsBinding.instance.addPostFrameCallback((_) {
              if (mounted && _isLoading) {
                setState(() {
                  _isLoading = false;
                });
              }
            });
            return child;
          }
          return Container();
        },
        errorBuilder: (context, error, stackTrace) {
          WidgetsBinding.instance.addPostFrameCallback((_) {
            if (mounted) {
              setState(() {
                _isLoading = false;
                _error = error.toString();
              });
            }
          });
          return Container();
        },
      );
    }
    return Container();
  }
  
  Widget _buildLottieAnimation() {
    if (widget.assetPath != null) {
      return Lottie.asset(
        widget.assetPath!,
        controller: _lottieController,
        onLoaded: (composition) {
          setState(() {
            _isLoading = false;
          });
          _lottieController = AnimationController(
            duration: composition.duration ~/ widget.speed,
            vsync: this,
          );
          if (widget.autoPlay) {
            _lottieController!.forward();
          }
          if (widget.repeat) {
            _lottieController!.repeat(reverse: widget.reverse);
          }
        },
        fit: widget.fit,
        alignment: widget.alignment,
        animate: false,
      );
    } else if (widget.networkUrl != null) {
      return Lottie.network(
        widget.networkUrl!,
        controller: _lottieController,
        onLoaded: (composition) {
          setState(() {
            _isLoading = false;
          });
          _lottieController = AnimationController(
            duration: composition.duration ~/ widget.speed,
            vsync: this,
          );
          if (widget.autoPlay) {
            _lottieController!.forward();
          }
          if (widget.repeat) {
            _lottieController!.repeat(reverse: widget.reverse);
          }
        },
        fit: widget.fit,
        alignment: widget.alignment,
        animate: false,
        errorBuilder: (context, error, stackTrace) {
          WidgetsBinding.instance.addPostFrameCallback((_) {
            if (mounted) {
              setState(() {
                _isLoading = false;
                _error = error.toString();
              });
            }
          });
          return Container();
        },
      );
    }
    return Container();
  }
  
  Widget _buildImageSequenceAnimation() {
    if (widget.imageSequence == null || widget.imageSequence!.isEmpty) {
      return Container();
    }
    
    setState(() {
      _isLoading = false;
    });
    
    return Image.asset(
      widget.imageSequence![_currentImageIndex],
      fit: widget.fit,
      alignment: widget.alignment,
      errorBuilder: (context, error, stackTrace) {
        return Container(
          color: AppDesignSystem.errorColor.withOpacity(0.1),
          child: Center(
            child: Icon(
              CupertinoIcons.photo,
              color: AppDesignSystem.errorColor,
              size: 48,
            ),
          ),
        );
      },
    );
  }
  
  Widget _buildProgressBar(bool isDark) {
    return Container(
      height: 4,
      child: LinearProgressIndicator(
        value: _progress,
        backgroundColor: isDark 
            ? AppDesignSystem.darkBorderColor 
            : AppDesignSystem.borderColor,
        valueColor: AlwaysStoppedAnimation<Color>(
          widget.controlsColor ?? AppDesignSystem.primaryColor,
        ),
      ),
    );
  }
  
  Widget _buildControls(bool isDark) {
    final controlColor = widget.controlsColor ?? 
        (isDark ? AppDesignSystem.darkTextPrimary : AppDesignSystem.textPrimary);
    
    return Row(
      mainAxisAlignment: MainAxisAlignment.center,
      children: [
        IconButton(
          icon: Icon(
            CupertinoIcons.backward_fill,
            color: controlColor,
          ),
          onPressed: _reset,
        ),
        const SizedBox(width: AppDesignSystem.space2),
        Container(
          decoration: BoxDecoration(
            color: AppDesignSystem.primaryColor.withOpacity(0.1),
            shape: BoxShape.circle,
          ),
          child: IconButton(
            icon: Icon(
              _isPlaying ? CupertinoIcons.pause_fill : CupertinoIcons.play_fill,
              color: AppDesignSystem.primaryColor,
            ),
            onPressed: _isPlaying ? _pause : _play,
          ),
        ),
        const SizedBox(width: AppDesignSystem.space2),
        Text(
          '${(_progress * 100).toInt()}%',
          style: AppDesignSystem.caption.copyWith(
            color: isDark 
                ? AppDesignSystem.darkTextSecondary 
                : AppDesignSystem.textSecondary,
          ),
        ),
      ],
    );
  }
  
