class {{ datawindow.name }}DataWindow(ttk.Frame):
    """DataWindow widget for {{ datawindow.name }}."""
    
    def __init__(self, parent, **kwargs):
        """Initialize the DataWindow.
        
        Args:
            parent: Parent widget
            retrieve_data: Async function to retrieve data
            initial_data: Initial data to display
            on_insert: Async callback for insert operations
            on_update: Async callback for update operations
            on_delete: Async callback for delete operations
            on_row_selected: Callback when row is selected
            allow_multi_select: Allow multiple row selection
            show_toolbar: Show CRUD toolbar
            allow_sort: Allow column sorting
            allow_filter: Allow filtering
            allow_export: Allow data export
            rows_per_page: Number of rows per page (0 = no pagination)
        """
        super().__init__(parent)
        
        # Extract configuration
        self.retrieve_data = kwargs.get('retrieve_data')
        self.initial_data = kwargs.get('initial_data', [])
        self.on_insert = kwargs.get('on_insert')
        self.on_update = kwargs.get('on_update')
        self.on_delete = kwargs.get('on_delete')
        self.on_row_selected = kwargs.get('on_row_selected')
        self.allow_multi_select = kwargs.get('allow_multi_select', False)
        self.show_toolbar = kwargs.get('show_toolbar', True)
        self.allow_sort = kwargs.get('allow_sort', True)
        self.allow_filter = kwargs.get('allow_filter', False)
        self.allow_export = kwargs.get('allow_export', False)
        self.rows_per_page = kwargs.get('rows_per_page', 0)
        
        # Data management
        self._data: List[Dict[str, Any]] = []
        self._filtered_data: List[Dict[str, Any]] = []
        self._current_page = 0
        self._sort_column: Optional[str] = None
        self._sort_reverse = False
        self._filters: Dict[str, str] = {}
        self._selected_rows: List[int] = []
        
        # Column definitions from PowerBuilder
        self._columns = [
            {%- for column in datawindow.columns %}
            {
                'name': '{{ column.name }}',
                'label': '{{ column.label }}',
                'data_type': '{{ column.data_type }}',
                'width': {{ column.width | default(100) }},
                'editable': {{ column.editable | default("False") }},
                {%- if column.format %}
                'format': '{{ column.format }}',
                {%- endif %}
                {%- if column.values %}
                'values': [
                    {%- for value in column.values %}
                    ('{{ value.display }}', '{{ value.data }}'),
                    {%- endfor %}
                ],
                {%- endif %}
                {%- if column.validation %}
                'validation': '{{ column.validation }}',
                {%- endif %}
                {%- if column.is_blob %}
                'is_blob': True,
                'blob_type': '{{ column.blob_metadata.usage }}',
                {%- endif %}
            },
            {%- endfor %}
        ]
        
        {%- if datawindow.has_computed_fields %}
        # Computed field definitions
        self._computed_fields = [
            {%- for field in datawindow.computed_fields %}
            {
                'name': '{{ field.name }}',
                'expression': lambda row: {{ field.expression }},
                'type': '{{ field.inferred_type }}',
                'dependencies': {{ field.dependencies }},
            },
            {%- endfor %}
        ]
        {%- endif %}
        
        {%- if datawindow.has_validation %}
        # Validation rules
        self._validation_rules = {
            {%- for rule in datawindow.validation_rules %}
            '{{ rule.column_name }}': [
                {
                    'type': '{{ rule.rule_type }}',
                    'value': {{ rule.rule_value | tojson }},
                    'message': '{{ rule.error_message }}',
                    'validator': self._validate_{{ rule.column_name }}_{{ rule.rule_type }},
                },
            ],
            {%- endfor %}
        }
        {%- endif %}
        
        # Create widgets
        self._create_widgets()
        
        # Load initial data
        if self.initial_data:
            self.set_data(self.initial_data)
        elif self.retrieve_data:
            self._retrieve_data()
    
    def _create_widgets(self):
        """Create all widgets."""
        # Main container
        self.columnconfigure(0, weight=1)
        self.rowconfigure(1, weight=1)
        
        # Toolbar
        if self.show_toolbar:
            self._create_toolbar()
        
        # Based on presentation style
        {%- if datawindow.presentation_style == "grid" %}
        self._create_grid_view()
        {%- elif datawindow.presentation_style == "freeform" %}
        self._create_freeform_view()
        {%- elif datawindow.presentation_style == "tabular" %}
        self._create_tabular_view()
        {%- elif datawindow.presentation_style == "crosstab" %}
        self._create_crosstab_view()
        {%- else %}
        # Default to grid
        self._create_grid_view()
        {%- endif %}
        
        # Status bar
        self._create_status_bar()
    
    def _create_toolbar(self):
        """Create CRUD toolbar."""
        toolbar = ttk.Frame(self)
        toolbar.grid(row=0, column=0, sticky='ew', padx=5, pady=5)
        
        # CRUD buttons
        if self.on_insert:
            ttk.Button(toolbar, text="New", command=self._handle_insert).pack(side='left', padx=2)
        
        if self.on_update:
            ttk.Button(toolbar, text="Edit", command=self._handle_update).pack(side='left', padx=2)
        
        if self.on_delete:
            ttk.Button(toolbar, text="Delete", command=self._handle_delete).pack(side='left', padx=2)
        
        ttk.Separator(toolbar, orient='vertical').pack(side='left', fill='y', padx=5)
        
        # Refresh button
        ttk.Button(toolbar, text="Refresh", command=self._retrieve_data).pack(side='left', padx=2)
        
        # Search/Filter
        if self.allow_filter:
            ttk.Separator(toolbar, orient='vertical').pack(side='left', fill='y', padx=5)
            ttk.Label(toolbar, text="Search:").pack(side='left', padx=2)
            self._search_var = tk.StringVar()
            self._search_var.trace('w', lambda *args: self._apply_filters())
            ttk.Entry(toolbar, textvariable=self._search_var, width=20).pack(side='left', padx=2)
        
        # Export button
        if self.allow_export:
            ttk.Button(toolbar, text="Export", command=self._handle_export).pack(side='right', padx=2)
    
    def _create_grid_view(self):
        """Create grid/table view."""
        # Frame for treeview and scrollbars
        tree_frame = ttk.Frame(self)
        tree_frame.grid(row=1, column=0, sticky='nsew', padx=5, pady=5)
        tree_frame.columnconfigure(0, weight=1)
        tree_frame.rowconfigure(0, weight=1)
        
        # Create Treeview
        columns = [col['name'] for col in self._columns]
        self.tree = ttk.Treeview(tree_frame, columns=columns, show='headings', 
                                selectmode='extended' if self.allow_multi_select else 'browse')
        
        # Configure columns
        for col in self._columns:
            self.tree.heading(col['name'], text=col['label'],
                            command=lambda c=col['name']: self._sort_by_column(c) if self.allow_sort else None)
            self.tree.column(col['name'], width=col['width'], 
                           anchor='e' if col['data_type'] in ['int', 'double', 'decimal'] else 'w')
        
        # Scrollbars
        vsb = ttk.Scrollbar(tree_frame, orient='vertical', command=self.tree.yview)
        hsb = ttk.Scrollbar(tree_frame, orient='horizontal', command=self.tree.xview)
        self.tree.configure(yscrollcommand=vsb.set, xscrollcommand=hsb.set)
        
        # Grid layout
        self.tree.grid(row=0, column=0, sticky='nsew')
        vsb.grid(row=0, column=1, sticky='ns')
        hsb.grid(row=1, column=0, sticky='ew')
        
        # Bind events
        self.tree.bind('<<TreeviewSelect>>', self._on_selection_changed)
        self.tree.bind('<Double-Button-1>', self._on_double_click)
        
        # Right-click menu
        self._create_context_menu()
    
    def _create_freeform_view(self):
        """Create freeform view with individual controls."""
        # Scrollable frame
        canvas = tk.Canvas(self)
        scrollbar = ttk.Scrollbar(self, orient='vertical', command=canvas.yview)
        self._freeform_frame = ttk.Frame(canvas)
        
        canvas.configure(yscrollcommand=scrollbar.set)
        canvas_frame = canvas.create_window((0, 0), window=self._freeform_frame, anchor='nw')
        
        canvas.grid(row=1, column=0, sticky='nsew')
        scrollbar.grid(row=1, column=1, sticky='ns')
        
        # Create form controls
        self._form_controls = {}
        row = 0
        
        for col in self._columns:
            # Label
            ttk.Label(self._freeform_frame, text=col['label'] + ':').grid(
                row=row, column=0, sticky='e', padx=5, pady=2)
            
            # Control based on type and editability
            if col.get('values'):
                # Dropdown
                control = ttk.Combobox(self._freeform_frame, values=[v[0] for v in col['values']], 
                                     state='readonly' if not col['editable'] else 'normal')
            elif col['data_type'] == 'bool':
                # Checkbox
                var = tk.BooleanVar()
                control = ttk.Checkbutton(self._freeform_frame, variable=var)
                control.var = var
            elif col.get('is_blob'):
                # Blob display/edit
                control = self._create_blob_control(self._freeform_frame, col)
            else:
                # Entry
                control = ttk.Entry(self._freeform_frame, state='normal' if col['editable'] else 'readonly')
            
            control.grid(row=row, column=1, sticky='ew', padx=5, pady=2)
            self._form_controls[col['name']] = control
            
            row += 1
        
        # Navigation buttons
        nav_frame = ttk.Frame(self._freeform_frame)
        nav_frame.grid(row=row, column=0, columnspan=2, pady=10)
        
        ttk.Button(nav_frame, text='<<', command=self._first_record).pack(side='left', padx=2)
        ttk.Button(nav_frame, text='<', command=self._previous_record).pack(side='left', padx=2)
        self._record_label = ttk.Label(nav_frame, text='0/0')
        self._record_label.pack(side='left', padx=10)
        ttk.Button(nav_frame, text='>', command=self._next_record).pack(side='left', padx=2)
        ttk.Button(nav_frame, text='>>', command=self._last_record).pack(side='left', padx=2)
        
        # Configure frame expansion
        self._freeform_frame.columnconfigure(1, weight=1)
        
        # Update canvas scroll region
        self._freeform_frame.update_idletasks()
        canvas.configure(scrollregion=canvas.bbox('all'))
    
    def _create_context_menu(self):
        """Create right-click context menu."""
        self.context_menu = tk.Menu(self, tearoff=0)
        
        if self.on_insert:
            self.context_menu.add_command(label="New", command=self._handle_insert)
        if self.on_update:
            self.context_menu.add_command(label="Edit", command=self._handle_update)
        if self.on_delete:
            self.context_menu.add_command(label="Delete", command=self._handle_delete)
        
        if self.on_insert or self.on_update or self.on_delete:
            self.context_menu.add_separator()
        
        self.context_menu.add_command(label="Copy", command=self._copy_selection)
        if self.allow_export:
            self.context_menu.add_command(label="Export Selection", command=self._export_selection)
        
        # Bind to tree
        if hasattr(self, 'tree'):
            self.tree.bind('<Button-3>', self._show_context_menu)
    
    def _create_status_bar(self):
        """Create status bar."""
        status_frame = ttk.Frame(self)
        status_frame.grid(row=2, column=0, sticky='ew')
        
        # Row count
        self._status_label = ttk.Label(status_frame, text="0 rows")
        self._status_label.pack(side='left', padx=5)
        
        # Pagination controls
        if self.rows_per_page > 0:
            ttk.Separator(status_frame, orient='vertical').pack(side='left', fill='y', padx=5)
            
            ttk.Button(status_frame, text='◀', command=self._previous_page).pack(side='left')
            self._page_label = ttk.Label(status_frame, text="Page 1/1")
            self._page_label.pack(side='left', padx=5)
            ttk.Button(status_frame, text='▶', command=self._next_page).pack(side='left')
    
    def _retrieve_data(self):
        """Retrieve data asynchronously."""
        if not self.retrieve_data:
            return
        
        # Run async function
        loop = asyncio.new_event_loop()
        asyncio.set_event_loop(loop)
        
        try:
            data = loop.run_until_complete(self.retrieve_data())
            self.set_data(data)
        except Exception as e:
            messagebox.showerror("Error", f"Failed to retrieve data: {str(e)}")
        finally:
            loop.close()
    
    def set_data(self, data: List[Dict[str, Any]]):
        """Set the data to display."""
        self._data = data
        self._filtered_data = data.copy()
        
        {%- if datawindow.has_computed_fields %}
        # Calculate computed fields
        self._calculate_computed_fields()
        {%- endif %}
        
        self._apply_filters()
        self._refresh_display()
    
    {%- if datawindow.has_computed_fields %}
    def _calculate_computed_fields(self):
        """Calculate all computed fields for the data."""
        for row in self._data:
            for field in self._computed_fields:
                try:
                    row[field['name']] = field['expression'](row)
                except Exception as e:
                    row[field['name']] = None
                    print(f"Error calculating {field['name']}: {e}")
    {%- endif %}
    
    def _apply_filters(self):
        """Apply search and column filters."""
        self._filtered_data = self._data.copy()
        
        # Apply search filter
        if hasattr(self, '_search_var') and self._search_var.get():
            search_text = self._search_var.get().lower()
            self._filtered_data = [
                row for row in self._filtered_data
                if any(str(row.get(col['name'], '')).lower().find(search_text) >= 0 
                      for col in self._columns)
            ]
        
        # Apply column filters
        for col_name, filter_text in self._filters.items():
            if filter_text:
                self._filtered_data = [
                    row for row in self._filtered_data
                    if str(row.get(col_name, '')).lower().find(filter_text.lower()) >= 0
                ]
        
        # Apply sorting
        if self._sort_column:
            self._filtered_data.sort(
                key=lambda row: row.get(self._sort_column, ''),
                reverse=self._sort_reverse
            )
        
        self._refresh_display()
    
    def _refresh_display(self):
        """Refresh the display with current filtered data."""
        if hasattr(self, 'tree'):
            self._refresh_tree()
        elif hasattr(self, '_form_controls'):
            self._refresh_form()
        
        # Update status
        total_rows = len(self._filtered_data)
        filtered_rows = len(self._data) - total_rows if len(self._data) != total_rows else 0
        
        status_text = f"{total_rows} rows"
        if filtered_rows > 0:
            status_text += f" ({filtered_rows} filtered)"
        
        self._status_label.config(text=status_text)
        
        # Update pagination
        if self.rows_per_page > 0:
            total_pages = max(1, (total_rows + self.rows_per_page - 1) // self.rows_per_page)
            self._current_page = min(self._current_page, total_pages - 1)
            self._page_label.config(text=f"Page {self._current_page + 1}/{total_pages}")
    
    def _refresh_tree(self):
        """Refresh treeview display."""
        # Clear existing items
        for item in self.tree.get_children():
            self.tree.delete(item)
        
        # Determine data range
        if self.rows_per_page > 0:
            start_idx = self._current_page * self.rows_per_page
            end_idx = start_idx + self.rows_per_page
            display_data = self._filtered_data[start_idx:end_idx]
        else:
            display_data = self._filtered_data
        
        # Add rows
        for idx, row in enumerate(display_data):
            values = []
            for col in self._columns:
                value = row.get(col['name'], '')
                
                # Format value
                if col.get('format'):
                    value = self._format_value(value, col['format'], col['data_type'])
                elif col.get('is_blob'):
                    value = f"<{col.get('blob_type', 'blob')}>"
                
                values.append(value)
            
            self.tree.insert('', 'end', values=values, tags=(idx,))
        
        # Restore selection
        self._restore_selection()
    
    def _format_value(self, value, format_string: str, data_type: str):
        """Format a value according to format string."""
        if value is None or value == '':
            return ''
        
        try:
            if data_type in ['date', 'datetime'] and isinstance(value, (date, datetime)):
                return value.strftime(format_string.replace('mm', '%m').replace('dd', '%d').replace('yyyy', '%Y'))
            elif data_type == 'decimal' and isinstance(value, (Decimal, float)):
                # Handle decimal format like "#,##0.00"
                return f"{value:,.2f}"
            elif data_type in ['int', 'double'] and format_string:
                return format_string.format(value)
            else:
                return str(value)
        except:
            return str(value)
    
    def _sort_by_column(self, column: str):
        """Sort by the specified column."""
        if self._sort_column == column:
            self._sort_reverse = not self._sort_reverse
        else:
            self._sort_column = column
            self._sort_reverse = False
        
        self._apply_filters()
    
    def _on_selection_changed(self, event):
        """Handle selection change."""
        selection = self.tree.selection()
        self._selected_rows = [int(self.tree.item(item)['tags'][0]) for item in selection]
        
        if self.on_row_selected and self._selected_rows:
            # Get actual data index
            if self.rows_per_page > 0:
                data_idx = self._current_page * self.rows_per_page + self._selected_rows[0]
            else:
                data_idx = self._selected_rows[0]
            
            if data_idx < len(self._filtered_data):
                self.on_row_selected(self._filtered_data[data_idx])
    
    def _on_double_click(self, event):
        """Handle double-click on row."""
        if self.on_update and self._selected_rows:
            self._handle_update()
    
    def _show_context_menu(self, event):
        """Show context menu."""
        # Select row under cursor
        item = self.tree.identify_row(event.y)
        if item:
            self.tree.selection_set(item)
        
        self.context_menu.post(event.x_root, event.y_root)
    
    def _handle_insert(self):
        """Handle insert operation."""
        if not self.on_insert:
            return
        
        # Create edit dialog
        dialog = DataEditDialog(self, self._columns, title="New Record")
        self.wait_window(dialog)
        
        if dialog.result:
            # Validate
            {%- if datawindow.has_validation %}
            errors = self._validate_row(dialog.result)
            if errors:
                messagebox.showerror("Validation Error", "\n".join(errors))
                return
            {%- endif %}
            
            # Run async insert
            loop = asyncio.new_event_loop()
            asyncio.set_event_loop(loop)
            
            try:
                loop.run_until_complete(self.on_insert(dialog.result))
                self._retrieve_data()  # Refresh
            except Exception as e:
                messagebox.showerror("Error", f"Failed to insert: {str(e)}")
            finally:
                loop.close()
    
    def _handle_update(self):
        """Handle update operation."""
        if not self.on_update or not self._selected_rows:
            return
        
        # Get selected row data
        if self.rows_per_page > 0:
            data_idx = self._current_page * self.rows_per_page + self._selected_rows[0]
        else:
            data_idx = self._selected_rows[0]
        
        if data_idx >= len(self._filtered_data):
            return
        
        row_data = self._filtered_data[data_idx].copy()
        
        # Create edit dialog
        dialog = DataEditDialog(self, self._columns, row_data, title="Edit Record")
        self.wait_window(dialog)
        
        if dialog.result:
            # Validate
            {%- if datawindow.has_validation %}
            errors = self._validate_row(dialog.result)
            if errors:
                messagebox.showerror("Validation Error", "\n".join(errors))
                return
            {%- endif %}
            
            # Run async update
            loop = asyncio.new_event_loop()
            asyncio.set_event_loop(loop)
            
            try:
                loop.run_until_complete(self.on_update(dialog.result))
                self._retrieve_data()  # Refresh
            except Exception as e:
                messagebox.showerror("Error", f"Failed to update: {str(e)}")
            finally:
                loop.close()
    
    def _handle_delete(self):
        """Handle delete operation."""
        if not self.on_delete or not self._selected_rows:
            return
        
        # Confirm
        count = len(self._selected_rows)
        if messagebox.askyesno("Confirm Delete", 
                              f"Delete {count} selected record{'s' if count > 1 else ''}?"):
            # Get selected row data
            rows_to_delete = []
            for row_idx in self._selected_rows:
                if self.rows_per_page > 0:
                    data_idx = self._current_page * self.rows_per_page + row_idx
                else:
                    data_idx = row_idx
                
                if data_idx < len(self._filtered_data):
                    rows_to_delete.append(self._filtered_data[data_idx])
            
            # Run async delete
            loop = asyncio.new_event_loop()
            asyncio.set_event_loop(loop)
            
            try:
                for row in rows_to_delete:
                    loop.run_until_complete(self.on_delete(row))
                self._retrieve_data()  # Refresh
            except Exception as e:
                messagebox.showerror("Error", f"Failed to delete: {str(e)}")
            finally:
                loop.close()
    
    {%- if datawindow.has_validation %}
    def _validate_row(self, row_data: Dict[str, Any]) -> List[str]:
        """Validate row data against rules."""
        errors = []
        
        for column_name, rules in self._validation_rules.items():
            value = row_data.get(column_name)
            for rule in rules:
                error = rule['validator'](value)
                if error:
                    errors.append(error)
        
        return errors
    
    {%- for rule in datawindow.validation_rules %}
    {{ rule.python_validator | indent(4) }}
    
    {%- endfor %}
    {%- endif %}
    
    def _handle_export(self):
        """Export data to CSV."""
        filename = filedialog.asksaveasfilename(
            defaultextension='.csv',
            filetypes=[('CSV files', '*.csv'), ('All files', '*.*')]
        )
        
        if filename:
            try:
                import csv
                with open(filename, 'w', newline='', encoding='utf-8') as f:
                    writer = csv.DictWriter(f, fieldnames=[col['name'] for col in self._columns])
                    writer.writeheader()
                    writer.writerows(self._filtered_data)
                
                messagebox.showinfo("Export", f"Data exported to {filename}")
            except Exception as e:
                messagebox.showerror("Error", f"Failed to export: {str(e)}")
    
    def _copy_selection(self):
        """Copy selected rows to clipboard."""
        if not self._selected_rows:
            return
        
        # Get selected data
        selected_data = []
        for row_idx in self._selected_rows:
            if self.rows_per_page > 0:
                data_idx = self._current_page * self.rows_per_page + row_idx
            else:
                data_idx = row_idx
            
            if data_idx < len(self._filtered_data):
                selected_data.append(self._filtered_data[data_idx])
        
        # Format as tab-separated
        lines = []
        # Header
        lines.append('\t'.join(col['label'] for col in self._columns))
        # Data
        for row in selected_data:
            values = [str(row.get(col['name'], '')) for col in self._columns]
            lines.append('\t'.join(values))
        
        # Copy to clipboard
        self.clipboard_clear()
        self.clipboard_append('\n'.join(lines))
    
    def _export_selection(self):
        """Export selected rows."""
        if not self._selected_rows:
            return
        
        # Temporarily filter to selected rows
        original_filtered = self._filtered_data
        selected_data = []
        
        for row_idx in self._selected_rows:
            if self.rows_per_page > 0:
                data_idx = self._current_page * self.rows_per_page + row_idx
            else:
                data_idx = row_idx
            
            if data_idx < len(self._filtered_data):
                selected_data.append(self._filtered_data[data_idx])
        
        self._filtered_data = selected_data
        self._handle_export()
        self._filtered_data = original_filtered
    
    # Pagination methods
    def _previous_page(self):
        """Go to previous page."""
        if self._current_page > 0:
            self._current_page -= 1
            self._refresh_display()
    
    def _next_page(self):
        """Go to next page."""
        total_pages = max(1, (len(self._filtered_data) + self.rows_per_page - 1) // self.rows_per_page)
        if self._current_page < total_pages - 1:
            self._current_page += 1
            self._refresh_display()
    
    # Freeform navigation methods
    def _first_record(self):
        """Navigate to first record."""
        if self._filtered_data:
            self._current_record = 0
            self._display_record()
    
    def _previous_record(self):
        """Navigate to previous record."""
        if hasattr(self, '_current_record') and self._current_record > 0:
            self._current_record -= 1
            self._display_record()
    
    def _next_record(self):
        """Navigate to next record."""
        if hasattr(self, '_current_record') and self._current_record < len(self._filtered_data) - 1:
            self._current_record += 1
            self._display_record()
    
    def _last_record(self):
        """Navigate to last record."""
        if self._filtered_data:
            self._current_record = len(self._filtered_data) - 1
            self._display_record()
    
    def _display_record(self):
        """Display current record in freeform view."""
        if not hasattr(self, '_current_record') or not self._filtered_data:
            return
        
        record = self._filtered_data[self._current_record]
        
        for col in self._columns:
            control = self._form_controls.get(col['name'])
            if control:
                value = record.get(col['name'], '')
                
                if col.get('values'):
                    # Combobox - find display value
                    for display, data in col['values']:
                        if data == value:
                            control.set(display)
                            break
                elif col['data_type'] == 'bool':
                    # Checkbox
                    control.var.set(bool(value))
                elif hasattr(control, 'delete'):
                    # Entry
                    control.delete(0, tk.END)
                    control.insert(0, str(value) if value is not None else '')
        
        # Update navigation label
        self._record_label.config(text=f"{self._current_record + 1}/{len(self._filtered_data)}")
    
    def _restore_selection(self):
        """Restore previous selection after refresh."""
        # This is a simplified version - you might want to track by ID instead
        for row_idx in self._selected_rows:
            if row_idx < len(self.tree.get_children()):
                items = self.tree.get_children()
                self.tree.selection_add(items[row_idx])
    
    {%- if datawindow.has_blob_columns %}
    def _create_blob_control(self, parent, column):
        """Create a control for blob display/edit."""
        frame = ttk.Frame(parent)
        
        if column.get('blob_type') == 'image':
            # Image display
            label = ttk.Label(frame, text="<No image>")
            label.pack()
            
            # Buttons
            btn_frame = ttk.Frame(frame)
            btn_frame.pack()
            ttk.Button(btn_frame, text="Load", command=lambda: self._load_blob(column['name'])).pack(side='left')
            ttk.Button(btn_frame, text="Clear", command=lambda: self._clear_blob(column['name'])).pack(side='left')
            
            frame.image_label = label
        else:
            # Generic blob
            label = ttk.Label(frame, text="<No data>")
            label.pack()
            
            # Buttons
            btn_frame = ttk.Frame(frame)
            btn_frame.pack()
            ttk.Button(btn_frame, text="Load", command=lambda: self._load_blob(column['name'])).pack(side='left')
            ttk.Button(btn_frame, text="Save", command=lambda: self._save_blob(column['name'])).pack(side='left')
            ttk.Button(btn_frame, text="Clear", command=lambda: self._clear_blob(column['name'])).pack(side='left')
        
        return frame
    
    def _load_blob(self, column_name):
        """Load blob data from file."""
        filename = filedialog.askopenfilename()
        if filename:
            with open(filename, 'rb') as f:
                data = f.read()
                # Store in current record
                if hasattr(self, '_current_record'):
                    self._filtered_data[self._current_record][column_name] = base64.b64encode(data).decode()
                    self._display_record()
    
    def _save_blob(self, column_name):
        """Save blob data to file."""
        if hasattr(self, '_current_record'):
            data = self._filtered_data[self._current_record].get(column_name)
            if data:
                filename = filedialog.asksaveasfilename()
                if filename:
                    with open(filename, 'wb') as f:
                        f.write(base64.b64decode(data))
    
    def _clear_blob(self, column_name):
        """Clear blob data."""
        if hasattr(self, '_current_record'):
            self._filtered_data[self._current_record][column_name] = None
            self._display_record()
    {%- endif %}


class DataEditDialog(tk.Toplevel):
    """Dialog for editing data row."""
    
    def __init__(self, parent, columns, data=None, title="Edit"):
        """Initialize edit dialog."""
        super().__init__(parent)
        self.title(title)
        self.transient(parent)
        
        self.columns = columns
        self.data = data or {}
        self.result = None
        self.controls = {}
        
        self._create_widgets()
        
        # Center on parent
        self.update_idletasks()
        x = (self.winfo_screenwidth() // 2) - (self.winfo_width() // 2)
        y = (self.winfo_screenheight() // 2) - (self.winfo_height() // 2)
        self.geometry(f"+{x}+{y}")
        
        # Focus
        self.grab_set()
        if self.controls:
            list(self.controls.values())[0].focus_set()
    
    def _create_widgets(self):
        """Create dialog widgets."""
        # Main frame
        main_frame = ttk.Frame(self, padding="10")
        main_frame.grid(row=0, column=0, sticky='nsew')
        
        # Create controls for each column
        row = 0
        for col in self.columns:
            if not col['editable']:
                continue
            
            # Label
            ttk.Label(main_frame, text=col['label'] + ':').grid(
                row=row, column=0, sticky='e', padx=5, pady=5)
            
            # Control
            if col.get('values'):
                # Dropdown
                control = ttk.Combobox(main_frame, values=[v[0] for v in col['values']], width=30)
                # Set initial value
                if col['name'] in self.data:
                    for display, data in col['values']:
                        if data == self.data[col['name']]:
                            control.set(display)
                            break
            elif col['data_type'] == 'bool':
                # Checkbox
                var = tk.BooleanVar(value=self.data.get(col['name'], False))
                control = ttk.Checkbutton(main_frame, variable=var)
                control.var = var
            elif col['data_type'] in ['multilineedit', 'text']:
                # Text widget
                control = tk.Text(main_frame, width=40, height=4)
                if col['name'] in self.data:
                    control.insert('1.0', str(self.data[col['name']]))
            else:
                # Entry
                control = ttk.Entry(main_frame, width=30)
                if col['name'] in self.data:
                    control.insert(0, str(self.data[col['name']]))
            
            control.grid(row=row, column=1, sticky='ew', padx=5, pady=5)
            self.controls[col['name']] = control
            
            row += 1
        
        # Buttons
        btn_frame = ttk.Frame(main_frame)
        btn_frame.grid(row=row, column=0, columnspan=2, pady=10)
        
        ttk.Button(btn_frame, text="OK", command=self._ok).pack(side='left', padx=5)
        ttk.Button(btn_frame, text="Cancel", command=self._cancel).pack(side='left', padx=5)
        
        # Bind Enter key
        self.bind('<Return>', lambda e: self._ok())
        self.bind('<Escape>', lambda e: self._cancel())
    
    def _ok(self):
        """Save and close."""
        self.result = self.data.copy() if self.data else {}
        
        # Get values from controls
        for col in self.columns:
            if not col['editable'] or col['name'] not in self.controls:
                continue
            
            control = self.controls[col['name']]
            
            if col.get('values'):
                # Dropdown - get data value
                display_val = control.get()
                for display, data in col['values']:
                    if display == display_val:
                        self.result[col['name']] = data
                        break
            elif col['data_type'] == 'bool':
                # Checkbox
                self.result[col['name']] = control.var.get()
            elif isinstance(control, tk.Text):
                # Text widget
                self.result[col['name']] = control.get('1.0', 'end-1c')
            else:
                # Entry
                value = control.get()
                # Convert to appropriate type
                if col['data_type'] == 'int' and value:
                    try:
                        self.result[col['name']] = int(value)
                    except:
                        self.result[col['name']] = value
                elif col['data_type'] in ['double', 'decimal'] and value:
                    try:
                        self.result[col['name']] = float(value)
                    except:
                        self.result[col['name']] = value
                else:
                    self.result[col['name']] = value
        
        self.destroy()
    
    def _cancel(self):
        """Cancel and close."""
        self.destroy()


