        {%- endif %}
    {%- endfor %}
    
    {%- if not app.events or 'open' not in (app.events | map(attribute='name') | list) %}
    def _application_open(self):
        """Handle application open event."""
        logger.info("Application opened: %s", self.display_name)
        
        {%- if app.has_database %}
        # Initialize database
        self._init_database()
        {%- endif %}
    {%- endif %}
    
    {%- if not app.events or 'close' not in (app.events | map(attribute='name') | list) %}
    def _application_close(self):
        """Handle application close event."""
        logger.info("Application closing: %s", self.display_name)
        
        {%- if app.has_database %}
        # Close database connections
        if self.current_session:
            self.current_session.close()
        if self.engine:
            self.engine.dispose()
        {%- endif %}
        
        # Destroy main window
        if self.root:
            self.root.destroy()
    {%- endif %}
    
    {%- if app.has_database %}
    
    def _init_database(self):
        """Initialize database connection."""
        try:
            # Build connection string
            {%- if app.database_config.dbms %}
            dbms = "{{ app.database_config.dbms }}".lower()
            
            if 'sqlite' in dbms:
                connection_string = f"sqlite:///{{ app.database_config.database | default('app.db') }}"
            elif 'postgresql' in dbms or 'postgres' in dbms:
                connection_string = (
                    f"postgresql://{{ app.database_config.userid | default('user') }}:"
                    f"{{ app.database_config.db_pass | default('password') }}@"
                    f"{{ app.database_config.server_name | default('localhost') }}/"
                    f"{{ app.database_config.database | default('database') }}"
                )
            elif 'mysql' in dbms:
                connection_string = (
                    f"mysql+pymysql://{{ app.database_config.userid | default('user') }}:"
                    f"{{ app.database_config.db_pass | default('password') }}@"
                    f"{{ app.database_config.server_name | default('localhost') }}/"
                    f"{{ app.database_config.database | default('database') }}"
                )
            elif 'mssql' in dbms or 'sqlserver' in dbms:
                connection_string = (
                    f"mssql+pyodbc://{{ app.database_config.userid | default('user') }}:"
                    f"{{ app.database_config.db_pass | default('password') }}@"
                    f"{{ app.database_config.server_name | default('localhost') }}/"
                    f"{{ app.database_config.database | default('database') }}"
                    f"?driver=ODBC+Driver+17+for+SQL+Server"
                )
            else:
                raise ValueError(f"Unsupported DBMS: {{ app.database_config.dbms }}")
            {%- else %}
            # Default to SQLite
            connection_string = "sqlite:///app.db"
            {%- endif %}
            
            # Create engine
            self.engine = create_engine(connection_string, echo=False)
            
            # Create tables if needed
            Base.metadata.create_all(self.engine)
            
            # Create session factory
            self.session_factory = sessionmaker(bind=self.engine)
            
            logger.info("Database initialized successfully")
            
        except Exception as e:
            logger.error(f"Failed to initialize database: {e}")
            messagebox.showerror(
                "Database Error", 
                f"Failed to connect to database:\n{str(e)}"
            )
    
    def get_session(self) -> Session:
        """Get a database session."""
        if not self.session_factory:
            raise RuntimeError("Database not initialized")
        
        if not self.current_session:
            self.current_session = self.session_factory()
        
        return self.current_session
    {%- endif %}
    
