class {{ app.name }}Application:
    """Main application class for {{ app.display_name }}."""
    
    def __init__(self):
        """Initialize the application."""
        self.root: Optional[tk.Tk] = None
        self.main_window = None
        {%- if app.has_database %}
        self.engine = None
        self.session_factory = None
        self.current_session: Optional[Session] = None
        {%- endif %}
        
        {%- if app.has_variables %}
        # Instance variables
        {%- for var in app.variables %}
        {%- if not var.is_global %}
        self.{{ var.name }}: {{ var.python_type }} = {{ var.initial_value | default('None') }}
        {%- endif %}
        {%- endfor %}
        {%- endif %}
        
        # Application settings
        self.app_name = "{{ app.app_name }}"
        self.display_name = "{{ app.display_name }}"
        {%- if app.icon %}
        self.icon_path = "{{ app.icon }}"
        {%- endif %}
    
    def run(self):
        """Run the application."""
        try:
            # Initialize application
            self._application_open()
            
            # Create main window
            self.root = tk.Tk()
            self.root.title(self.display_name)
            
            {%- if app.icon %}
            # Set application icon
            try:
                if os.path.exists(self.icon_path):
                    self.root.iconbitmap(self.icon_path)
            except Exception as e:
                logger.warning(f"Failed to set application icon: {e}")
            {%- endif %}
            
            # Set window close handler
            self.root.protocol("WM_DELETE_WINDOW", self._application_close)
            
            # Configure window
            self._configure_main_window()
            
            {%- if app.initial_window %}
            # Open initial window
            self.main_window = {{ app.initial_window | pascal_case }}()
            {%- else %}
            # No initial window specified - show default
            self._create_default_window()
            {%- endif %}
            
            # Start main loop
            self.root.mainloop()
            
        except Exception as e:
            logger.error(f"Application error: {e}")
            messagebox.showerror("Application Error", str(e))
            sys.exit(1)
    
    def _configure_main_window(self):
        """Configure the main application window."""
        # Center window on screen
        self.root.update_idletasks()
        width = self.root.winfo_width()
        height = self.root.winfo_height()
        x = (self.root.winfo_screenwidth() // 2) - (width // 2)
        y = (self.root.winfo_screenheight() // 2) - (height // 2)
        self.root.geometry(f'+{x}+{y}')
        
        {%- if app.micro_help %}
        # Create status bar for micro help
        self.status_bar = ttk.Label(
            self.root, 
            text="Ready", 
            relief=tk.SUNKEN
        )
        self.status_bar.pack(side=tk.BOTTOM, fill=tk.X)
        {%- endif %}
    
    {%- if not app.initial_window %}
    def _create_default_window(self):
        """Create default window when no initial window is specified."""
        frame = ttk.Frame(self.root, padding="20")
        frame.pack(fill=tk.BOTH, expand=True)
        
        ttk.Label(
            frame,
            text=f"Welcome to {self.display_name}",
            font=('TkDefaultFont', 16, 'bold')
        ).pack(pady=10)
        
        ttk.Label(
            frame,
            text="No initial window was specified in the application object."
        ).pack(pady=5)
        
        ttk.Button(
            frame,
            text="Exit",
            command=self._application_close
        ).pack(pady=10)
    {%- endif %}
    
