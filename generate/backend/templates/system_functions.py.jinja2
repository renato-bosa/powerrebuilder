def call_system_function(name: str, *args: Any) -> Any:
    """Call a PowerBuilder system function by name.
    
    Args:
        name: The name of the function to call (case-insensitive)
        args: Arguments to pass to the function
        
    Returns:
        The result of the function call
        
    Raises:
        ValueError: If the function doesn't exist
        TypeError: If the wrong number or types of arguments are provided
    """
    func = SYSTEM_FUNCTIONS.get(name.lower())
    if func is None:
        raise ValueError(f"Unknown system function: {name}")
    
    try:
        return func(*args)
    except TypeError as e:
        raise TypeError(f"Error calling {name}: {str(e)}") 