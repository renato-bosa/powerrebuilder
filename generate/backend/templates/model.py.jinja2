"""{{ model.name }} model generated from PowerBuilder."""
from datetime import date, datetime
from decimal import Decimal
from typing import List, Optional

from sqlmodel import Field, Relationship, SQLModel

class {{ model.name }}(SQLModel, table=True):
    """{{ model.description or model.name }} model."""
    
    __tablename__ = "{{ model.table_name|lower }}"
    
    {%- for column in model.columns %}
    {{ column.name }}: {{ column.type_hint }} = Field(
        {%- if column.primary_key %}
        primary_key=True,
        {%- endif %}
        {%- if column.foreign_key %}
        foreign_key="{{ column.foreign_key }}",
        {%- endif %}
        {%- if column.unique %}
        unique=True,
        {%- endif %}
        {%- if column.nullable is defined %}
        nullable={{ column.nullable }},
        {%- endif %}
        {%- if column.default is defined %}
        default={{ column.default }},
        {%- endif %}
        {%- if column.index %}
        index=True,
        {%- endif %}
        {%- if column.description %}
        description="{{ column.description }}"
        {%- endif %}
    )
    {%- endfor %}
    
    {%- if model.relationships %}
    
    # Relationships
    {%- for rel in model.relationships %}
    {{ rel.name }}: {{ rel.type_hint }} = Relationship(
        back_populates="{{ rel.back_populates }}"
        {%- if rel.link_model %},
        link_model={{ rel.link_model }}
        {%- endif %}
    )
    {%- endfor %}
    {%- endif %} 