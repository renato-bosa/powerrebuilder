"""{{ window.name }} - Generated from PowerBuilder Window

{{ window.description or "PowerBuilder window converted to Python Tkinter" }}
"""
import tkinter as tk
from tkinter import ttk, messagebox
from typing import Optional, Dict, Any, Callable
{%- if window.has_menu %}
from tkinter import Menu
{%- endif %}
{%- if window.has_datawindow %}
from .datawindow_widget import DataWindowWidget
{%- endif %}


class {{ window.name }}(tk.Tk):
    """{{ window.title or window.name }} Window."""
    
    def __init__(self):
        """Initialize the window."""
        super().__init__()
        
        # Window properties
        self.title("{{ window.title or window.name }}")
        self.geometry("{{ window.width }}x{{ window.height }}")
        {%- if window.resizable is defined %}
        self.resizable({{ window.resizable }}, {{ window.resizable }})
        {%- endif %}
        
        # Instance variables
        {%- for var in window.variables %}
        self.{{ var.name }}: {{ var.python_type }} = {{ var.initial_value or 'None' }}
        {%- endfor %}
        
        # Control references
        self._controls: Dict[str, tk.Widget] = {}
        
        # Create widgets
        self._create_widgets()
        {%- if window.has_menu %}
        self._create_menu()
        {%- endif %}
        
        # Bind events
        self._bind_events()
        
        # Initialize (equivalent to PowerBuilder open event)
        self._on_open()
    
    def _create_widgets(self):
        """Create and layout all widgets."""
        # Main container
        main_frame = ttk.Frame(self, padding="10")
        main_frame.grid(row=0, column=0, sticky=(tk.W, tk.E, tk.N, tk.S))
        
        {%- for control in window.controls %}
        {%- if control.type == 'statictext' %}
        # Label: {{ control.name }}
        self._controls['{{ control.name }}'] = ttk.Label(
            main_frame,
            text="{{ control.text }}",
            {%- if control.font %}
            font={{ control.font }},
            {%- endif %}
        )
        {%- elif control.type == 'singlelineedit' %}
        # Entry: {{ control.name }}
        self._controls['{{ control.name }}'] = ttk.Entry(
            main_frame,
            {%- if control.width %}
            width={{ control.width }},
            {%- endif %}
            {%- if not control.enabled %}
            state='disabled',
            {%- endif %}
        )
        {%- if control.text %}
        self._controls['{{ control.name }}'].insert(0, "{{ control.text }}")
        {%- endif %}
        {%- elif control.type == 'multilineedit' %}
        # Text: {{ control.name }}
        self._controls['{{ control.name }}'] = tk.Text(
            main_frame,
            {%- if control.width %}
            width={{ control.width }},
            {%- endif %}
            {%- if control.height %}
            height={{ control.height }},
            {%- endif %}
            {%- if not control.enabled %}
            state='disabled',
            {%- endif %}
        )
        {%- if control.text %}
        self._controls['{{ control.name }}'].insert('1.0', "{{ control.text }}")
        {%- endif %}
        {%- elif control.type == 'commandbutton' %}
        # Button: {{ control.name }}
        self._controls['{{ control.name }}'] = ttk.Button(
            main_frame,
            text="{{ control.text }}",
            command=self._on_{{ control.name }}_clicked,
            {%- if not control.enabled %}
            state='disabled',
            {%- endif %}
        )
        {%- elif control.type == 'checkbox' %}
        # Checkbox: {{ control.name }}
        {{ control.name }}_var = tk.BooleanVar(value={{ control.checked or False }})
        self._controls['{{ control.name }}'] = ttk.Checkbutton(
            main_frame,
            text="{{ control.text }}",
            variable={{ control.name }}_var,
            {%- if not control.enabled %}
            state='disabled',
            {%- endif %}
        )
        self._controls['{{ control.name }}'].var = {{ control.name }}_var
        {%- elif control.type == 'radiobutton' %}
        # Radio: {{ control.name }}
        self._controls['{{ control.name }}'] = ttk.Radiobutton(
            main_frame,
            text="{{ control.text }}",
            value="{{ control.value }}",
            {%- if control.group %}
            variable=self._radio_{{ control.group }},
            {%- endif %}
            {%- if not control.enabled %}
            state='disabled',
            {%- endif %}
        )
        {%- elif control.type == 'listbox' %}
        # Listbox: {{ control.name }}
        self._controls['{{ control.name }}'] = tk.Listbox(
            main_frame,
            {%- if control.multiselect %}
            selectmode=tk.MULTIPLE,
            {%- endif %}
            {%- if control.height %}
            height={{ control.height }},
            {%- endif %}
        )
        {%- if control.items %}
        for item in {{ control.items }}:
            self._controls['{{ control.name }}'].insert(tk.END, item)
        {%- endif %}
        {%- elif control.type == 'dropdownlistbox' %}
        # Combobox: {{ control.name }}
        {{ control.name }}_var = tk.StringVar()
        self._controls['{{ control.name }}'] = ttk.Combobox(
            main_frame,
            textvariable={{ control.name }}_var,
            {%- if control.items %}
            values={{ control.items }},
            {%- endif %}
            {%- if control.readonly %}
            state='readonly',
            {%- endif %}
        )
        self._controls['{{ control.name }}'].var = {{ control.name }}_var
        {%- elif control.type == 'datawindow' %}
        # DataWindow: {{ control.name }}
        self._controls['{{ control.name }}'] = DataWindowWidget(
            main_frame,
            dataobject="{{ control.dataobject }}",
        )
        {%- elif control.type == 'groupbox' %}
        # LabelFrame: {{ control.name }}
        self._controls['{{ control.name }}'] = ttk.LabelFrame(
            main_frame,
            text="{{ control.text }}",
            padding="10",
        )
        {%- else %}
        # Unsupported control type: {{ control.type }} ({{ control.name }})
        self._controls['{{ control.name }}'] = ttk.Label(
            main_frame,
            text="[{{ control.type }}: {{ control.name }}]",
        )
        {%- endif %}
        
        # Position the control
        {%- if control.use_absolute_position %}
        self._controls['{{ control.name }}'].place(
            x={{ control.x }}, 
            y={{ control.y }},
            {%- if control.width %}
            width={{ control.width }},
            {%- endif %}
            {%- if control.height %}
            height={{ control.height }},
            {%- endif %}
        )
        {%- else %}
        self._controls['{{ control.name }}'].grid(
            row={{ control.grid_row or loop.index0 }},
            column={{ control.grid_column or 0 }},
            {%- if control.columnspan %}
            columnspan={{ control.columnspan }},
            {%- endif %}
            {%- if control.rowspan %}
            rowspan={{ control.rowspan }},
            {%- endif %}
            sticky={{ control.sticky or "(tk.W, tk.E)" }},
            padx=5,
            pady=5,
        )
        {%- endif %}
        
        {%- endfor %}
    
    {%- if window.has_menu %}
    def _create_menu(self):
        """Create the window menu."""
        menubar = Menu(self)
        self.config(menu=menubar)
        
        {%- for menu in window.menus %}
        # {{ menu.text }} menu
        {{ menu.name }}_menu = Menu(menubar, tearoff=0)
        {%- for item in menu.items %}
        {%- if item.separator %}
        {{ menu.name }}_menu.add_separator()
        {%- else %}
        {{ menu.name }}_menu.add_command(
            label="{{ item.text }}",
            command=self._on_{{ item.name }}_clicked,
            {%- if item.accelerator %}
            accelerator="{{ item.accelerator }}",
            {%- endif %}
        )
        {%- endif %}
        {%- endfor %}
        menubar.add_cascade(label="{{ menu.text }}", menu={{ menu.name }}_menu)
        {%- endfor %}
    {%- endif %}
    
    def _bind_events(self):
        """Bind window and control events."""
        # Window events
        self.protocol("WM_DELETE_WINDOW", self._on_close)
        {%- if window.has_resize_event %}
        self.bind("<Configure>", self._on_resize)
        {%- endif %}
        
        # Control events
        {%- for event in window.control_events %}
        {%- if event.control and event.event_type %}
        # {{ event.control }}.{{ event.event_name }}
        {%- if event.event_type == 'modified' %}
        self._controls['{{ event.control }}'].bind('<KeyRelease>', self._on_{{ event.control }}_{{ event.event_name }})
        {%- elif event.event_type == 'getfocus' %}
        self._controls['{{ event.control }}'].bind('<FocusIn>', self._on_{{ event.control }}_{{ event.event_name }})
        {%- elif event.event_type == 'losefocus' %}
        self._controls['{{ event.control }}'].bind('<FocusOut>', self._on_{{ event.control }}_{{ event.event_name }})
        {%- elif event.event_type == 'selectionchanged' %}
        self._controls['{{ event.control }}'].bind('<<ListboxSelect>>', self._on_{{ event.control }}_{{ event.event_name }})
        {%- endif %}
        {%- endif %}
        {%- endfor %}
    
    # Event handlers
    def _on_open(self):
        """Window open event (constructor)."""
        {%- if window.open_event %}
        {{ window.open_event | indent(8) }}
        {%- else %}
        pass
        {%- endif %}
    
    def _on_close(self):
        """Window close event."""
        {%- if window.close_event %}
        {{ window.close_event | indent(8) }}
        {%- else %}
        self.destroy()
        {%- endif %}
    
    {%- for control in window.controls %}
    {%- if control.type == 'commandbutton' or (control.type == 'menu' and control.clicked_event) %}
    
    def _on_{{ control.name }}_clicked(self):
        """{{ control.name }} clicked event."""
        {%- if control.clicked_event %}
        {{ control.clicked_event | indent(8) }}
        {%- else %}
        pass
        {%- endif %}
    {%- endif %}
    {%- endfor %}
    
    {%- for method in window.methods %}
    
    def {{ method.name }}(self{{ ', ' + method.params if method.params else '' }}):
        """{{ method.description or method.name }}."""
        {%- if method.body %}
        {{ method.body | indent(8) }}
        {%- else %}
        raise NotImplementedError("{{ method.name }} not implemented")
        {%- endif %}
    {%- endfor %}
    
    # Control access methods
    def get_control(self, name: str) -> Optional[tk.Widget]:
        """Get a control by name."""
        return self._controls.get(name)
    
    def set_text(self, control_name: str, text: str):
        """Set text for a control."""
        control = self._controls.get(control_name)
        if isinstance(control, ttk.Label):
            control.config(text=text)
        elif isinstance(control, ttk.Entry):
            control.delete(0, tk.END)
            control.insert(0, text)
        elif isinstance(control, tk.Text):
            control.delete('1.0', tk.END)
            control.insert('1.0', text)
    
    def get_text(self, control_name: str) -> str:
        """Get text from a control."""
        control = self._controls.get(control_name)
        if isinstance(control, ttk.Label):
            return control.cget('text')
        elif isinstance(control, ttk.Entry):
            return control.get()
        elif isinstance(control, tk.Text):
            return control.get('1.0', tk.END).strip()
        elif hasattr(control, 'var'):
            return str(control.var.get())
        return ""


def main():
    """Run the window."""
    app = {{ window.name }}()
    app.mainloop()


if __name__ == "__main__":
    main()