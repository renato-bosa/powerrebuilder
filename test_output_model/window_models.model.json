{
  "models": [
    {
      "type": "Window",
      "name": "MainWindow",
      "properties": {
        "width": 1920,
        "height": 1200,
        "title": "Sample Application"
      },
      "controls": [
        {
          "type": "Button", 
          "name": "okButton",
          "text": "OK",
          "position": {"x": 320, "y": 600},
          "size": {"width": 375, "height": 100}
        },
        {
          "type": "TextInput",
          "name": "nameInput", 
          "placeholder": "Enter your name",
          "position": {"x": 320, "y": 400},
          "size": {"width": 800, "height": 100}
        }
      ],
      "events": [
        {
          "control": "okButton",
          "event": "onClick",
          "handler": "handleOkClick"
        }
      ]
    }
  ]
}